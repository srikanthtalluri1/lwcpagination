    @isTest
    static void testNormalizeRowsWithAllFields() {
        TPM_Assessment_Period__c p = period('Q1 2026', 'Active');
        insert p;
        String filtersJson = JSON.serialize(new Map<String, Object>{ 'assessmentPeriodId' => String.valueOf(p.Id) });

        Test.startTest();
        Map<String, Object> result = TpmArchitectureHubAssessmentService.getAssessmentData(filtersJson);
        Test.stopTest();

        List<Map<String, Object>> records = (List<Map<String, Object>>) result.get('records');
        System.assertNotEquals(null, records);
        Map<String, String> fields = (Map<String, String>) result.get('fields');
        for (Map<String, Object> rec : records) {
