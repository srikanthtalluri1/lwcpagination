 @AuraEnabled
    public static Boolean completeFirstEdit(Id decisionId) {

        if (decisionId == null) {
            return false;
        }

        TechnologyDecision__c decision = [
            SELECT Id,
                   TechnologyDecision_First_Edit_Completed__c,
                   Executive_Council_Awareness__c
            FROM TechnologyDecision__c
            WHERE Id = :decisionId
            LIMIT 1
            FOR UPDATE
        ];

        // Already completed first edit
        if (decision.TechnologyDecision_First_Edit_Completed__c == true) {
            return false;
        }

        // Determine whether warning is needed
        Boolean showWarning =
            decision.Executive_Council_Awareness__c == 'No';

        // Mark first edit completed
        decision.TechnologyDecision_First_Edit_Completed__c = true;

        update decision;

        return showWarning;
    }
