
:host {
    display: block;

    --ink: #0a1220;
    --navy: #0d1b33;
    --navy-deep: #07101f;
    --gold: #c6a15b;
    --gold-lt: #eddcb3;
    --text: #111826;
    --muted: #66707e;
    --muted-soft: #99a3b0;
    --line: #e4e7ee;
    --bg: #e9edf4;
    --card: #ffffff;

    --g1: #2554a6;
    --g1b: #5c8fd6;
    --g2: #6b4e8e;
    --g2b: #a184c4;
    --g3: #1f7a67;
    --g3b: #57ab97;
    --g4: #b1502b;
    --g4b: #dd875f;
    --g5: #1b6ea8;
    --g5b: #5aa3d6;
    --g6: #7a7a2b;
    --g6b: #b3b35f;
    --g7: #8e3b6b;
    --g7b: #c47ba3;
    --g8: #3b6b8e;
    --g8b: #7bafc4;

    --ret: #98a2b0;
    --new: #8a6414;
    --con: #9a4a12;
    --under: #3355a8;
    --ryg-red: #c0392b;
    --ryg-yellow: #c99a10;
    --ryg-green: #1a7a4c;
    --ryg-blue: #3355a8;

    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
    color: var(--text);
    font-size: 14px;
}

.placemat-root {
    display: flex;
    align-items: stretch;
    min-height: 600px;
    background:
        radial-gradient(circle at 1px 1px, rgba(15, 23, 42, 0.05) 1px, transparent 0) 0 0/22px 22px,
        linear-gradient(180deg, #eef1f7 0%, #e3e8f1 100%);
    position: relative;
}

.placemat-root.nav-collapsed c-placemat-nav {
    display: none;
}

.nav-toggle {
    position: absolute;
    top: 12px;
    left: 0;
    transform: translateX(-50%);
    z-index: 30;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--navy);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(10, 18, 32, 0.18);
}

.placemat-root:not(.nav-collapsed) .nav-toggle {
    left: 296px;
}

.placemat-root.nav-collapsed .nav-toggle {
    left: 14px;
    transform: none;
}

.placemat-root.nav-collapsed .nav-toggle svg {
    transform: rotate(180deg);
}

.nav-toggle svg {
    width: 13px;
    height: 13px;
}

.app-main {
    flex: 1 1 auto;
    min-width: 0;
}

/* ══ HERO ══ */
.hero {
    color: #fff;
    background:
        repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.025) 0 2px, transparent 2px 46px),
        radial-gradient(1100px 420px at 12% -20%, rgba(120, 160, 255, 0.16), transparent 60%),
        linear-gradient(160deg, var(--navy-deep) 0%, var(--navy) 62%, #12274a 100%);
    box-shadow: 0 10px 34px rgba(5, 10, 25, 0.35);
    border-bottom: 1px solid rgba(198, 161, 91, 0.35);
}

/*
 * The original used position:sticky;top:0 here. Inside Experience Cloud the
 * component sits in a column with its own overflow context, so sticky either
 * does nothing or clips. Left static deliberately — see README before enabling.
 */

.hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 26px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    gap: 16px;
    flex-wrap: wrap;
}

.hero-brand {
    display: flex;
    align-items: center;
    gap: 13px;
}

.usaa-badge {
    background: linear-gradient(145deg, #ffffff, #dfe6f2);
    color: var(--navy-deep);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.8px;
    padding: 5px 11px;
    border-radius: 4px;
}

.crumb {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.45);
    display: flex;
    align-items: center;
    gap: 7px;
}

.crumb .hi {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
}

.crumb-link {
    cursor: pointer;
}

.crumb-link:hover {
    color: #fff;
    text-decoration: underline;
}

.toggle {
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9px;
    padding: 3px;
    display: flex;
    gap: 2px;
}

.toggle button {
    padding: 7px 18px;
    border: none;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
    background: transparent;
    color: rgba(255, 255, 255, 0.72);
}

.toggle button.active {
    background: linear-gradient(145deg, var(--gold), #b08c45);
    color: var(--navy-deep);
}

.hero-body {
    padding: 20px 26px 18px;
}

.hero-title {
    font-size: 26px;
    font-weight: 750;
    letter-spacing: -0.3px;
    margin: 0 0 6px;
}

.hero-desc {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 78ch;
    line-height: 1.55;
    margin: 0;
}

.kpi-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    padding: 0 26px 18px;
}

.kpi-value {
    font-size: 21px;
    font-weight: 800;
    color: var(--gold-lt);
    line-height: 1.1;
}

.kpi-label {
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.4px;
    margin-top: 2px;
}

/* ══ LEVEL 1 ══ */
.l1-main {
    padding: 22px 26px 8px;
}

.owners-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    padding: 14px 18px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 11px;
    margin-bottom: 20px;
}

.owner-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.6px;
    color: var(--muted-soft);
}

.owner-value {
    font-size: 12.5px;
    color: var(--text);
    margin-top: 2px;
}

.domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 15px;
}

.domain-card {
    text-align: left;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--g1);
    border-radius: 11px;
    padding: 16px 17px;
    cursor: pointer;
    font: inherit;
    box-shadow: 0 2px 8px rgba(12, 20, 40, 0.06);
    transition: box-shadow 0.18s ease, transform 0.18s ease;
}

.domain-card:hover {
    box-shadow: 0 6px 18px rgba(12, 20, 40, 0.13);
    transform: translateY(-1px);
}

.domain-card:focus-visible {
    outline: 2px solid var(--g1);
    outline-offset: 2px;
}

.domain-card.is-wip {
    border-left-color: var(--ret);
    opacity: 0.8;
}

.domain-name {
    font-size: 15px;
    font-weight: 750;
    color: var(--ink);
    margin-bottom: 5px;
}

.domain-desc {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.5;
}

.domain-wip {
    display: inline-block;
    margin-top: 9px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.6px;
    padding: 2px 7px;
    border-radius: 3px;
    background: #eef1f7;
    color: var(--muted);
}

/* ══ LEGEND ══ */
.legend-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    padding: 11px 26px;
    background: rgba(255, 255, 255, 0.72);
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--muted);
}

.legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.swatch {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    display: inline-block;
}

.sw-red {
    background: var(--ryg-red);
}
.sw-yellow {
    background: var(--ryg-yellow);
}
.sw-green {
    background: var(--ryg-green);
}
.sw-blue {
    background: var(--ryg-blue);
}
.sw-new {
    background: var(--new);
}
.sw-ret {
    background: var(--ret);
}
.sw-con {
    background: var(--con);
}
.sw-under {
    background: var(--under);
}

/* ══ SECTIONS ══ */
.sections {
    padding: 20px 26px 10px;
}

.group-focus-back {
    background: none;
    border: none;
    font: inherit;
    font-size: 12.5px;
    font-weight: 650;
    color: var(--under);
    cursor: pointer;
    padding: 0 0 12px;
}

.group-focus-back:hover {
    text-decoration: underline;
}

.empty-state,
.wip-card {
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 11px;
    padding: 26px;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
}

.wip-main {
    padding: 26px;
}

.wip-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 7px;
}

.wip-text {
    max-width: 62ch;
    margin: 0 auto;
    line-height: 1.55;
}

/* ══ FOOTER ══ */
.placemat-footer {
    padding: 16px 26px 26px;
    font-size: 11.5px;
    color: var(--muted-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.footer-sep {
    opacity: 0.5;
}

/* ══ RESPONSIVE ══ */
@media (max-width: 760px) {
    .placemat-root {
        flex-direction: column;
    }

    .placemat-root:not(.nav-collapsed) .nav-toggle {
        left: auto;
        right: 12px;
        transform: none;
    }

    .hero-body,
    .hero-top,
    .kpi-strip,
    .sections,
    .l1-main,
    .legend-bar {
        padding-left: 14px;
        padding-right: 14px;
    }

    .hero-title {
        font-size: 21px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .domain-card {
        transition: none;
    }
}
