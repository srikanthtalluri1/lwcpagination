				],
				legend: [
					{ label: 'Critical', value: prior.barr.Critical, indicatorStyle: 'background-color:var(--slds-g-color-error-base-40)' },
					{ label: 'High', value: prior.barr.High, indicatorStyle: 'background-color:var(--slds-g-color-warning-base-40)' },
					{ label: 'Medium', value: prior.barr.Medium, indicatorStyle: 'background-color:var(--slds-g-color-brand-base-30)' },
					{ label: 'Low', value: prior.barr.Low, indicatorStyle: 'background-color:var(--slds-g-color-neutral-base-50)' }
				]
			},
			{
				title: 'TIME Recommendation',
				segments: [
					{ label: 'Invest', value: prior.time.Invest, color: 'var(--slds-g-color-success-base-40)' },
