    COUNT(Id) totalRecords,
    COUNT(Operational_Rating__c) resourceCount,
    AVG(Operational_Rating__c) avgResource,
    COUNT(Performance_Scalability_Score__c) complianceCount,
    AVG(Performance_Scalability_Score__c) avgCompliance
FROM TPM_Assessment__c
WHERE Assessment_Period__r.Name = 'Q2 2026'
