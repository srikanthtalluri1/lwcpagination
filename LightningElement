<template>
    <div class="portfolio">
        <template if:true={isLoading}>
            <div class="loading-state">
                <lightning-spinner alternative-text="Loading enterprise capability portfolio" size="medium"></lightning-spinner>
            </div>
        </template>

        <template if:true={loadError}>
            <div class="error-state" role="alert">{loadError}</div>
        </template>

        <template if:true={isReady}>
            <header class="hero">
                <div class="hero-row">
                    <div class="hero-main">
                        <span class="usaa-badge">USAA</span>
                        <div class="hero-eyebrow">{portfolio.eyebrow}</div>
                        <div class="hero-title">{portfolio.title}</div>
                        <div class="hero-gold-rule"></div>
                        <div class="hero-sub">{portfolio.subtitle}</div>
                    </div>

                    <div class="hero-search-wrap">
                        <div class="hero-search-field">
                            <svg class="hero-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="M21 21l-4.3-4.3"></path>
                            </svg>
                            <input
                                class="hero-search"
                                type="search"
                                value={searchTerm}
                                placeholder="Search capabilities, apps &amp; technologies…"
                                autocomplete="off"
                                spellcheck="false"
                                oninput={handleSearchInput}
                                onfocus={handleSearchFocus}
                                onblur={handleSearchBlur}
                            />

                            <template if:true={showSearchResults}>
                                <div class="search-results open" role="listbox">
                                    <template if:true={searchLoading}>
                                        <div class="search-empty">Loading search index…</div>
                                    </template>

                                    <template if:false={searchLoading}>
                                        <template if:true={hasSearchMatches}>
                                            <template if:true={hasCapabilityResults}>
                                                <div class="search-group-label">Capabilities</div>
                                                <template for:each={capabilityResults} for:item="result">
                                                    <a
                                                        key={result.key}
                                                        class="search-result"
                                                        style={result.style}
                                                        href={result.href}
                                                        onmousedown={handleSearchMouseDown}
                                                    >
                                                        <span class="sr-name">{result.name}</span>
                                                        <span class="sr-meta">
                                                            <b>{result.platform}</b>
                                                            <span> › {result.domain}</span>
                                                        </span>
                                                    </a>
                                                </template>
                                            </template>

                                            <template if:true={hasApplicationResults}>
                                                <div class="search-group-label">Applications &amp; Technologies</div>
                                                <template for:each={applicationResults} for:item="result">
                                                    <a
                                                        key={result.key}
                                                        class="search-result"
                                                        style={result.style}
                                                        href={result.href}
                                                        onmousedown={handleSearchMouseDown}
                                                    >
                                                        <span class="sr-name">{result.name}</span>
                                                        <span class="sr-meta">
                                                            <b>{result.platform}</b>
                                                            <span> › {result.technology}{result.vendorDisplay}</span>
                                                        </span>
                                                    </a>
                                                </template>
                                            </template>
                                        </template>

                                        <template if:false={hasSearchMatches}>
                                            <div class="search-empty">{searchEmptyMessage}</div>
                                        </template>
                                    </template>
                                </div>
                            </template>
                        </div>

                        <div class="hero-cost-box">
                            <div class="hero-cost-label">{portfolio.spendLabel}</div>
                            <div class="hero-cost-value">{portfolio.spendValue}</div>
                        </div>
                    </div>
                </div>
            </header>

            <div class={sectionsClass}>
                <div class="toolbar-row">
                    <button type="button" class="expand-all-btn list-view-btn" onclick={toggleListView}>
                        {listViewLabel}
                    </button>

                    <button
                        type="button"
                        class={expandAllButtonClass}
                        aria-pressed={expandAllAria}
                        onclick={toggleExpandAll}
                    >
                        <span>{expandAllLabel}</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                </div>

                <template for:each={layers} for:item="layer" for:index="layerIndex">
                    <section key={layer.key} class="layer" style={layer.style}>
                        <div class="layer-head">
                            <span class="layer-label">{layer.label}</span>
                            <span class="layer-tagline">{layer.tagline}</span>
                        </div>

                        <div class="card-grid">
                            <template for:each={layer.cards} for:item="card" for:index="cardIndex">
                                <div
                                    key={card.key}
                                    class="p-card"
                                    style={card.style}
                                    tabindex="0"
                                    role="link"
                                    data-layer-index={layerIndex}
                                    data-card-index={cardIndex}
                                    data-href={card.href}
                                    onclick={handleCardClick}
                                    onkeydown={handleCardKeydown}
                                >
                                    <div class="p-card-title-row">
                                        <div class="p-card-title">{card.title}</div>
                                        <template if:true={card.hasCost}>
                                            <div class="p-card-cost">{card.cost}</div>
                                        </template>
                                    </div>

                                    <div class="p-card-desc">{card.description}</div>

                                    <template if:true={card.isExpanded}>
                                        <div class="p-card-levels">
                                            <div class="p-card-expand-grid">
                                                <div class="p-card-owners">
                                                    <div class="p-card-levels-label">Ownership</div>

                                                    <template if:true={card.hasOwners}>
                                                        <dl class="p-card-owner-list">
                                                            <template for:each={card.owners} for:item="owner">
                                                                <div key={owner.key}>
                                                                    <dt>{owner.role}</dt>
                                                                    <dd>{owner.name}</dd>
                                                                </div>
                                                            </template>
                                                        </dl>
                                                    </template>

                                                    <template if:false={card.hasOwners}>
                                                        <p class="p-card-owner-empty">{card.ownerMessage}</p>
                                                    </template>
                                                </div>

                                                <div class="p-card-levels-col">
                                                    <div class="p-card-levels-label">Level 2 Capabilities</div>
                                                    <ul>
                                                        <template for:each={card.capabilityItems} for:item="capability">
                                                            <li key={capability.key}>{capability.label}</li>
                                                        </template>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </template>

                                    <div class="p-card-footer">
                                        <a
                                            class="p-card-cta"
                                            href={card.href}
                                            onclick={handlePlatformLinkClick}
                                        >
                                            Open Platform →
                                        </a>

                                        <button
                                            type="button"
                                            class={card.expandButtonClass}
                                            aria-expanded={card.ariaExpanded}
                                            data-layer-index={layerIndex}
                                            data-card-index={cardIndex}
                                            onclick={toggleCard}
                                        >
                                            <span>{card.expandLabel}</span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                                aria-hidden="true">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </section>
                </template>
            </div>
        </template>
    </div>
</template>
