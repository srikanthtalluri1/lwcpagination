@isTest
private class TechnologyDecision_TpmAutoSyncTest {

    private static final String TEST_USER_LAST_NAME = 'TpmSyncTestUser';

    // Existing org permission sets are assigned when present; none are created with Apex DML.
    // Names not present in the org are skipped.
    private static final Set<String> TEST_USER_PERMISSION_SETS = new Set<String>{
        'TPM_Administrator',
        'Technology_Decission'
    };

    @testSetup
    static void setup() {
        Test.startTest();
        User testUser = createTestUser();

        List<UCH_Employee__c> employees = new List<UCH_Employee__c>();
        for (Integer i = 1; i <= 6; i++) {
            employees.add(new UCH_Employee__c(
                Name = 'Sync Employee ' + i,
                Department_Description__c = 'Dept',
                Department_ID__c = '19401',
                Active_Flag__c = 'TRUE',
                Employee_ID__c = 'SYNC' + i,
                Employee_Email_Address__c = 'sync' + i + '@test.com'
            ));
        }
        // Employee record for test-user context (P4444).
        employees.add(new UCH_Employee__c(
            Name = 'Sync Test User',
            Department_Description__c = 'Dept',
            Department_ID__c = '19401',
            Active_Flag__c = 'TRUE',
            Employee_ID__c = 'P4444',
            Employee_Email_Address__c = 'tpmsynctest@usaa.com'
        ));
        insert employees;
        UCH_Employee__c emp = employees[0];

        // TPM_Utility_TestData creates the Portfolio, Domains, Categories, and two Apps.
        // Do not recreate or repeatedly update TPM objects in this test setup.
        TPM_Utility_TestData.createPDCAData();

        // The application lookup filter in these scenarios requires one Business Application.
        // Retain the remaining TPM test records as provided by the utility.
        TPM_App__c filterTypeApp = [
            SELECT Id, Application_Type__c
            FROM TPM_App__c
            WHERE App_Name__c = 'Testing'
            LIMIT 1
        ];
        filterTypeApp.Application_Type__c = 'Business Application';
        update filterTypeApp;

        TPM_App__c filterApp = [SELECT Application_Type__c, InActive__c FROM TPM_App__c WHERE App_Name__c = 'Testing'];
        System.assertEquals('Business Application', filterApp.Application_Type__c, 'App type was changed after insert; Requesting_Application__c lookup filter needs Business Application or Application Services');
        System.assertEquals(false, filterApp.InActive__c, 'App was marked inactive after insert; Requesting_Application__c lookup filter needs InActive__c = false');

        // TPM_Utility_TestData does not create TPM_Platform__c; keep original platform setup.
        System.runAs(testUser) {
            insert new TPM_Platform__c(Name = 'Sync Platform', Active__c = true);
        }
        Test.stopTest();
    }

    // User + PermissionSetAssignment are setup objects, so DML runs inside runAs(current user) to avoid MIXED_DML_OPERATION.
    private static User createTestUser() {
        User thisUser = [SELECT Id FROM User WHERE Id = :UserInfo.getUserId()];
        User testUser;
        System.runAs(thisUser) {
            testUser = new User(
                ProfileId = [SELECT Id FROM Profile WHERE Name = 'Standard User' LIMIT 1].Id,
                LastName = TEST_USER_LAST_NAME,
                Email = 'tpmsynctest@usaa.com',
                Username = 'tpmsynctest' + System.currentTimeMillis() + '@usaa.com.test',
                Alias = 'tpmsync',
                TimeZoneSidKey = 'America/Los_Angeles',
                EmailEncodingKey = 'UTF-8',
                LanguageLocaleKey = 'en_US',
                LocaleSidKey = 'en_US',
                EmployeeNumber = 'P4444',
                IsActive = true
            );
            insert testUser;

            List<PermissionSetAssignment> assignments = new List<PermissionSetAssignment>();
            for (PermissionSet ps : [SELECT Id FROM PermissionSet WHERE Name IN :TEST_USER_PERMISSION_SETS]) {
                assignments.add(new PermissionSetAssignment(AssigneeId = testUser.Id, PermissionSetId = ps.Id));
            }
            insert assignments;
        }
        return testUser;
    }

    private static User tpmUser() {
        return [SELECT Id FROM User WHERE LastName = :TEST_USER_LAST_NAME LIMIT 1];
    }

    private static List<UCH_Employee__c> employees() {
        return [SELECT Id FROM UCH_Employee__c WHERE Employee_ID__c LIKE 'SYNC%' ORDER BY Employee_ID__c];
    }

    // Same order as technologyDecision_CreateFormHelper: relationship, then decision, then back-link.
    // Stage 'Research' + Is_Create_Notification_Send__c = true keeps TechnologyDecision_Approval_Flow from sending emails.
    private static Id createDecision(String reason, String status, Map<String, Id> relationshipLookups) {
        TechnologyDecision_Relationship__c rel = new TechnologyDecision_Relationship__c();
        for (String field : relationshipLookups.keySet()) {
            rel.put(field, relationshipLookups.get(field));
        }
        insert rel;

        TechnologyDecision__c decision = new TechnologyDecision__c(
            Decision_Reason__c = reason,
            Status__c = status,
            Stage__c = 'Research',
            Is_Create_Notification_Send__c = true,
            TechnologyDecision_Relationship__c = rel.Id
        );
        insert decision;

        rel.Decision__c = decision.Id;
        update rel;
        return rel.Id;
    }

    private static TechnologyDecision_Relationship__c loadRelationship(Id relId) {
        return [
            SELECT Requesting_Domain_Architect__c, Requesting_Technical_Architect__c, Requesting_Business_Owner__c,
                   Requesting_Application_Owner__c, Requesting_Tech_Fellow__c, Requesting_Portfolio_Architect__c
            FROM TechnologyDecision_Relationship__c WHERE Id = :relId
        ];
    }

    private static TechnologyDecision__c loadDecision(Id relId) {
        return [
            SELECT Requesting_Technical_Architect__c, Requesting_Business_Owner__c,
                   Requesting_Application_Owner__c, Requesting_Tech_Fellow__c
            FROM TechnologyDecision__c WHERE TechnologyDecision_Relationship__c = :relId
        ];
    }

    // Org automation may pre-populate contact fields on create, so "unchanged" tests compare against this snapshot.
    private static String snapshot(Id relId) {
        return JSON.serialize(loadRelationship(relId)) + JSON.serialize(loadDecision(relId));
    }

    // TechnologyDecisionTrigger (BeforeInsert) throws when a 'New *' decision is inserted, so insert a decision that is
    // known to work (application-based, 'Replace Application') and then re-point it to the domain / desired reason via updates.
    private static Id createDomainDecision(String reason, String status, Id domainId) {
        TPM_App__c app = [SELECT Id FROM TPM_App__c WHERE App_Name__c = 'Testing'];
        Id relId = createDecision('Replace Application', status, new Map<String, Id>{ 'Requesting_Application__c' => app.Id });
        update new TechnologyDecision_Relationship__c(Id = relId, Requesting_Application__c = null, Requesting_Domain__c = domainId);
        if (reason != 'Replace Application') {
            update new TechnologyDecision__c(Id = loadDecision(relId).Id, Decision_Reason__c = reason);
        }
        return relId;
    }

    @isTest
    static void domainContacts_updatesRelationshipAndDecision() {
        System.runAs(tpmUser()) {
        List<UCH_Employee__c> emps = employees();
        TPM_Domain__c domain = [SELECT Id FROM TPM_Domain__c WHERE Domain_Id__c = 444444 LIMIT 1];

        Id relId = createDomainDecision('New Technology', 'Draft', domain.Id);

        TPM_Domain__c changed = new TPM_Domain__c(
            Id = domain.Id,
            Owning_Architect__c = emps[1].Id,
            Business_Owner_Sponsor__c = emps[2].Id,
            Tech_Fellow__c = emps[3].Id
        );

        Test.startTest();
        System.runAs(tpmUser()) {
            TechnologyDecision_TpmAutoSync.updateTPMDecisionContacts(new Map<Id, TPM_Domain__c>{ domain.Id => changed });
        }
        Test.stopTest();

        TechnologyDecision_Relationship__c rel = loadRelationship(relId);
        System.assertEquals(emps[1].Id, rel.Requesting_Domain_Architect__c);
        System.assertEquals(emps[1].Id, rel.Requesting_Technical_Architect__c);
        System.assertEquals(emps[2].Id, rel.Requesting_Business_Owner__c);
        System.assertEquals(emps[3].Id, rel.Requesting_Tech_Fellow__c);

        TechnologyDecision__c decision = loadDecision(relId);
        System.assertEquals(emps[1].Id, decision.Requesting_Technical_Architect__c);
        System.assertEquals(emps[2].Id, decision.Requesting_Business_Owner__c);
        System.assertEquals(emps[3].Id, decision.Requesting_Tech_Fellow__c);
        } // System.runAs(tpmUser())
    }

    @isTest
    static void domainContacts_skipsExcludedStatusAndOtherReasons() {
        System.runAs(tpmUser()) {
        List<UCH_Employee__c> emps = employees();
        TPM_Domain__c domain = [SELECT Id FROM TPM_Domain__c WHERE Domain_Id__c = 444444 LIMIT 1];

        Id withdrawnRel = createDomainDecision('New Technology', 'Withdraw', domain.Id);
        Id otherReasonRel = createDomainDecision('Replace Application', 'Draft', domain.Id);
        Map<Id, String> before = new Map<Id, String>{ withdrawnRel => snapshot(withdrawnRel), otherReasonRel => snapshot(otherReasonRel) };

        TPM_Domain__c changed = new TPM_Domain__c(
            Id = domain.Id,
            Owning_Architect__c = emps[1].Id,
            Business_Owner_Sponsor__c = emps[2].Id,
            Tech_Fellow__c = emps[3].Id
        );

        Test.startTest();
        System.runAs(tpmUser()) {
            TechnologyDecision_TpmAutoSync.updateTPMDecisionContacts(new Map<Id, TPM_Domain__c>{ domain.Id => changed });
        }
        Test.stopTest();

        for (Id relId : before.keySet()) {
            System.assertEquals(before.get(relId), snapshot(relId));
        }
        } // System.runAs(tpmUser())
    }

