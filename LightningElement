    private static List<String> getUserStandardFollowerAssignmentsByEmployeeNumber(String employeeNumber) {
        List<String> standardFollowerAssignments = new List<String>();

        try {
            List<ASP_Architecture_Standard_Follower__c> followers = [
                SELECT Id, Standard__c
                FROM ASP_Architecture_Standard_Follower__c
                WHERE Follower__r.Employee_ID__c = :employeeNumber  WITH SYSTEM_MODE
            ];

            for (ASP_Architecture_Standard_Follower__c follower : followers) {
