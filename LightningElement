    @TestSetup
    static void setupTestUser() {
        User testUser = new User(
            ProfileId = [SELECT Id FROM Profile WHERE Name = 'Standard User' LIMIT 1].Id,
            LastName = 'TestUser',
            Email = 'testuser@usaa.com',
            Username = 'testuser.' + System.currentTimeMillis() + '@usaa.com',
            Alias = 'tuser',
            TimeZoneSidKey = 'America/Los_Angeles',
            EmailEncodingKey = 'UTF-8',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            EmployeeNumber = 'P4444',
            IsActive = true
        );
        insert testUser;

        // Create the reusable TPM records only once for all test methods.
        // runAs separates User setup DML from the non-setup test data DML.
        System.runAs(testUser) {
            // Isolate the heavier TPM utility initialization from the following
            // app update, which fires additional TPM triggers and SOQL queries.
            Test.startTest();
            TPM_Utility_TestData.createPDCAData();
            Test.stopTest();

            AWP_Utility_TestData.createStandard();

            // AWP_Utility/TPM_Utility resolve the employee from the running User.
            // The TPM utility creates employees for its own users, not necessarily
            // the P4444 test user used by every test method in this class.
            if ([SELECT COUNT() FROM UCH_Employee__c WHERE Employee_ID__c = :testUser.EmployeeNumber] == 0) {
                insert new UCH_Employee__c(
                    Name = 'Technology Decision Test Employee',
                    Employee_ID__c = testUser.EmployeeNumber,
                    Employee_Email_Address__c = testUser.Email,
                    Department_Description__c = 'Testing Dep 1',
                    Department_ID__c = 'Test00',
                    Active_Flag__c = 'TRUE'
                );
            }

            // This is the only app used by createRelationship().
            // Set lookup-filter fields once, instead of updating the same apps
            // each time another decision is created.
            TPM_App__c app = [
                SELECT Id, Is_Assessment_Present__c, Application_Type__c
                FROM TPM_App__c
                WHERE UUID__c = 'EB5D4C65-4804-48E0-BD8B-HB0A27FC8E63'
                LIMIT 1
            ];
            app.Is_Assessment_Present__c = true;
            app.Application_Type__c = 'Application Services';
            update app;
        }
    }

