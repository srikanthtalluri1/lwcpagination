    @IsTest
    static void testBuildHistoryRecords_DecisionRow() {
        User testUser = [SELECT Id FROM User WHERE LastName = 'TestUser' AND EmployeeNumber = 'P4444' LIMIT 1];
        System.runAs(testUser) {
        Test.startTest();
        TechnologyDecision__History dh = new TechnologyDecision__History(
            Field = String.valueOf(TechnologyDecision__c.Status__c)
        );

        List<TechnologyDecision_HistoryHandler.WrapperClass> wrappers =
            TechnologyDecision_HistoryHandler.buildHistoryRecords(
                new List<TechnologyDecision__History>{ dh },
                new List<TechnologyDecision_Relationship__History>()
            );
        Test.stopTest();

        System.assertEquals(1, wrappers.size());
        System.assertEquals('Technology Decision', wrappers[0].source);
        System.assertEquals(TechnologyDecision__c.Status__c.getDescribe().getLabel(),
            wrappers[0].fieldName, 'API name should resolve to field label.');
        }
    }

