/**
 * Gradient badge fallback, ported from the original vstyle().
 * The original also carried ~1,170 lines of base64 PNG logos. Those belong in
 * a Static Resource, not in a component bundle — see README. Until that resource
 * exists, every tile renders as a gradient badge, which is the same fallback
 * the original used for unknown vendors.
 */
const VENDOR_STYLE = {
    USAA: { label: 'UA', from: '#0d1b33', to: '#2554a6', text: '#fff' },
    'TWILIO INC': { label: 'TW', from: '#c0392b', to: '#e8674f', text: '#fff' },
    Snowflake: { label: 'SF', from: '#1b6ea8', to: '#5aa3d6', text: '#fff' },
    Confluent: { label: 'CF', from: '#2554a6', to: '#5c8fd6', text: '#fff' },
    Apache: { label: 'AP', from: '#b1502b', to: '#dd875f', text: '#fff' },
    AWS: { label: 'AW', from: '#b8860b', to: '#d9b354', text: '#fff' },
    FEDEX: { label: 'FX', from: '#6b4e8e', to: '#a184c4', text: '#fff' },
    'RR DONNELLEY': { label: 'RR', from: '#1f7a67', to: '#57ab97', text: '#fff' }
};

function vstyle(vendor) {
    return (
        VENDOR_STYLE[vendor] || {
            label: (vendor || '?').slice(0, 2).toUpperCase(),
            from: '#7c8896',
            to: '#525c68',
            text: '#fff'
        }
    );
}

/* ════════════════════ SHAPING LOGIC ════════════════════ */

/** Ported verbatim from the original unionTech(). */
function unionTech(cur, tgt) {
    const names = [];
    cur.forEach((t) => {
        if (names.indexOf(t.n) === -1) names.push(t.n);
    });
    tgt.forEach((t) => {
        if (names.indexOf(t.n) === -1) names.push(t.n);
    });

    return names.map((n) => {
        const c = cur.find((x) => x.n === n);
        const t = tgt.find((x) => x.n === n);
        const vendor = (t || c).v;
        const rationale = (t && t.c && t.rationale) || (c && c.c && c.rationale) || '';
        const underTgt = !!(t && t.u);
        return {
            n,
            v: vendor,
            inCur: !!c,
            inTgt: !!t,
            conCur: !!(c && c.c),
            conTgt: !!(t && t.c),
            isNew: !c && !!t,
            isRetiring: !!c && !t,
            rationale,
            underTgt,
            considerationNote: (underTgt && t.note) || ''
        };
    });
}

/** Ported verbatim from the original rygClass(). */
function rygClass(item) {
    if (item.isRetiring) return 'ryg-red';
    if (item.inTgt && item.underTgt) return 'ryg-blue';
    if (item.inTgt && item.conTgt) return 'ryg-yellow';
    if (item.inTgt) return 'ryg-green';
    return '';
}

const RYG_LABEL = {
    'ryg-red': 'Not in Target',
    'ryg-yellow': 'Constrained',
    'ryg-blue': 'Under Consideration',
    'ryg-green': 'Target'
};
const RYG_LETTER = { 'ryg-red': 'R', 'ryg-yellow': 'Y', 'ryg-blue': 'U', 'ryg-green': 'G' };

/** Ported verbatim from the original leafChanged(). */
function leafChanged(cap) {
    const cn = cap.cur
        .map((t) => t.n)
        .sort()
        .join('|');
    const tn = cap.tgt
        .map((t) => t.n)
        .sort()
        .join('|');
    if (cn !== tn) return true;
    for (let i = 0; i < cap.tgt.length; i++) {
        const t = cap.tgt[i];
        const m = cap.cur.find((c) => c.n === t.n);
        if (m && !!t.c !== !!m.c) return true;
    }
    return false;
}

function countGroupChanges(grp) {
    let n = 0;
    const walk = (items) =>
        items.forEach((i) => {
            if (i.subGroup) walk(i.caps);
            else if (leafChanged(i)) n++;
        });
    walk(grp.caps);
    return n;
}

/**
 * Builds one tile with every class, caption and title string precomputed.
 * This is the single most important conversion step: the original built these
 * as concatenated strings inside tileHTML(), which a template cannot do.
 */
function shapeTile(item, capNum, index) {
    const isGap = item.n === 'None';
    const ryg = isGap ? '' : rygClass(item);

    let cls = 'tech-tile';
    if (isGap) cls += ' gap-tile';
    if (item.isNew) cls += ' is-new';
    if (item.isRetiring) cls += ' is-retiring';
    if (item.conCur) cls += ' con-current';
    if (item.conTgt) cls += ' con-target';
    if (item.underTgt) cls += ' under-target';
    if (ryg) cls += ' ' + ryg;

    const captions = [];
    if (!isGap) {
        if (item.isNew) captions.push({ id: 'new', cls: 'tile-caption cap-new', text: 'New' });
        if (item.isRetiring)
            captions.push({ id: 'ret', cls: 'tile-caption cap-retiring', text: 'Retiring' });
        if (item.conCur)
            captions.push({ id: 'cc', cls: 'tile-caption cap-con-cur', text: 'Constrained' });
        if (item.conTgt)
            captions.push({ id: 'ct', cls: 'tile-caption cap-con-tgt', text: 'Constrained' });
        if (item.underTgt)
            captions.push({ id: 'u', cls: 'tile-caption cap-under', text: 'Under Consideration' });
        if (ryg)
            captions.push({
                id: 'ryg',
                cls: 'tile-caption ryg-label ryg-label-' + ryg.replace('ryg-', ''),
                text: RYG_LABEL[ryg]
            });
    }

    const tooltipParts = [];
    if (item.rationale) tooltipParts.push('Constrained: ' + item.rationale);
    if (item.considerationNote) tooltipParts.push('Under Consideration: ' + item.considerationNote);
    const tooltipText = tooltipParts.join(' \u2014 ');

    const badge = vstyle(item.v);

    return {
        id: capNum + '::' + index,
        name: item.n,
        vendor: item.v,
        isGap,
        cssClass: cls,
        captions,
        hasCaptions: captions.length > 0,
        rygLetter: ryg ? RYG_LETTER[ryg] : '',
        rygLetterClass: ryg ? 'ryg-letter ryg-letter-' + ryg.replace('ryg-', '') : '',
        hasRyg: !!ryg,
        title: isGap
            ? 'Gap \u2014 no current technology addresses this capability'
            : item.n + (item.v ? ' \u00b7 ' + item.v : '') + (tooltipText ? ' \u2014 ' + tooltipText : ''),
        badgeLabel: badge.label,
        badgeStyle: `background:linear-gradient(145deg,${badge.from},${badge.to});color:${badge.text};`
    };
}

function shapeCapability(cap) {
    const items = unionTech(cap.cur || [], cap.tgt || []);
    const changed = leafChanged(cap);
    const links = cap.standardsLinks
        ? cap.standardsLinks.map((l, i) => ({
              id: cap.num + '-sl-' + i,
              label: l.label || 'View Governing Standard',
              link: l.link
          }))
        : cap.standardsLink
        ? [{ id: cap.num + '-sl-0', label: cap.standardsLabel || 'View Governing Standard', link: cap.standardsLink }]
        : [];

    const recId = cap.techDecisionLink ? techDecisionRecordId(cap.techDecisionLink) : null;
    const summary = recId ? TECH_DECISION_SUMMARIES[recId] : null;

    return {
        id: 'cap-' + cap.num,
        num: cap.num,
        name: cap.name,
        desc: cap.desc,
        hasDesc: !!cap.desc,
        isSubGroup: false,
        dotClass: changed ? 'cap-dot on' : 'cap-dot',
        tiles: items.map((it, i) => shapeTile(it, cap.num, i)),
        standardsLinks: links,
        hasStandards: links.length > 0,
        techDecision: cap.techDecisionLink
            ? {
                  link: cap.techDecisionLink,
                  recId,
                  hasSummary: !!summary,
                  blockClass: summary ? 'td-block has-summary' : 'td-block',
                  title: summary ? summary.title : '',
                  dateLabel: summary && summary.date ? 'Target Date: ' + summary.date : ''
              }
            : null,
        hasTechDecision: !!cap.techDecisionLink
    };
}

function shapeSubGroup(sg) {
    return {
        id: 'cap-' + sg.num,
        num: sg.num,
        name: sg.name,
        desc: sg.desc,
        hasDesc: !!sg.desc,
        isSubGroup: true,
        children: (sg.caps || []).map(shapeCapability),
        gridStyle: `grid-template-columns:repeat(${(sg.caps || []).length},1fr)`
    };
}

export function techDecisionRecordId(link) {
    if (!link) return null;
    const m = link.match(/TPM_Technology_Decision__c\/([A-Za-z0-9]+)\//);
    return m ? m[1] : null;
}

/** Returns fully render-ready group cards for one domain. */
export function buildGroups(domainKey) {
    const groups = GROUPS_BY_DOMAIN[domainKey] || [];
    return groups.map((grp) => {
        const chg = countGroupChanges(grp);
        let leafCnt = 0;
        grp.caps.forEach((c) => {
            leafCnt += c.subGroup ? c.caps.length : 1;
        });
        const cols = grp.caps.map((c) => (c.subGroup ? c.caps.length + 'fr' : '1fr')).join(' ');

        return {
            id: 'grp-' + grp.num,
            num: grp.num,
            name: grp.name,
            accent: grp.accent,
            desc: grp.desc,
            hasDesc: !!grp.desc,
            narrative: grp.narrative,
            hasNarrative: !!grp.narrative,
            countLabel: leafCnt + ' ' + (leafCnt === 1 ? 'capability' : 'capabilities'),
            shiftLabel: chg ? chg + ' shifting' : '',
            hasShift: chg > 0,
            accentStyle: `--gc:var(--${grp.accent});--gcb:var(--${grp.accent}b)`,
            bodyStyle: `grid-template-columns:${cols}`,
            columns: grp.caps.map((c) => (c.subGroup ? shapeSubGroup(c) : shapeCapability(c)))
        };
    });
}

/** Domain KPI strip. */
export function computeDomainStats(domainKey) {
    const groups = GROUPS_BY_DOMAIN[domainKey] || [];
    let leaves = 0;
    let shifting = 0;
    let gaps = 0;
    let decisions = 0;
    const walk = (items) =>
        items.forEach((i) => {
            if (i.subGroup) {
                walk(i.caps);
                return;
            }
            leaves++;
            if (leafChanged(i)) shifting++;
            if ((i.cur || []).some((t) => t.n === 'None')) gaps++;
            if (i.techDecisionLink) decisions++;
        });
    groups.forEach((g) => walk(g.caps));
    return [
        { id: 'k1', label: 'Capability Groups', value: String(groups.length) },
        { id: 'k2', label: 'Capabilities', value: String(leaves) },
        { id: 'k3', label: 'Shifting', value: String(shifting) },
        { id: 'k4', label: 'Gaps', value: String(gaps) },
        { id: 'k5', label: 'Tech Decisions', value: String(decisions) }
    ];
}

/**
 * FLATTENED NAV TREE.
 * LWC will not let a template reference itself, so the recursive nav in the
 * original is flattened into a single list with a `level` and an indent style.
 * A plain for:each then renders the whole tree.
 */
export function buildNavRows(expandedKeys, activeId, activeDomainKey) {
    const rows = [];
    const indent = (level) => `padding-left:${10 + level * 14}px`;

    DOMAINS.forEach((d) => {
        const open = expandedKeys.includes(d.key);
        const isActive = d.key === activeDomainKey;
        rows.push({
            id: d.key,
            navType: 'domain',
            navId: d.key,
            label: d.name,
            level: 0,
            style: indent(0),
            cssClass: 'nav-row nav-l1' + (isActive ? ' is-active' : ''),
            hasChildren: (GROUPS_BY_DOMAIN[d.key] || []).length > 0,
            expanded: open,
            caretClass: open ? 'nav-caret is-open' : 'nav-caret',
            isWip: d.status !== 'live'
        });
        if (!open) return;

        (GROUPS_BY_DOMAIN[d.key] || []).forEach((g) => {
            const gKey = d.key + '::' + g.num;
            const gOpen = expandedKeys.includes(gKey);
            rows.push({
                id: gKey,
                navType: 'group',
                navId: gKey,
                label: g.num + '  ' + g.name,
                level: 1,
                style: indent(1),
                cssClass: 'nav-row nav-l2',
                hasChildren: g.caps.length > 0,
                expanded: gOpen,
                caretClass: gOpen ? 'nav-caret is-open' : 'nav-caret',
                isWip: false
            });
            if (!gOpen) return;

            const pushCap = (c, level) => {
                const cKey = d.key + '::' + c.num;
                rows.push({
                    id: cKey,
                    navType: 'cap',
                    navId: cKey,
                    label: c.num + '  ' + c.name,
                    level,
                    style: indent(level),
                    cssClass: 'nav-row nav-l3' + (cKey === activeId ? ' is-active-leaf' : ''),
                    hasChildren: false,
                    expanded: false,
                    caretClass: 'nav-caret',
                    isWip: false
                });
            };

            g.caps.forEach((c) => {
                if (c.subGroup) {
                    pushCap(c, 2);
                    c.caps.forEach((child) => pushCap(child, 3));
                } else {
                    pushCap(c, 2);
                }
            });
        });
    });

    return rows;
}

export function getTechDecisionSummary(recId) {
    const s = TECH_DECISION_SUMMARIES[recId];
    if (!s) return null;
    return {
        title: s.title || 'Tech Decision Summary',
        supportingDoc: s.supportingDoc,
        hasDoc: !!s.supportingDoc,
        sections: [
            { id: 'what', label: 'What', text: s.what },
            { id: 'why', label: 'Why', text: s.why },
            { id: 'value', label: 'Value', text: s.value },
            { id: 'tech', label: 'Technology Description', text: s.techDescription }
        ].filter((x) => !!x.text),
        meta: (s.meta || []).map((pair, i) => ({ id: 'm' + i, label: pair[0], value: pair[1] }))
    };
}
