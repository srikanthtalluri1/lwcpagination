    private static Boolean userCanViewStandardUnapprovedChanges(
        ASP_Architecture_Standard__c standard,
        String employeeNumber,
        List<String> userPermissionSets,
        List<String> userStandardAuthorAssignments,
        List<String> userStandardAcknowledgerAssignments
    ) {
        // If the user has the owner permission set for the class associated w/ the standard, return true
        if (userPermissionSets.contains(ASP_Utils.ownerPermSetsByClass.get(standard.Class__c.toLowerCase())))
            return true;

        // If the user has the approver permission set for the class associated w/ the standard, return true
        if (userPermissionSets.contains(ASP_Utils.approverPermSetsByClass.get(standard.Class__c.toLowerCase())))
            return true;

        // If the user has the author permission set and is assigned as author, return true
        if (
            userPermissionSets.contains(ASP_Utils.authorPermissionSet) &&
            userStandardAuthorAssignments.contains(standard.Id)
        )
            return true;

        // If the user has the acknowledger permission set, is assigned as an acknowledger, and in a stage where they are an active acknowledger, return true
        if (
            userPermissionSets.contains(ASP_Utils.acknowledgerPermissionSet) &&
            userStandardAcknowledgerAssignments.contains(standard.Id) &&
            (standard.Stage__c == 'Pending Acknowledgement' ||
            standard.Stage__c == 'Pending Approval' ||
            standard.Stage__c == 'Revising from Send Back')
        )
            return true;

        // If the user has the administrator permission set, return true
        if (userPermissionSets.contains(ASP_Utils.adminPermissionSet))
            return true;

        return false;
    }

    @TestVisible
    private static ASP_StatusDTO getStatus(
        ASP_Architecture_Standard__c standard,
        Boolean userCanViewStandardUnapprovedChanges
    ) {
        String overallStatus = '';
        if (standard.Active__c) {
            overallStatus = 'Approved';
        } else {
            overallStatus = standard.Status__c;
        }

        String revisionStatus = '';
        if (userCanViewStandardUnapprovedChanges) {
            if (standard.Active__c && standard.Status__c != 'Approved' && standard.Status__c != 'Retired') {
                if (standard.Stage__c == 'Revising') {
                    revisionStatus = 'Revision in Draft';
                } else if (standard.Stage__c == 'Revising from Send Back') {
                    revisionStatus = 'Revising from Send Back';
                } else {
                    revisionStatus = 'Revision ' + standard.Stage__c;
                }
            } else if (!standard.Active__c && (standard.Status__c == 'Draft' || standard.Status__c == 'Acknowledged')) {
                revisionStatus = standard.Stage__c;
            }
        }

        return new ASP_StatusDTO(overallStatus, revisionStatus);
    }

    public static Boolean userCanCreate(String userId, ASP_Architecture_Standard__c standard) {
        //retrieve assigned permission sets for the employeeNumber parameter
        List<String> assignedPermSetNames = ASP_Utils.getUserPermissionSets(userId);

        String ownerPermSetName = ASP_Utils.ownerPermSetsByClass.get(standard.Class__c.toLowerCase());

        //if the creator is in an owner permission set, allow creation
        if (
            (assignedPermSetNames.size() != 0) &&
            (ownerPermSetName != null && assignedPermSetNames.contains(ownerPermSetName))
        ) {
            return true;
        }

        //if the creator is in the admin permission set, allow creation
        if ((assignedPermSetNames.size() != 0) && (assignedPermSetNames.contains('ASP_ADMIN'))) {
            return true;
        }

        return false;
    }

    public static Boolean userCanUpdate(ASP_Architecture_Standard__c standard, Boolean validateStage) {
        //this parameter is used only if we're in a call validating a standard in draft status (typically the only time an update is allowed)
        //In a trigger context, we don't want to validate the stage, as flow approval processes may be updating status/stage
        if (validateStage) {
            if (
                !(standard.Stage__c == 'New' ||
                standard.Stage__c == 'Revising' ||
                standard.Stage__c == 'Revising from Send Back')
            ) {
                return false;
            }
        }

        String userId = UserInfo.getUserId();
        List<String> userPermissionSets = getUserPermissionSets(userId);
        String employeeNumber = getUserEmployeeNumber(userId);
        String classLower = standard.Class__c.toLowerCase();
        String classOwnerPermSet = ASP_Utils.ownerPermSetsByClass.get(classLower);
        if (standard.Owner__r.Employee_ID__c == employeeNumber && userPermissionSets.contains(classOwnerPermSet)) {
            return true;
        }

        List<String> userStandardAuthorAssignments = getUserStandardAuthorAssignmentsByEmployeeNumber(employeeNumber);
        Boolean isStandardAuthor = userStandardAuthorAssignments.size() > 0
            ? userStandardAuthorAssignments.contains(standard.Id)
            : false;

        if (userPermissionSets.contains('ASP_AUTHOR') && isStandardAuthor) {
            return true;
        }

        //if the updating user is in the admin permission set, allow update
        if ((userPermissionSets.contains('ASP_ADMIN'))) {
            return true;
        }

        return false;
    }
