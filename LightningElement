:host{
  display:block;
  width:100%;
  max-width:none;
  margin:0;
  padding:0;
  overflow:visible;
  --ink:#0a1220;
  --navy:#0d1b33;
  --navy-deep:#07101f;
  --gold:#c6a15b;
  --gold-lt:#eddcb3;
  --text:#111826;
  --muted:#66707e;
  --muted-soft:#99a3b0;
  --line:#e4e7ee;
  --bg:#e9edf4;
  --card:#fff;
  --g1:#2554a6;
  --g1b:#5c8fd6;
  --red:#c0392b;
  --yellow:#c99a10;
  --green:#1a7a4c;
  --blue:#3355a8;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",sans-serif;
  color:var(--text);
}
*{box-sizing:border-box}
button{font:inherit}
.shell{
  width:100%;
  max-width:100%;
  min-height:100vh;
  position:relative;
  overflow-x:hidden;
  background:
    radial-gradient(circle at 1px 1px,rgba(15,23,42,.05) 1px,transparent 0) 0 0/22px 22px,
    linear-gradient(180deg,#eef1f7 0%,#e3e8f1 100%);
}
.side-nav{
  position:fixed;
  top:0;
  left:0;
  width:290px;
  height:100vh;
  overflow-y:auto;
  overflow-x:hidden;
  background:linear-gradient(180deg,var(--navy-deep) 0%,var(--navy) 55%,#12274a 100%);
  color:#fff;
  z-index:500;
  padding:20px 0 40px;
  box-shadow:6px 0 24px rgba(5,10,25,.35);
  transition:transform .3s cubic-bezier(.4,0,.2,1);
}
.side-nav::-webkit-scrollbar{width:7px}
.side-nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:10px}
.brand{
  width:100%;
  display:flex;
  align-items:center;
  gap:10px;
  padding:2px 20px 16px;
  margin-bottom:10px;
  border:0;
  border-bottom:1px solid rgba(255,255,255,.1);
  background:transparent;
  color:inherit;
  cursor:pointer;
  text-align:left;
}
.brand:hover{background:rgba(255,255,255,.07)}
.brand-badge,.mini-usaa{
  background:linear-gradient(145deg,#fff,#dfe6f2);
  color:var(--navy-deep);
  font-weight:900;
  letter-spacing:1.7px;
  border-radius:4px;
  box-shadow:0 2px 6px rgba(0,0,0,.25);
}
.brand-badge{font-size:10px;padding:4px 9px}
.brand-title{font-size:10px;font-weight:800;letter-spacing:1.2px;color:rgba(255,255,255,.55);text-transform:uppercase}
.nav-section{padding:0 10px}
.nav-root{font-size:15px;font-weight:800;color:#fff;padding:8px 10px 7px}
.nav-domain,.nav-group,.nav-cap{
  width:100%;
  border:0;
  background:transparent;
  color:rgba(255,255,255,.72);
  text-align:left;
  cursor:pointer;
  border-radius:7px;
  transition:background .18s ease,color .18s ease;
}
.nav-domain{display:flex;align-items:flex-start;gap:6px;padding:7px 10px;margin:1px 0;font-size:14px;font-weight:700}
.nav-domain:hover,.nav-domain.active{background:rgba(255,255,255,.08);color:#fff}
.nav-domain.active{background:rgba(198,161,91,.20)}
.nav-caret{width:14px;min-width:14px;color:rgba(255,255,255,.4);font-size:13px;line-height:1.4}
.nav-groups{padding-left:13px}
.nav-group{display:flex;align-items:flex-start;gap:6px;padding:7px 10px;margin:1px 0;font-size:13px;font-weight:700;color:rgba(255,255,255,.88)}
.nav-cap{padding:6px 10px 6px 31px;font-size:12px;color:rgba(255,255,255,.60);line-height:1.35}
.nav-group:hover,.nav-cap:hover{background:rgba(255,255,255,.08);color:#fff}
.views-label{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:1.4px;color:rgba(255,255,255,.35);padding:16px 20px 6px;margin-top:8px;border-top:1px solid rgba(255,255,255,.1)}
.rail-toggle{
  position:fixed;
  top:20px;
  left:266px;
  z-index:600;
  width:30px;
  height:30px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.22);
  background:linear-gradient(145deg,var(--navy),var(--navy-deep));
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  line-height:1;
  cursor:pointer;
  box-shadow:0 3px 10px rgba(5,10,25,.4);
  transition:left .3s cubic-bezier(.4,0,.2,1),transform .2s ease;
}
.rail-toggle:hover{transform:scale(1.08)}
.main{
  width:calc(100% - 290px);
  min-width:0;
  margin-left:290px;
  transition:margin-left .3s cubic-bezier(.4,0,.2,1),width .3s cubic-bezier(.4,0,.2,1);
}
.rail-collapsed .side-nav{transform:translateX(-100%)}
.rail-collapsed .main{margin-left:0;width:100%}
.rail-collapsed .rail-toggle{left:14px;transform:rotate(180deg)}

.hero{
  position:relative;
  color:#fff;
  background:
    repeating-linear-gradient(115deg,rgba(255,255,255,.025) 0 2px,transparent 2px 46px),
    radial-gradient(1100px 420px at 12% -20%,rgba(120,160,255,.16),transparent 60%),
    linear-gradient(160deg,var(--navy-deep) 0%,var(--navy) 62%,#12274a 100%);
  box-shadow:0 10px 34px rgba(5,10,25,.45);
  border-bottom:1px solid rgba(198,161,91,.35);
}
.hero-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:9px 34px;
  border-bottom:1px solid rgba(255,255,255,.08);
  gap:16px;
}
.crumbs{display:flex;align-items:center;gap:7px;font-size:11.5px;color:rgba(255,255,255,.4);letter-spacing:.2px}
.mini-usaa{font-size:11px;padding:5px 11px;letter-spacing:1.8px}
.crumb-current{color:rgba(255,255,255,.88);font-weight:600}
.sep{opacity:.45}
.state-toggle{background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.14);border-radius:9px;padding:3px;display:flex;gap:2px;box-shadow:inset 0 1px 3px rgba(0,0,0,.3)}
.state-toggle button{padding:7px 18px;border:none;border-radius:6px;font-size:11.5px;font-weight:700;cursor:pointer;background:transparent;color:rgba(255,255,255,.55);transition:background .25s,color .25s,box-shadow .25s;letter-spacing:.2px;white-space:nowrap}
.state-toggle button.active{background:linear-gradient(145deg,#fff,#eef2f9);color:var(--navy-deep);box-shadow:0 2px 10px rgba(0,0,0,.35)}
.state-toggle button.active::after{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--gold);margin-left:8px;vertical-align:middle;box-shadow:0 0 6px var(--gold)}
.state-toggle button:not(.active):hover{color:#fff}
.hero-main{padding:12px 34px 10px}
.eyebrow{font-size:9px;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:4px;font-weight:700}
.hero h1{font-size:21px;font-weight:800;letter-spacing:-.3px;line-height:1;margin:0;background:linear-gradient(90deg,#fff 0%,#dce8ff 55%,#fff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.gold-rule{width:40px;height:2px;background:linear-gradient(90deg,var(--gold),transparent);margin:8px 0;border-radius:2px}
.hero p{font-size:11px;color:rgba(255,255,255,.46);margin:0 0 8px;max-width:760px;line-height:1.4}
.kpis{display:flex;gap:12px;align-items:stretch;padding:8px 0 0}
.kpi{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.13);border-radius:9px;padding:7px 16px;display:flex;flex-direction:column;min-width:120px;box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}
.kpi span{font-size:18px;font-weight:800;color:#fff;line-height:1}
.kpi small{font-size:9.5px;color:rgba(255,255,255,.46);margin-top:3px;letter-spacing:.2px}

.legend{background:#fff;border-bottom:1px solid var(--line);padding:7px 34px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;box-shadow:0 1px 0 rgba(15,23,42,.03)}
.legend-title{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:1.4px;color:var(--muted-soft)}
.legend-item{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--text);font-weight:500}
.pill{font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;padding:3px 8px;border-radius:20px}
.pill.new{background:#fbead0;color:#7a5a12}.pill.retiring{background:#eef1f5;color:#64748b}.pill.constrained{background:#fdecd2;color:#92400e}.pill.under{background:#dbe4fb;color:#1e3a8a}.pill.red{background:var(--red);color:#fff}.pill.yellow{background:var(--yellow);color:#4a3600}.pill.green{background:var(--green);color:#fff}.pill.blue{background:var(--blue);color:#fff}

.content{max-width:none;margin:0;padding:16px clamp(20px,2.8vw,64px) 6px;display:flex;flex-direction:column;gap:22px}
.group-card{background:var(--card);border-radius:14px;overflow:hidden;border:1px solid var(--line);box-shadow:0 1px 2px rgba(15,23,42,.04),0 12px 28px -10px rgba(15,23,42,.14);transition:box-shadow .25s ease,transform .25s ease}
.group-card:hover{box-shadow:0 1px 2px rgba(15,23,42,.05),0 18px 36px -10px rgba(15,23,42,.20);transform:translateY(-1px)}
.group-ribbon{height:5px;background:linear-gradient(90deg,var(--g1) 0%,var(--g1b) 100%)}
.group-header{display:flex;align-items:flex-start;gap:15px;padding:17px 24px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,#f6f9ff 0%,#fff 70%)}
.group-icon{width:42px;height:42px;border-radius:11px;background:linear-gradient(145deg,var(--g1),var(--g1b));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 3px 8px rgba(37,84,166,.35),inset 0 1px 0 rgba(255,255,255,.3);color:#fff;margin-top:1px}
.group-icon svg{width:22px;height:22px}
.group-tag{font-size:10.5px;text-transform:uppercase;letter-spacing:1.5px;color:var(--g1);font-weight:800;margin-bottom:3px}
.group-title-line{display:flex;align-items:baseline;flex-wrap:wrap}
.group-title-line h2{font-size:18.5px;font-weight:800;color:var(--text);letter-spacing:-.2px;margin:0}
.group-title-line span{font-size:12.5px;color:var(--muted);margin-left:9px;font-weight:500}
.group-title-wrap p{font-size:13px;color:var(--muted);margin:4px 0 0;line-height:1.5;max-width:640px}
.group-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));min-width:0;overflow-x:auto}
.cap-col{padding:17px 19px 19px;display:flex;flex-direction:column;border-right:1px solid var(--line);min-height:0}
.cap-col:last-child{border-right:none}
.cap-header{margin-bottom:13px}
.cap-num{font-size:11px;font-weight:800;color:var(--g1);letter-spacing:.3px}
.cap-header h3{font-size:14px;font-weight:700;color:var(--text);line-height:1.35;margin:2px 0 0}
.cap-header p{font-size:12px;color:var(--muted);line-height:1.45;margin:4px 0 0}
.tile-grid{display:flex;flex-wrap:wrap;gap:14px;flex:1;align-content:flex-start;align-items:flex-start;margin-top:0}
.tech-tile{width:116px;height:116px;flex-shrink:0;background:radial-gradient(circle at 32% 28%,#eef3fb 0%,#dde6f2 62%,#cfdaec 100%);border:2px solid #b9c6dc;border-radius:16px;padding:14px 10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;text-align:center;box-shadow:0 2px 6px rgba(15,23,42,.07),0 8px 18px -8px rgba(15,23,42,.2),inset 0 1px 2px rgba(255,255,255,.6);transition:opacity .35s ease,filter .35s ease,box-shadow .25s ease,transform .2s ease,border-color .3s ease,background .3s ease;overflow:hidden;position:relative}
.tech-tile:hover{box-shadow:0 4px 10px rgba(15,23,42,.1),0 14px 26px -8px rgba(15,23,42,.26),inset 0 1px 2px rgba(255,255,255,.6);transform:translateY(-2px) scale(1.03)}
.tech-tile.logo-tile{background:#fff;padding:12px 10px}
.tile-logo{max-width:78px;max-height:44px;object-fit:contain;display:block}
.tile-icon-label{font-size:9px;font-weight:800;color:var(--text);line-height:1.15;margin-top:7px;word-break:break-word;text-align:center}
.tile-name{font-size:10.5px;font-weight:800;color:var(--text);line-height:1.22;word-break:break-word}
.tile-vendor{font-size:7.5px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.35px;margin-top:1px}
.tile-caption{font-size:6.5px;font-weight:800;text-transform:uppercase;letter-spacing:.3px;padding:2px 6px;border-radius:20px;margin-top:2px}
.cap-new{color:#7a5a12;background:#fbead0}.cap-retiring{color:#64748b;background:#eef1f5}.cap-constrained{color:#92400e;background:#fdecd2}.cap-under{color:#1e3a8a;background:#dbe4fb}
.state-current .tech-tile.new-tile{display:none}
.state-target .tech-tile.retiring{opacity:.42;filter:grayscale(1);box-shadow:none}
.state-ryg .tech-tile{opacity:1;filter:none;overflow:visible}
.state-ryg .ryg-red{background:color-mix(in srgb,var(--red) 32%,#fff);border-color:var(--red)}
.state-ryg .ryg-yellow{background:color-mix(in srgb,var(--yellow) 32%,#fff);border-color:var(--yellow)}
.state-ryg .ryg-green{background:color-mix(in srgb,var(--green) 32%,#fff);border-color:var(--green)}
.state-ryg .ryg-blue{background:color-mix(in srgb,var(--blue) 32%,#fff);border-color:var(--blue);border-style:dashed}
.ryg-letter{position:absolute;top:6px;right:6px;width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,.94);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:900;line-height:1;box-shadow:0 1px 4px rgba(0,0,0,.35),inset 0 0 0 1px rgba(0,0,0,.06);z-index:2}
.letter-red{color:var(--red)}.letter-yellow{color:#8a6a08}.letter-green{color:var(--green)}.letter-blue{color:var(--blue)}
.gap-tile{background:repeating-linear-gradient(135deg,#fff7e6,#fff7e6 8px,#fdecc4 8px,#fdecc4 16px);border:2px dashed #c9922c;color:#7a5a12;border-radius:50%}
.gap-plus{font-size:28px;line-height:1;color:#c9922c}.gap-label{font-size:11px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:#8a6414;margin-top:4px}
.subgroup{grid-column:1/-1;background:linear-gradient(180deg,#fafbfd,#f7f8fb);display:flex;flex-direction:column;border-top:1px solid var(--line)}
.subgroup-header{padding:11px 19px 9px;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:3px}
.subgroup-tag{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;color:var(--muted-soft)}
.subgroup-header small{color:var(--muted);font-size:11.5px;line-height:1.45}
.subgroup-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));overflow-x:auto}
.nested{border-bottom:0}
.footer{max-width:none;margin:8px clamp(20px,2.8vw,64px) 30px;padding:13px 26px;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--muted);flex-wrap:wrap;gap:8px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
.footer div{display:flex;gap:12px;flex-wrap:wrap}.footer em{font-style:italic;color:var(--muted-soft)}



/* ===== LEVEL 0 ENTERPRISE PORTFOLIO ===== */
.portfolio-shell{
  width:100%;
  min-height:100vh;
  background:
    radial-gradient(circle at 1px 1px,rgba(15,23,42,.045) 1px,transparent 0) 0 0/22px 22px,
    linear-gradient(180deg,#eef1f7 0%,#e5eaf2 100%);
  color:var(--text);
}
.portfolio-hero{
  position:relative;
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(360px,520px);
  gap:44px;
  padding:28px clamp(32px,3vw,58px) 26px;
  color:#fff;
  background:
    repeating-linear-gradient(115deg,rgba(255,255,255,.022) 0 2px,transparent 2px 47px),
    radial-gradient(950px 380px at 12% -25%,rgba(115,155,240,.13),transparent 62%),
    linear-gradient(160deg,#081326 0%,#0d1d38 62%,#122b50 100%);
  box-shadow:0 12px 30px rgba(5,10,25,.28);
  border-bottom:1px solid rgba(198,161,91,.26);
}
.portfolio-hero-copy{min-width:0}
.portfolio-usaa{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:64px;padding:7px 14px;margin-bottom:14px;
  border-radius:4px;background:linear-gradient(145deg,#fff,#dfe6f2);
  color:#07101f;font-size:12px;font-weight:900;letter-spacing:2px;
  box-shadow:0 2px 6px rgba(0,0,0,.25);
}
.portfolio-eyebrow{font-size:10px;font-weight:800;letter-spacing:3px;color:#eddcb3;margin-bottom:8px}
.portfolio-hero h1{margin:0;font-size:30px;line-height:1.05;font-weight:850;letter-spacing:-.6px;color:#fff}
.portfolio-gold-rule{width:42px;height:2px;margin:12px 0 14px;border-radius:2px;background:linear-gradient(90deg,#c6a15b,transparent)}
.portfolio-hero p{max-width:980px;margin:0;color:rgba(255,255,255,.55);font-size:14px;line-height:1.55}
.portfolio-hero-actions{display:flex;flex-direction:column;align-items:flex-end;justify-content:flex-start;gap:22px}
.portfolio-search{
  width:min(100%,390px);height:46px;display:flex;align-items:center;gap:10px;padding:0 15px;
  background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.16);border-radius:10px;
  box-shadow:inset 0 1px 2px rgba(0,0,0,.16);
}
.portfolio-search svg{width:18px;height:18px;fill:none;stroke:rgba(255,255,255,.45);stroke-width:2;flex:none}
.portfolio-search input{width:100%;border:0;outline:0;background:transparent;color:#fff;font-size:13px}
.portfolio-search input::placeholder{color:rgba(255,255,255,.42)}
.portfolio-spend{text-align:right}
.portfolio-spend span{display:block;color:rgba(255,255,255,.52);font-size:10px;font-weight:800;letter-spacing:1.4px}
.portfolio-spend strong{display:block;margin-top:5px;color:#d8af5d;font-size:32px;line-height:1;font-weight:900;letter-spacing:-.8px}
.portfolio-body{padding:24px clamp(32px,3vw,58px) 40px}
.portfolio-toolbar{display:flex;justify-content:flex-end;gap:12px;margin-bottom:16px}
.portfolio-tool-btn{
  border:1px solid #e5e9f0;background:#fff;color:#172033;border-radius:12px;padding:11px 18px;
  font-size:12px;font-weight:800;cursor:pointer;box-shadow:0 5px 16px rgba(15,23,42,.08);
}
.portfolio-tool-btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(15,23,42,.12)}
.portfolio-expand-btn{min-width:190px}.chevron{margin-left:8px}
.portfolio-section{background:#fff;border:1px solid #e3e7ee;border-radius:18px;padding:20px 28px 26px;box-shadow:0 7px 22px rgba(15,23,42,.08)}
.portfolio-section-heading{display:flex;align-items:flex-start;gap:18px;margin:0 4px 14px}
.portfolio-section-rule{width:42px;height:3px;margin-top:2px;border-radius:3px;background:#a84e2f;flex:none}
.portfolio-section-copy{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.portfolio-section-copy h2{margin:0;color:#a84e2f;font-size:13px;font-weight:900;letter-spacing:2px;text-transform:uppercase}
.portfolio-section-copy p{margin:0;color:#707988;font-size:13px}
.portfolio-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.portfolio-card{
  --accent:#2f65b2;position:relative;min-height:192px;overflow:hidden;border:1px solid #e4e7ed;border-radius:16px;background:#fff;
  padding:20px 22px 18px;box-shadow:0 4px 12px rgba(15,23,42,.08);transition:transform .18s ease,box-shadow .18s ease;
}
.portfolio-card:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(15,23,42,.12)}
.portfolio-card-ribbon{position:absolute;top:0;left:0;right:0;height:5px;background:var(--accent)}
.accent-olive{--accent:#8d9c35}.accent-blue{--accent:#2d61ae}.accent-teal{--accent:#3b9e95}.accent-purple{--accent:#7750a6}
.portfolio-card-topline{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-top:2px}
.portfolio-card-topline h3{margin:0;font-size:18px;line-height:1.2;font-weight:850;color:#141b2b;letter-spacing:-.25px}
.portfolio-card-topline strong{font-size:17px;line-height:1.2;color:var(--accent);font-weight:900;white-space:nowrap}
.portfolio-card-divider{height:1px;background:#e7eaf0;margin:14px 0 12px}
.portfolio-card>p{min-height:58px;margin:0;color:#747c8a;font-size:13px;line-height:1.45}
.portfolio-card-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px}
.platform-link,.level-two-label{border:0;background:transparent;color:var(--accent);padding:0;font-size:12px;font-weight:850;cursor:pointer}
.platform-link:hover,.level-two-label:hover{text-decoration:underline}
