    // ---------- New helpers and tests added to raise coverage ----------

    private static Id createParentFor(Schema.SObjectField lookupField) {
        SObject parent = lookupField.getDescribe().getReferenceTo()[0].newSObject();
        Map<String, Schema.SObjectField> parentFields = parent.getSObjectType().getDescribe().fields.getMap();
        if (parentFields.containsKey('Name') && parentFields.get('Name').getDescribe().isCreateable()) {
            parent.put('Name', 'Test Parent');
        }
        insert parent;
        return parent.Id;
    }

    private static TPM_Assessment__c newAssessment(Id periodId) {
        return new TPM_Assessment__c(
            Assessment_Period__c = periodId,
            App__c = createParentFor(TPM_Assessment__c.App__c)
        );
    }

    private static Integer statusHistoryCount(Id periodId) {
        return [
            SELECT COUNT() FROM TPM_Assessment_Period__History
            WHERE ParentId = :periodId AND Field = 'Assessment_Period_Status__c'
        ];
    }

    private static Boolean tryInsertWithLookups(SObject rec) {
        try {
            String ownType = rec.getSObjectType().getDescribe().getName();
            for (Schema.SObjectField token : rec.getSObjectType().getDescribe().fields.getMap().values()) {
                Schema.DescribeFieldResult fieldDescribe = token.getDescribe();
                if (!fieldDescribe.isCreateable() ||
                    fieldDescribe.getType() != Schema.DisplayType.Reference ||
                    fieldDescribe.getReferenceTo().isEmpty()) {
                    continue;
                }
                String target = fieldDescribe.getReferenceTo()[0].getDescribe().getName();
                if (target != 'User' && target != 'Group' && target != 'RecordType' && target != ownType) {
                    rec.put(fieldDescribe.getName(), createParentFor(token));
                }
            }
            insert rec;
            return true;
        } catch (Exception e) {
            return false;
        }
    }

    @isTest
    static void testCyclesIncludePreviousInactiveFromHistory() {
        TPM_Assessment_Period__c published = period('Q4 2025', 'Published');
        TPM_Assessment_Period__c wasPublished = period('Q3 2025', 'Published');
        insert new List<TPM_Assessment_Period__c>{ published, wasPublished };
        wasPublished.Assessment_Period_Status__c = 'Inactive';
        update wasPublished;

        Test.startTest();
        List<Map<String, Object>> result = TpmArchitectureHubAssessmentService.getAvailableCycles();
        Test.stopTest();

        if (statusHistoryCount(wasPublished.Id) > 0) {
            System.assertEquals(2, result.size());
            System.assertEquals('Q42025', result[0].get('period'));
            System.assertEquals('Q32025', result[1].get('period'));
            System.assertEquals('Inactive', result[1].get('status'));
            System.assertEquals(0, result[1].get('count'));
        } else {
            System.assertEquals(1, result.size());
        }
    }

