import { LightningElement } from 'lwc';
import ASSETS from '@salesforce/resourceUrl/TPMusaaCapabilityAssets';
import getPlacematData from '@salesforce/apex/TPMUSAACapabilityPlacematController.getPlacematData';

export default class tpmUsaaCapabilityPlacemat extends LightningElement {
    domains = [];
    groupMap = {};
    portfolio = { title: 'Enterprise Capability Portfolio', description: '', annualForecastSpend: '', groups: [] };
    loadError = '';

    page = 'portfolio'; // portfolio -> platform -> domain
    currentDomainKey = 'communication_insights';
    state = 'current';
    railCollapsed = false;
    searchTerm = '';
    portfolioListView = false;
    expandLevelTwos = false;

    connectedCallback() {
        this.loadPlacematData();
    }

    async loadPlacematData() {
        try {
            const payload = await getPlacematData();
            const data = JSON.parse(payload || '{}');
            this.domains = Array.isArray(data.domains) ? data.domains : [];
            this.groupMap = data.groups || {};
            this.portfolio = data.portfolio || this.portfolio;
            if (!this.domains.some((d) => d.key === this.currentDomainKey) && this.domains.length) {
                this.currentDomainKey = this.domains[0].key;
            }
            this.loadError = '';
        } catch (e) {
            this.loadError = e?.body?.message || e?.message || 'Unable to load capability placemat data.';
            this.domains = [];
            this.groupMap = {};
        }
    }

    get usaaLogoUrl() { return `${ASSETS}/usaa.png`; }
    get isPortfolioPage() { return this.page === 'portfolio'; }
    get isPlatformPage() { return this.page === 'platform'; }
    get isDomainPage() { return this.page === 'domain'; }
    get hasLoadError() { return !!this.loadError; }

    get portfolioShellClass() {
        return `portfolio-shell ${this.portfolioListView ? 'portfolio-list' : 'portfolio-grid'}`;
    }

    get portfolioGroups() {
        const term = (this.searchTerm || '').trim().toLowerCase();
        return (this.portfolio.groups || []).map((group) => {
            const platforms = (group.platforms || [])
                .filter((platform) => {
                    if (!term) return true;
                    return [platform.name, platform.description, platform.spend]
                        .filter(Boolean)
                        .some((value) => String(value).toLowerCase().includes(term));
                })
                .map((platform) => ({
                    ...platform,
                    cardClass: `portfolio-card accent-${platform.accent || 'blue'}`,
                    hasLevelTwos: !!(this.expandLevelTwos && platform.key === 'communications_documents' && this.domains.length),
                    levelTwos: platform.key === 'communications_documents' ? this.domains : []
                }));
            return { ...group, platforms, hasPlatforms: platforms.length > 0 };
        }).filter((group) => group.hasPlatforms);
    }

    get portfolioViewButtonLabel() { return this.portfolioListView ? 'Grid View' : 'List View'; }
    get expandButtonLabel() { return this.expandLevelTwos ? 'Collapse All Level 2s' : 'Expand All Level 2s'; }

    get currentDomain() {
        return this.domains.find((d) => d.key === this.currentDomainKey) || this.domains[0] || { key: '', name: '', desc: '' };
    }
    get groups() { return this.groupMap[this.currentDomainKey] || []; }
    get shellClass() { return `shell state-${this.state} ${this.railCollapsed ? 'rail-collapsed' : ''}`; }
    get sideNavClass() { return 'side-nav'; }
    get currentButtonClass() { return this.state === 'current' ? 'active' : ''; }
    get targetButtonClass() { return this.state === 'target' ? 'active' : ''; }
    get rygButtonClass() { return this.state === 'ryg' ? 'active' : ''; }
    get isRyg() { return this.state === 'ryg'; }

    get navDomains() {
        return this.domains.map((d) => {
            const selected = d.key === this.currentDomainKey && this.page === 'domain';
            const gs = this.groupMap[d.key] || [];
            return {
                ...d,
                selected,
                buttonClass: `nav-domain ${selected ? 'active' : ''}`,
                groups: gs.map((g) => ({
                    ...g,
                    key: `${d.key}-${g.num}`,
                    childrenKey: `${d.key}-${g.num}-kids`,
                    expanded: selected,
                    caps: this.flattenNavCaps(g.caps || [])
                }))
            };
        });
    }

    flattenNavCaps(caps) {
        const out = [];
        caps.forEach((c) => {
            if (c.subGroup) {
                (c.caps || []).forEach((x) => out.push({ ...x, key: `nav-${x.num}-${x.name}`, anchor: `cap-${this.safe(x.num)}` }));
            } else {
                out.push({ ...c, key: `nav-${c.num}-${c.name}`, anchor: `cap-${this.safe(c.num)}` });
            }
        });
        return out;
    }

    get metrics() {
        let capCount = 0;
        let active = 0;
        let gaps = 0;
        this.groups.forEach((g) => (g.caps || []).forEach((c) => {
            const leaves = c.subGroup ? (c.caps || []) : [c];
            leaves.forEach((x) => {
                capCount += 1;
                active += (x.cur || []).filter((t) => t.n !== 'None').length;
                if (!(x.cur || []).length || (x.cur || []).some((t) => t.n === 'None')) gaps += 1;
            });
        }));
        return { groupCount: this.groups.length, capabilityCount: capCount, activeCount: active, gapCount: gaps };
    }

    get displayGroups() {
        return this.groups.map((g) => {
            let leafCount = 0;
            const caps = (g.caps || []).map((c) => {
                if (c.subGroup) {
                    const children = (c.caps || []).map((x) => { leafCount += 1; return this.decorateCap(x); });
                    return { ...c, key: `sg-${c.num}-${c.name}`, anchor: `cap-${this.safe(c.num)}`, isSubGroup: true, children };
                }
                leafCount += 1;
                return { ...this.decorateCap(c), isSubGroup: false };
            });
            return {
                ...g,
                key: `grp-${g.num}-${g.name}`,
                anchor: `grp-${this.safe(g.num)}`,
                leafCountLabel: `${leafCount} ${leafCount === 1 ? 'capability' : 'capabilities'}`,
                caps
            };
        });
    }

    decorateCap(cap) {
        const tiles = this.unionTech(cap.cur || [], cap.tgt || []).map((t, i) => this.decorateTile(t, i));
        const showGap = ((cap.cur || []).length === 0) || (cap.cur || []).some((x) => x.n === 'None');
        return { ...cap, key: `cap-${cap.num}-${cap.name}`, anchor: `cap-${this.safe(cap.num)}`, tiles, showGap };
    }

    unionTech(cur, tgt) {
        const names = [];
        cur.forEach((t) => { if (!names.includes(t.n)) names.push(t.n); });
        tgt.forEach((t) => { if (!names.includes(t.n)) names.push(t.n); });
        return names.filter((n) => n !== 'None').map((n) => {
            const c = cur.find((x) => x.n === n);
            const t = tgt.find((x) => x.n === n);
            return {
                name: n,
                vendor: (t || c)?.v || '',
                inCur: !!c,
                inTgt: !!t,
                conCur: !!c?.c,
                conTgt: !!t?.c,
                isNew: !c && !!t,
                isRetiring: !!c && !t,
                underTgt: !!t?.u,
                rationale: (t?.c && t.rationale) || (c?.c && c.rationale) || '',
                considerationNote: (t?.u && t.note) || ''
            };
        });
    }

    decorateTile(t, i) {
        let ryg = '';
        let letter = '';
        let letterClass = '';
        if (t.isRetiring) { ryg = 'ryg-red'; letter = 'R'; letterClass = 'ryg-letter letter-red'; }
        else if (t.inTgt && t.underTgt) { ryg = 'ryg-blue'; letter = 'U'; letterClass = 'ryg-letter letter-blue'; }
        else if (t.inTgt && t.conTgt) { ryg = 'ryg-yellow'; letter = 'Y'; letterClass = 'ryg-letter letter-yellow'; }
        else if (t.inTgt) { ryg = 'ryg-green'; letter = 'G'; letterClass = 'ryg-letter letter-green'; }

        const showLogo = t.vendor === 'USAA';
        let cls = `tech-tile ${showLogo ? 'logo-tile' : ''} ${t.isNew ? 'new-tile' : ''} ${t.isRetiring ? 'retiring' : ''}`;
        if (this.state === 'ryg' && ryg) cls += ` ${ryg}`;

        let caption = '';
        let captionClass = '';
        if (this.state === 'target') {
            if (t.isNew) { caption = 'New'; captionClass = 'tile-caption cap-new'; }
            else if (t.isRetiring) { caption = 'Retiring'; captionClass = 'tile-caption cap-retiring'; }
            else if (t.underTgt) { caption = 'Under Consideration'; captionClass = 'tile-caption cap-under'; }
            else if (t.conTgt) { caption = 'Constrained'; captionClass = 'tile-caption cap-constrained'; }
        } else if (this.state === 'current' && t.conCur) {
            caption = 'Constrained';
            captionClass = 'tile-caption cap-constrained';
        } else if (this.state === 'ryg') {
            caption = letter === 'R' ? 'Not in Target' : letter === 'Y' ? 'Constrained' : letter === 'U' ? 'Under Consideration' : letter === 'G' ? 'Target' : '';
            captionClass = `tile-caption ${letter === 'R' ? 'cap-retiring' : letter === 'Y' ? 'cap-constrained' : letter === 'U' ? 'cap-under' : 'cap-new'}`;
        }

        const notes = [
            t.rationale ? `Constrained: ${t.rationale}` : '',
            t.considerationNote ? `Under Consideration: ${t.considerationNote}` : ''
        ].filter(Boolean).join(' — ');

        return {
            ...t,
            key: `tile-${i}-${t.name}`,
            className: cls,
            showLogo,
            caption,
            captionClass,
            rygLetter: this.state === 'ryg' ? letter : '',
            rygLetterClass: letterClass,
            title: `${t.name}${t.vendor ? ` · ${t.vendor}` : ''}${notes ? ` — ${notes}` : ''}`
        };
    }

    safe(v) { return String(v).replace(/[^a-zA-Z0-9_-]/g, '-'); }

    handlePortfolioSearch(event) { this.searchTerm = event.target.value || ''; }
    togglePortfolioView() { this.portfolioListView = !this.portfolioListView; }
    toggleLevelTwos() { this.expandLevelTwos = !this.expandLevelTwos; }

    handleOpenPlatform(event) {
        const key = event.currentTarget.dataset.key;
        if (key === 'communications_documents') {
            this.page = 'platform';
            this.state = 'current';
            this.scrollWindowTop();
        }
    }

    handleLevelTwoOpen(event) {
        const key = event.currentTarget.dataset.key;
        if (!key) return;
        this.currentDomainKey = key;
        this.page = 'domain';
        this.state = 'current';
        this.scrollWindowTop();
    }

    handlePortfolioHome() {
        this.page = 'portfolio';
        this.searchTerm = '';
        this.railCollapsed = false;
        this.scrollWindowTop();
    }

    handlePlatformHome() {
        this.page = 'platform';
        this.state = 'current';
        this.scrollWindowTop();
    }

    handleState(event) { this.state = event.currentTarget.dataset.state; }
    toggleRail() { this.railCollapsed = !this.railCollapsed; }

    handleDomainSelect(event) {
        this.currentDomainKey = event.currentTarget.dataset.key;
        this.page = 'domain';
        this.state = 'current';
        this.scrollTop();
    }

    handleGroupScroll(event) { this.scrollTo(`[data-group-anchor="grp-${this.safe(event.currentTarget.dataset.group)}"]`); }
    handleCapScroll(event) { this.scrollTo(`[data-cap-anchor="${event.currentTarget.dataset.cap}"]`); }

    scrollWindowTop() { window.scrollTo?.({ top: 0, behavior: 'smooth' }); }
    scrollTop() {
        const main = this.template.querySelector('.main');
        if (main) main.scrollTo?.({ top: 0, behavior: 'smooth' });
        this.scrollWindowTop();
    }
    scrollTo(selector) {
        const el = this.template.querySelector(selector);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}


