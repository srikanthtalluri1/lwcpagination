    @AuraEnabled
    public static List<ASP_StandardDTO> getStandards(ASP_FiltersDTO filters) {
        List<ASP_StandardDTO> mappedStandards = new List<ASP_StandardDTO>();

        try {
            String userId = UserInfo.getUserId();
            String query = 'SELECT Id, Name, Active__c, Class__c, Status__c, Stage__c, Next_Review_Due_Date__c, Owner__r.Employee_ID__c, Owner__r.Name ';
            query += 'FROM ASP_Architecture_Standard__c ';

            List<String> whereClauses = new List<String>();
            //pmd fix 8-27
            Map<String, Object> queryBinds = new Map<String, Object>();

            // Class
            //pmd fix 8-27
            if (filters.classes != null && filters.classes.size() > 0) {
                queryBinds.put('classes', filters.classes);
                whereClauses.add('Class__c IN :classes');
            }

            // Owner
            //pmd fix 8-27
            if (filters.owners != null && filters.owners.size() > 0) {
                queryBinds.put('owners', filters.owners);
                whereClauses.add('Owner__r.Employee_ID__c IN :owners');
            }

            // Status
            if (filters.statuses != null && filters.statuses.size() > 0) {
                List<String> statusClauses = new List<String>();

                for (String status : filters.statuses) {
                    if (status.equalsIgnoreCase('Draft'))
                        statusClauses.add('Status__c = \'Draft\'');
                    if (status.equalsIgnoreCase('Acknowledged'))
                        statusClauses.add('Status__c = \'Acknowledged\'');
                    if (status.equalsIgnoreCase('Approved'))
                        statusClauses.add('Active__c = TRUE');
                    if (status.equalsIgnoreCase('Retired'))
                        statusClauses.add('Status__c = \'Retired\'');
                    if (status.equalsIgnoreCase('Withdrawn'))
                        statusClauses.add('Status__c = \'Withdrawn\'');
                }

                whereClauses.add('(' + String.join(statusClauses, ' OR ') + ')');
            }

            // Portfolio
            if (filters.portfolios != null && filters.portfolios.size() > 0) {
                Map<Id, TPM_Domain__c> domainsWithinPortfolios = new Map<Id, TPM_Domain__c>(
                    [
                        SELECT Id
                        FROM TPM_Domain__c
                        WHERE Port__c IN :filters.portfolios
                    ]
                );

                //pmd fix 8-27
                queryBinds.put('portfolios', filters.portfolios);
                if (domainsWithinPortfolios.size() > 0) {
                    queryBinds.put('portfolioDomainIds', domainsWithinPortfolios.keySet());
                    whereClauses.add('(Portfolio__r.Id IN :portfolios OR Domain__r.Id IN :portfolioDomainIds)');
                } else {
                    whereClauses.add('Portfolio__r.Id IN :portfolios');
                }
            }

            // Domain
            //pmd fix 8-27
            if (filters.domains != null && filters.domains.size() > 0) {
                queryBinds.put('domains', filters.domains);
                whereClauses.add('Domain__r.Id IN :domains');
            }

            // Stack Layer
            if (filters.layers != null && filters.layers.size() > 0) {
                List<TPM_Stack_Layer_Config__c> stackLayers = [
                    SELECT Supporting_Standard__r.Zephyr_Standard_ID__c
                    FROM TPM_Stack_Layer_Config__c
                    WHERE Supporting_Standard__c != NULL AND Id IN :filters.layers AND Inactive__c != TRUE  WITH SYSTEM_MODE
                ];

                // Extract Zephyr_Standard_ID__c values from stackLayers
                List<String> zephyrStandardIds = new List<String>();
                for (TPM_Stack_Layer_Config__c stackLayer : stackLayers) {
                    if (stackLayer.Supporting_Standard__r != null) {
                        zephyrStandardIds.add(stackLayer.Supporting_Standard__r.Zephyr_Standard_ID__c);
                    }
                }
                Set<Id> idsToFilterBy = new Set<Id>();
                if (zephyrStandardIds.size() > 0) {
                    idsToFilterBy.addAll(
                        new Map<Id, AggregateResult>(
                                [
                                    SELECT Id
                                    FROM ASP_Architecture_Standard__c
                                    WHERE Source_System_ID__c != NULL AND Source_System_ID__c IN :zephyrStandardIds
                                    GROUP BY Id
                                ]
                            )
                            .keySet()
                    );
                    //pmd fix 8-27
                    queryBinds.put('stackLayerStandardIds', idsToFilterBy);
                    whereClauses.add('Id IN :stackLayerStandardIds');
                }
            }

            //Following
            if (filters.following != null && filters.following.toLowerCase() == 'true') {
                //Standard Id the user is following
                List<String> idsToFilterBy = getUserStandardFollowerAssignmentsByUserId(userId);
                //pmd fix 8-27
                queryBinds.put('followingStandardIds', idsToFilterBy);
                whereClauses.add('Id IN :followingStandardIds');
            }

            if (whereClauses.size() > 0)
                query += 'WHERE ' + String.join(whereClauses, ' AND ');

            //pmd fix 8-27
            List<ASP_Architecture_Standard__c> results = Database.queryWithBinds(
                query,
                queryBinds,
                AccessLevel.SYSTEM_MODE
            );

            List<String> userPermissionSets = getUserPermissionSets(userId);
            String employeeNumber = getUserEmployeeNumber(userId);
            List<String> userStandardAuthorAssignments = getUserStandardAuthorAssignmentsByEmployeeNumber(
                employeeNumber
            );
            List<String> userStandardAcknowledgerAssignments = getUserStandardAcknowledgerAssignmentsByEmployeeNumber(
                employeeNumber
            );

            for (ASP_Architecture_Standard__c standard : results) {
                Boolean userCanViewStandardUnapprovedChanges = userCanViewStandardUnapprovedChanges(
                    standard,
                    employeeNumber,
                    userPermissionSets,
                    userStandardAuthorAssignments,
                    userStandardAcknowledgerAssignments
                );

                // If there's no version of the standard that the user can view (standard is not yet active/published,
                // hasn't been retired, and the user can't view unapproved changes on that standard), exclude it
                if (
                    (!standard.Active__c && !standard.Status__c.equalsIgnoreCase('Retired')) &&
                    !userCanViewStandardUnapprovedChanges
                )
                    continue;

                // If the user is filtering by a status of Draft, Acknowledged, or Withdrawn and the standard is in a
                // status that matches the filter, but that version of the standard is not viewable by the user (i.e.:
                // the user can view the approved/published version, but not a revision in Draft), and the user didn't
                // include the Approved status in their filter (they ONLY want to see Draft, Acknowledged, or
                // Withdrawn), exclude that standard
                if (
                    (standard.Status__c.equalsIgnoreCase('Draft') ||
                    standard.Status__c.equalsIgnoreCase('Acknowledged') ||
                    standard.Status__c.equalsIgnoreCase('Withdrawn')) &&
                    filters.statuses != null &&
                    ASP_Utils.containsIgnoreCase(filters.statuses, standard.Status__c) &&
                    !ASP_Utils.containsIgnoreCase(filters.statuses, 'Approved') &&
                    !userCanViewStandardUnapprovedChanges
                )
                    continue;

                ASP_StatusDTO statusDTO = getStatus(standard, userCanViewStandardUnapprovedChanges);

                mappedStandards.add(
                    new ASP_StandardDTO(
                        standard.Id,
                        standard.Name,
                        standard.Active__c,
                        standard.Class__c,
                        standard.Status__c,
                        standard.Stage__c,
                        standard.Next_Review_Due_Date__c,
                        standard.Owner__r.Employee_ID__c,
                        standard.Owner__r.Name,
                        statusDTO.overallStatus,
                        statusDTO.revisionStatus
                    )
                );
            }

            return mappedStandards;
        } catch (Exception e) {
            throw new AuraHandledException('Failed to retrieve standards.');
        }
    }

