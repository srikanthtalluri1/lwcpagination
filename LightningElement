	get filteredApplications() {
		const rows = [...this.explorerRows];
		const direction = this.explorerSortDirection === 'asc' ? 1 : -1;
		return rows.sort((left, right) => {
			const a = left[this.explorerSortBy];
			const b = right[this.explorerSortBy];
			return typeof a === 'number' && typeof b === 'number'
				? (a - b) * direction
				: String(a ?? '').localeCompare(String(b ?? '')) * direction;
		});
	}

