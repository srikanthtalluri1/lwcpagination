import { LightningElement, api } from 'lwc';
import getApprovedWaivers from '@salesforce/apex/TpmArchitectureHubWaiverService.getApprovedWaivers';

const FORMAT = new Intl.NumberFormat('en-US');
const COLS = [
    { key: 'name', label: 'Waiver' },
    { key: 'portfolio', label: 'Portfolio' },
    { key: 'domain', label: 'Requesting Domain' },
    { key: 'standard', label: 'Standard Waived' },
    { key: 'renewals', label: 'Renewals' },
    { key: 'renewalState', label: 'Renewal State' },
    { key: 'application', label: 'Assessed Application' },
    { key: 'appOverall', label: 'Health' },
    { key: 'architect', label: 'Requesting Architect' }
];

export default class TpmArchitectureHubWaivers extends LightningElement {
    @api applications = [];
    @api portfolios = [];
    @api portfolioName = '';

    rawRows = [];
    loading = false;
    loaded = false;
    loadError = '';
    truncated = false;
    availableFields = [];
    searchText = '';
    selectedPortfolio = '';
    selectedStandard = '';
    selectedRenewal = '';
    sortKey = 'renewals';
    sortAscending = false;
    page = 1;
    pageSize = 25;

    connectedCallback() {
        this.loadWaivers();
    }

    loadWaivers() {
        if (this.loading) return;
        this.loading = true;
        this.loadError = '';
        getApprovedWaivers()
            .then((result) => {
                this.rawRows = Array.isArray(result?.rows) ? result.rows : [];
                this.availableFields = Array.isArray(result?.availableFields) ? result.availableFields : [];
                this.truncated = Boolean(result?.truncated);
                this.loaded = true;
                this.dispatchEvent(new CustomEvent('waiversloaded', { detail: { count: this.rawRows.length } }));
            })
            .catch((error) => {
                this.rawRows = [];
                this.loadError = error?.body?.message || error?.message || 'Unable to load the waiver register.';
                this.loaded = false;
            })
            .finally(() => { this.loading = false; });
    }

    get isPortfolioView() { return Boolean(this.portfolioName); }
    get isEnterpriseView() { return !this.isPortfolioView; }
    get showNoFilteredRows() { return this.filteredRows.length === 0; }
    get title() { return this.isPortfolioView ? 'Waivers Against This Portfolio' : 'Waivers & Exceptions'; }
    get hasData() { return this.scopedRows.length > 0; }
    get hasRenewalData() { return this.availableFields.includes('renewals') && this.rawRows.some((r) => r.renewals !== null && r.renewals !== undefined); }
    get hasStandardData() { return this.availableFields.includes('standard') && this.rawRows.some((r) => Boolean(r.standard)); }
    get hasRenewalStateData() { return this.availableFields.includes('renewalState') && this.rawRows.some((r) => Boolean(r.renewalState)); }

    // Only match application names that occur exactly once in the selected assessment cycle.
    // Do not invent a Salesforce application relationship when the waiver carries only text.
    get applicationLookup() {
        const byName = new Map();
        for (const app of this.applications || []) {
            const name = this.normalized(app?.name);
            if (!name) continue;
            if (!byName.has(name)) byName.set(name, []);
            byName.get(name).push(app);
        }
        return byName;
    }

    get allRows() {
        const appLookup = this.applicationLookup;
        return this.rawRows.map((row) => {
            const matches = appLookup.get(this.normalized(row.application)) || [];
            const app = matches.length === 1 ? matches[0] : null;
            const rating = this.asNumber(app?.overall);
            const renewalCount = this.asNumber(row.renewals);
            const linked = Boolean(app);
            const healthBand = rating === null ? '' : rating < 2.5 ? 'Red' : rating < 3.5 ? 'Yellow' : 'Green';
            return {
                ...row,
                name: row.name || 'Unnamed waiver',
                portfolio: row.portfolio || '',
                domain: row.domain || '',
                standard: row.standard || '',
                architect: row.architect || '',
                application: row.application || '',
                renewalState: row.renewalState || '',
                renewals: renewalCount,
                renewalDisplay: renewalCount === null ? '—' : renewalCount >= 2 ? `${renewalCount}× renewed` : renewalCount === 1 ? 'renewed once' : 'first term',
                renewalClass: renewalCount === null ? 'pill muted' : renewalCount >= 2 ? 'pill danger' : renewalCount === 1 ? 'pill warning' : 'pill muted',
                stateDisplay: row.renewalState || '—',
                appOverall: rating,
                appHealthDisplay: rating === null ? '—' : rating.toFixed(2),
                appHealthClass: rating === null ? 'health neutral' : healthBand === 'Red' ? 'health red' : healthBand === 'Yellow' ? 'health yellow' : 'health green',
                appBarr: linked ? (app.barr || '') : '',
                matchedApplication: linked,
                matchState: linked ? 'Matched by unique name' : 'Unmatched',
                hasStandard: Boolean(row.standard),
                hasApplication: linked && Boolean(row.application)
            };
        });
    }

    get scopedRows() {
        const filter = this.normalized(this.portfolioName);
        return filter ? this.allRows.filter((row) => this.normalized(row.portfolio) === filter) : this.allRows;
    }

    get countDisplay() { return FORMAT.format(this.scopedRows.length); }
    get standardsSummary() {
        const counts = new Map();
        for (const row of this.scopedRows) {
            if (row.standard) counts.set(row.standard, (counts.get(row.standard) || 0) + 1);
        }
        const ranked = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
        const max = ranked.length ? ranked[0][1] : 1;
        return ranked.map(([name, count]) => ({
            name, count,
            percent: this.scopedRows.length ? (count / this.scopedRows.length * 100).toFixed(1) : '0.0',
            style: `width:${count / max * 100}%;`,
            key: name
        }));
    }
    get standardCount() { return FORMAT.format(this.standardsSummary.length); }
    get renewedCount() { return this.scopedRows.filter((r) => r.renewals !== null && r.renewals >= 1).length; }
    get agingCount() { return this.scopedRows.filter((r) => r.renewals !== null && r.renewals >= 2).length; }
    get unhealthyCount() { return this.scopedRows.filter((r) => r.appHealthClass === 'health red').length; }
    get linkedCount() { return this.scopedRows.filter((r) => r.matchedApplication).length; }
    get renewedDisplay() { return this.hasRenewalData ? FORMAT.format(this.renewedCount) : '—'; }
    get agingDisplay() { return this.hasRenewalData ? FORMAT.format(this.agingCount) : '—'; }
    get unhealthyDisplay() { return FORMAT.format(this.unhealthyCount); }
    get percentRenewed() { return this.scopedRows.length && this.hasRenewalData ? `${Math.round(this.renewedCount / this.scopedRows.length * 100)}% of register` : 'not available'; }
    get topThreeSummary() {
        const top = this.standardsSummary.slice(0, 3).reduce((n, item) => n + item.count, 0);
        return this.scopedRows.length ? `Top 3 standards account for ${top} of ${this.scopedRows.length} waivers (${Math.round(top / this.scopedRows.length * 100)}%).` : '';
    }

    get portfolioSummary() {
        const counts = new Map();
        for (const row of this.allRows) {
            const name = row.portfolio;
            if (!name) continue;
            if (!counts.has(name)) counts.set(name, []);
            counts.get(name).push(row);
        }
        const assessments = new Map((this.portfolios || []).map((item) => [this.normalized(item.name), item]));
        return [...counts.entries()].map(([name, records]) => {
            const portfolio = assessments.get(this.normalized(name));
            const apps = portfolio?.count ?? null;
            const denominator = this.asNumber(apps);
            const distinct = new Set(records.map((r) => r.standard).filter(Boolean));
            return {
                name, count: records.length,
                appCount: denominator === null ? '—' : FORMAT.format(denominator),
                perHundred: denominator ? (records.length / denominator * 100).toFixed(1) : '—',
                standards: distinct.size,
                aging: this.hasRenewalData ? records.filter((r) => r.renewals !== null && r.renewals >= 2).length : '—',
                active: this.hasRenewalStateData ? records.filter((r) => this.normalized(r.renewalState) === 'active renewal').length : '—',
                forecast: this.hasRenewalStateData ? records.filter((r) => this.normalized(r.renewalState) === 'forecasted renewal').length : '—',
                known: Boolean(portfolio)
            };
        }).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
    }

    get portfolioFilterOptions() { return [...new Set(this.scopedRows.map((r) => r.portfolio).filter(Boolean))].sort(); }
    get standardFilterOptions() { return [...new Set(this.scopedRows.map((r) => r.standard).filter(Boolean))].sort(); }
    get renewalFilterOptions() { return [...new Set(this.scopedRows.map((r) => r.renewalState).filter(Boolean))].sort(); }
    get filteredRows() {
        const term = this.normalized(this.searchText);
        const results = this.scopedRows.filter((row) => {
            if (this.selectedPortfolio && row.portfolio !== this.selectedPortfolio) return false;
            if (this.selectedStandard && row.standard !== this.selectedStandard) return false;
            if (this.selectedRenewal && row.renewalState !== this.selectedRenewal) return false;
            if (!term) return true;
            return [row.name, row.portfolio, row.domain, row.standard, row.architect, row.application]
                .some((v) => this.normalized(v).includes(term));
        });
        const field = this.sortKey;
        const multiplier = this.sortAscending ? 1 : -1;
        return results.sort((a, b) => {
            const left = a[field], right = b[field];
            if (field === 'renewals' || field === 'appOverall') {
                const x = left === null ? -1 : left;
                const y = right === null ? -1 : right;
                return (x - y) * multiplier;
            }
            return String(left || '').localeCompare(String(right || '')) * multiplier;
        });
    }
    get filteredCount() { return FORMAT.format(this.filteredRows.length); }
    get pageRows() { return this.filteredRows.slice((this.page - 1) * this.pageSize, this.page * this.pageSize); }
    get pages() { return Math.max(1, Math.ceil(this.filteredRows.length / this.pageSize)); }
    get pageLabel() { return `Page ${this.page} of ${this.pages}`; }
    get disablePrevious() { return this.page <= 1; }
    get disableNext() { return this.page >= this.pages; }
    get columns() {
        return COLS.map((col) => ({...col,
            text: this.sortKey === col.key ? `${col.label} ${this.sortAscending ? '▲' : '▼'}` : col.label
        }));
    }

    handleSearch(event) { this.searchText = event.target.value || ''; this.page = 1; }
    handlePortfolioFilter(event) { this.selectedPortfolio = event.target.value; this.page = 1; }
    handleStandardFilter(event) { this.selectedStandard = event.target.value; this.page = 1; }
    handleRenewalFilter(event) { this.selectedRenewal = event.target.value; this.page = 1; }
    handleReset() { this.searchText = ''; this.selectedPortfolio = ''; this.selectedStandard = ''; this.selectedRenewal = ''; this.page = 1; }
    handleSort(event) {
        const key = event.currentTarget.dataset.sort;
        if (!COLS.some((col) => col.key === key)) return;
        if (this.sortKey === key) this.sortAscending = !this.sortAscending;
        else { this.sortKey = key; this.sortAscending = true; }
        this.page = 1;
    }
    handlePrevious() { this.page = Math.max(1, this.page - 1); }
    handleNext() { this.page = Math.min(this.pages, this.page + 1); }
    handleStandardOpen(event) { this.selectedStandard = event.currentTarget.dataset.standard || ''; this.page = 1; }
    handlePortfolioOpen(event) {
        const name = event.currentTarget.dataset.portfolio;
        if (name) this.dispatchEvent(new CustomEvent('portfolionavigate', { detail: { name } }));
    }
    handleApplicationOpen(event) {
        const name = event.currentTarget.dataset.application;
        if (name) this.dispatchEvent(new CustomEvent('applicationnavigate', { detail: { name } }));
    }
    handleRefresh() { this.loadWaivers(); }
    normalized(value) { return String(value || '').trim().toLocaleLowerCase(); }
    asNumber(value) {
        if (value === null || value === undefined || value === '') return null;
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : null;
    }
}
