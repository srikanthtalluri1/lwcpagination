import { LightningElement } from 'lwc';
import { NavigationMixin } from 'lightning/navigation';
import getPortfolio from '@salesforce/apex/TPMUSAAEnterprisePortfolioController.getPortfolio';
import portfolioData from '@salesforce/resourceUrl/usaaEnterprisePortfolioData';

export default class TpmUsaaEnterprisePortfolio extends NavigationMixin(LightningElement) {
    portfolio;
    layers = [];
    isLoading = true;
    loadError;

    searchTerm = '';
    searchIndex = [];
    appSearchIndex = [];
    searchLoading = true;
    searchLoadAttempted = false;
    capabilityResults = [];
    applicationResults = [];
    showSearchResults = false;

    expandAll = false;
    listView = false;

    connectedCallback() {
        this.initialize();
        this.loadSearchIndexes();
    }

    async initialize() {
        this.isLoading = true;
        this.loadError = undefined;

        try {
            const response = await getPortfolio();
            this.portfolio = response;
            this.layers = this.decorateLayers(response?.layers || []);
        } catch (error) {
            this.loadError =
                error?.body?.message ||
                error?.message ||
                'Unable to load the enterprise capability portfolio.';
        } finally {
            this.isLoading = false;
        }
    }

    async loadSearchIndexes() {
        if (this.searchLoadAttempted) {
            return;
        }

        this.searchLoadAttempted = true;
        this.searchLoading = true;

        try {
            const [capabilityResponse, applicationResponse] = await Promise.all([
                fetch(`${portfolioData}/searchIndex.json`),
                fetch(`${portfolioData}/appSearchIndex.json`)
            ]);

            if (!capabilityResponse.ok || !applicationResponse.ok) {
                throw new Error('Search index resource could not be loaded.');
            }

            const [capabilityData, applicationData] = await Promise.all([
                capabilityResponse.json(),
                applicationResponse.json()
            ]);

            this.searchIndex = Array.isArray(capabilityData) ? capabilityData : [];
            this.appSearchIndex = Array.isArray(applicationData) ? applicationData : [];
        } catch (error) {
            this.searchIndex = [];
            this.appSearchIndex = [];
        } finally {
            this.searchLoading = false;
            if (this.searchTerm.trim()) {
                this.runSearch(this.searchTerm);
            }
        }
    }

    decorateLayers(sourceLayers) {
        return sourceLayers.map((layer, layerIndex) => ({
            ...layer,
            key: `layer-${layerIndex}-${layer.label}`,
            style: `--accent:${layer.accent}`,
            cards: (layer.cards || []).map((card, cardIndex) =>
                this.decorateCard(card, layerIndex, cardIndex, false)
            )
        }));
    }

    decorateCard(card, layerIndex, cardIndex, isExpanded) {
        const owners = (card.owners || []).map((owner, ownerIndex) => ({
            ...owner,
            key: `owner-${layerIndex}-${cardIndex}-${ownerIndex}`
        }));

        const capabilityItems = (card.level2Capabilities || []).map((label, capabilityIndex) => ({
            label,
            key: `cap-${layerIndex}-${cardIndex}-${capabilityIndex}`
        }));

        return {
            ...card,
            key: `card-${layerIndex}-${cardIndex}-${card.title}`,
            style: `--accent:${card.accent}`,
            owners,
            capabilityItems,
            isExpanded,
            hasCost: Boolean(card.cost),
            hasOwners: owners.length > 0,
            ownerMessage: card.ownerMessage || 'Not yet assigned',
            expandLabel: isExpanded ? 'Hide' : 'Level 2s',
            ariaExpanded: isExpanded ? 'true' : 'false',
            expandButtonClass: isExpanded ? 'p-card-expand is-open' : 'p-card-expand'
        };
    }

    get isReady() {
        return !this.isLoading && !this.loadError && this.portfolio;
    }

    get sectionsClass() {
        return this.listView ? 'sections list-view' : 'sections';
    }

    get listViewLabel() {
        return this.listView ? 'Grid View' : 'List View';
    }

    get expandAllLabel() {
        return this.expandAll ? 'Collapse All Level 2s' : 'Expand All Level 2s';
    }

    get expandAllAria() {
        return this.expandAll ? 'true' : 'false';
    }

    get expandAllButtonClass() {
        return this.expandAll ? 'expand-all-btn is-all-open' : 'expand-all-btn';
    }

    get hasCapabilityResults() {
        return this.capabilityResults.length > 0;
    }

    get hasApplicationResults() {
        return this.applicationResults.length > 0;
    }

    get hasSearchMatches() {
        return this.hasCapabilityResults || this.hasApplicationResults;
    }

    get searchEmptyMessage() {
        if (!this.searchTerm.trim()) {
            return '';
        }
        return `No capabilities or applications match “${this.searchTerm.trim()}”`;
    }

    handleSearchInput(event) {
        this.searchTerm = event.target.value;
        this.runSearch(this.searchTerm);
    }

    handleSearchFocus() {
        if (!this.searchLoadAttempted) {
            this.loadSearchIndexes();
        }
        if (this.searchTerm.trim()) {
            this.showSearchResults = true;
            this.runSearch(this.searchTerm);
        }
    }

    handleSearchBlur() {
        window.setTimeout(() => {
            this.showSearchResults = false;
        }, 150);
    }

    handleSearchMouseDown() {
        this.showSearchResults = false;
    }

    runSearch(rawValue) {
        const raw = rawValue || '';
        const query = raw.trim().toLowerCase();

        if (!query) {
            this.capabilityResults = [];
            this.applicationResults = [];
            this.showSearchResults = false;
            return;
        }

        this.showSearchResults = true;

        if (this.searchLoading) {
            return;
        }

        this.capabilityResults = this.searchIndex
            .map((item, index) => ({
                item,
                index,
                score: this.scoreCapability(query, item)
            }))
            .filter((entry) => entry.score >= 0)
            .sort((a, b) => b.score - a.score)
            .slice(0, 6)
            .map((entry) => this.toCapabilityResult(entry.item, entry.index));

        this.applicationResults = this.appSearchIndex
            .map((item, index) => ({
                item,
                index,
                score: this.scoreApplication(query, item)
            }))
            .filter((entry) => entry.score >= 0)
            .sort((a, b) => b.score - a.score)
            .slice(0, 6)
            .map((entry) => this.toApplicationResult(entry.item, entry.index));
    }

    scoreText(query, text) {
        const value = (text || '').toLowerCase();
        if (!value) {
            return -1;
        }
        if (value === query) {
            return 100;
        }
        if (value.indexOf(query) === 0) {
            return 80;
        }
        if (value.split(/\s+/).some((word) => word.indexOf(query) === 0)) {
            return 60;
        }
        if (value.indexOf(query) !== -1) {
            return 40;
        }
        return -1;
    }

    scoreCapability(query, item) {
        const title = (item.t || '').toLowerCase();
        if (title === query) {
            return 100;
        }
        if (title.indexOf(query) === 0) {
            return 80;
        }
        if (title.split(/\s+/).some((word) => word.indexOf(query) === 0)) {
            return 60;
        }
        if (title.indexOf(query) !== -1) {
            return 40;
        }

        const domain = (item.dn || '').toLowerCase();
        const platform = (item.pl || '').toLowerCase();
        if (domain.indexOf(query) !== -1 || platform.indexOf(query) !== -1) {
            return 15;
        }
        return -1;
    }

    scoreApplication(query, item) {
        const appScore = this.scoreText(query, item.app);
        if (appScore >= 0) {
            return appScore;
        }

        const vendorScore = this.scoreText(query, item.vendor);
        if (vendorScore >= 0) {
            return vendorScore - 5;
        }

        const technology = (item.t || '').toLowerCase();
        const platform = (item.pl || '').toLowerCase();
        if (technology.indexOf(query) !== -1 || platform.indexOf(query) !== -1) {
            return 10;
        }
        return -1;
    }

    toCapabilityResult(item, index) {
        return {
            key: `cap-search-${index}-${item.p}-${item.d}-${item.n}`,
            name: item.t,
            platform: item.pl,
            domain: item.dn,
            href: `${item.html}#cap=${encodeURIComponent(`${item.d}::${item.n}`)}`,
            style: `--accent:${item.accent || '#2554a6'}`
        };
    }

    toApplicationResult(item, index) {
        return {
            key: `app-search-${index}-${item.p}-${item.d}-${item.n}-${item.app}`,
            name: item.app,
            platform: item.pl,
            technology: item.t,
            vendorDisplay: item.vendor ? ` · ${item.vendor}` : '',
            href: `${item.html}#cap=${encodeURIComponent(`${item.d}::${item.n}`)}`,
            style: `--accent:${item.accent || '#2554a6'}`
        };
    }

    toggleListView() {
        this.listView = !this.listView;
    }

    toggleExpandAll() {
        this.expandAll = !this.expandAll;
        const open = this.expandAll;

        this.layers = this.layers.map((layer, layerIndex) => ({
            ...layer,
            cards: layer.cards.map((card, cardIndex) =>
                this.decorateCard(card, layerIndex, cardIndex, open)
            )
        }));
    }

    toggleCard(event) {
        event.stopPropagation();

        const layerIndex = Number(event.currentTarget.dataset.layerIndex);
        const cardIndex = Number(event.currentTarget.dataset.cardIndex);

        this.layers = this.layers.map((layer, currentLayerIndex) => {
            if (currentLayerIndex !== layerIndex) {
                return layer;
            }

            return {
                ...layer,
                cards: layer.cards.map((card, currentCardIndex) => {
                    if (currentCardIndex !== cardIndex) {
                        return card;
                    }
                    return this.decorateCard(
                        card,
                        layerIndex,
                        cardIndex,
                        !card.isExpanded
                    );
                })
            };
        });

        this.expandAll = this.layers.every((layer) =>
            layer.cards.every((card) => card.isExpanded)
        );
    }

    handlePlatformLinkClick(event) {
        event.stopPropagation();
    }

    handleCardClick(event) {
        if (
            event.target.closest('button') ||
            event.target.closest('a') ||
            event.target.closest('.p-card-levels')
        ) {
            return;
        }

        this.navigateToUrl(event.currentTarget.dataset.href);
    }

    handleCardKeydown(event) {
        if (event.target !== event.currentTarget) {
            return;
        }

        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            this.navigateToUrl(event.currentTarget.dataset.href);
        }
    }

    navigateToUrl(url) {
        if (!url) {
            return;
        }

        this[NavigationMixin.Navigate]({
            type: 'standard__webPage',
            attributes: {
                url
            }
        });
    }
}
