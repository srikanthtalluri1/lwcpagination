@IsTest
private class TechnologyDecision_RelatedListTest {

    private static final String TEST_USER_LAST_NAME = 'RelListTestUser';

    // User + PermissionSetAssignment are setup objects, so DML runs inside runAs(current user) to avoid MIXED_DML_OPERATION.
    private static User createTestUser() {
        User thisUser = [SELECT Id FROM User WHERE Id = :UserInfo.getUserId()];
        User testUser;
        System.runAs(thisUser) {
            testUser = new User(
                ProfileId = [SELECT Id FROM Profile WHERE Name = 'Standard User' LIMIT 1].Id,
                LastName = TEST_USER_LAST_NAME,
                Email = 'relatedlisttest@usaa.com',
                Username = 'relatedlisttest' + System.currentTimeMillis() + '@usaa.com.test',
                Alias = 'rellist',
                TimeZoneSidKey = 'America/Los_Angeles',
                EmailEncodingKey = 'UTF-8',
                LanguageLocaleKey = 'en_US',
                LocaleSidKey = 'en_US',
                EmployeeNumber = 'P4445',
                IsActive = true
            );
            insert testUser;

            List<PermissionSetAssignment> assignments = new List<PermissionSetAssignment>();
            for (PermissionSet ps : [SELECT Id FROM PermissionSet WHERE Name = 'Technology_Decission']) {
                assignments.add(new PermissionSetAssignment(AssigneeId = testUser.Id, PermissionSetId = ps.Id));
            }
            insert assignments;
        }
        return testUser;
    }

    private static User relUser() {
        return [SELECT Id FROM User WHERE LastName = :TEST_USER_LAST_NAME LIMIT 1];
    }

    @testSetup
    static void setupData() {
        User testUser = createTestUser();
        System.runAs(testUser) {
            // Match the test user's EmployeeNumber for employee-lookup utilities.
            if ([SELECT COUNT() FROM UCH_Employee__c
                 WHERE Employee_ID__c = :testUser.EmployeeNumber] == 0) {
                insert new UCH_Employee__c(
                    Name = 'Related List Test Employee',
                    Employee_ID__c = testUser.EmployeeNumber,
                    Employee_Email_Address__c = testUser.Email,
                    Department_Description__c = 'Testing Dep 1',
                    Department_ID__c = 'Test00',
                    Active_Flag__c = 'TRUE'
                );
            }

            TechnologyDecision__c decision = new TechnologyDecision__c(
                Is_Create_Notification_Send__c = true,
                Is_Initial_Creation__c = true
            );
            insert decision;

            TechnologyDecision_StakeHolder__c sh1 = new TechnologyDecision_StakeHolder__c(
                Decision__c = decision.Id,
                Role__c = 'Business Owner'
            );
            TechnologyDecision_StakeHolder__c sh2 = new TechnologyDecision_StakeHolder__c(
                Decision__c = decision.Id,
                Role__c = 'Sponsor'
            );
            insert new List<TechnologyDecision_StakeHolder__c>{ sh1, sh2 };
        }
    }

    @IsTest
    static void testFetchRelated() {
        System.runAs(relUser()) {
            TechnologyDecision__c decision = [SELECT Id FROM TechnologyDecision__c LIMIT 1];

            List<TechnologyDecision_StakeHolder__c> result;
            Test.startTest();
            result = TechnologyDecision_RelatedListHandler.fetchRelated(decision.Id);
            Test.stopTest();

            System.assertEquals(2, result.size(), 'Should return 2 stakeholders.');
            System.assertNotEquals(null, result[0].CreatedDate, 'CreatedDate should be populated.');
        }
    }

    @IsTest
    static void testFetchRelated_NoRecords() {
        List<TechnologyDecision_StakeHolder__c> result;
        System.runAs(relUser()) {
            TechnologyDecision__c emptyDecision = new TechnologyDecision__c(
                Is_Create_Notification_Send__c = true,
                Is_Initial_Creation__c = true
            );
            insert emptyDecision;

            Test.startTest();
            result = TechnologyDecision_RelatedListHandler.fetchRelated(emptyDecision.Id);
            Test.stopTest();

            System.assertEquals(0, result.size(), 'Should return empty list.');
        }
    }

    @IsTest
    static void testFetchRelated_Sorted() {
        System.runAs(relUser()) {
            TechnologyDecision__c decision = [SELECT Id FROM TechnologyDecision__c LIMIT 1];
            List<TechnologyDecision_StakeHolder__c> result;
            result = TechnologyDecision_RelatedListHandler.fetchRelated(decision.Id);

            // Verify sorted by CreatedDate DESC (most recent first)
            if (result.size() > 1) {
                System.assert(result[0].CreatedDate >= result[1].CreatedDate,
                    'Should be sorted descending by CreatedDate.');
            }
        }
    }
}
