<template>
    
    <div class={rootClass}>
        <c-placemat-nav
            rows={navRows}
            onnavselect={handleNavSelect}
            onnavtoggle={handleNavToggle}
        ></c-placemat-nav>

        <button class="nav-toggle" type="button" title={navToggleTitle} onclick={handleNavRailToggle}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                 stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"></path>
            </svg>
        </button>

        <div class="app-main">
            <!-- ══ HERO ══ -->
            <header class="hero">
                <div class="hero-top">
                    <div class="hero-brand">
                        <span class="usaa-badge">USAA</span>
                        <div class="crumb">
                            <span class="crumb-link" onclick={handleHome}>Capability Placemat</span>
                            <template lwc:if={hasCrumbTail}>
                                <span class="sep">/</span>
                                <span class="hi">{crumbTail}</span>
                            </template>
                        </div>
                    </div>

                    <div class="toggle" role="group" aria-label="Data state">
                        <button type="button" class={curBtnClass} data-mode="current" onclick={handleState}>Current</button>
                        <button type="button" class={tgtBtnClass} data-mode="target" onclick={handleState}>Target</button>
                        <button type="button" class={rygBtnClass} data-mode="ryg" onclick={handleState}>RYG</button>
                    </div>
                </div>

                <div class="hero-body">
                    <h1 class="hero-title">{heroTitle}</h1>
                    <p class="hero-desc">{heroDesc}</p>
                </div>

                <template lwc:if={showKpis}>
                    <div class="kpi-strip">
                        <template for:each={kpis} for:item="kpi">
                            <div key={kpi.id} class="kpi">
                                <div class="kpi-value">{kpi.value}</div>
                                <div class="kpi-label">{kpi.label}</div>
                            </div>
                        </template>
                    </div>
                </template>
            </header>

            <!-- ══ LEVEL 1 LANDING ══ -->
            <template lwc:if={isLevel1}>
                <main class="l1-main">
                    <div class="owners-strip">
                        <template for:each={owners} for:item="o">
                            <div key={o.id} class="owner-item">
                                <div class="owner-label">{o.label}</div>
                                <div class="owner-value">{o.value}</div>
                            </div>
                        </template>
                    </div>

                    <div class="domain-grid">
                        <template for:each={domainCards} for:item="d">
                            <button
                                key={d.key}
                                class={d.cardClass}
                                type="button"
                                data-nav-id={d.key}
                                data-nav-type="domain"
                                onclick={handleNavSelectFromCard}
                            >
                                <div class="domain-name">{d.name}</div>
                                <div class="domain-desc">{d.desc}</div>
                                <template lwc:if={d.isWip}>
                                    <span class="domain-wip">In progress</span>
                                </template>
                            </button>
                        </template>
                    </div>
                </main>
            </template>

            <!-- ══ LIVE DOMAIN ══ -->
            <template lwc:elseif={isLiveDomain}>
                <div class="legend-bar">
                    <template for:each={legendItems} for:item="l">
                        <span key={l.id} class="legend-item">
                            <span class={l.swatchClass}></span>{l.label}
                        </span>
                    </template>
                </div>

                <main class="sections">
                    <template lwc:if={isGroupFocused}>
                        <button class="group-focus-back" type="button" onclick={handleExitFocus}>
                            &larr; All capability groups
                        </button>
                    </template>

                    <template for:each={visibleGroups} for:item="g">
                        <c-placemat-group-card
                            key={g.id}
                            group={g}
                            focused={isGroupFocused}
                            ongroupfocus={handleGroupFocus}
                        ></c-placemat-group-card>
                    </template>

                    <template lwc:if={hasNoGroups}>
                        <div class="empty-state">No capability groups are published for this domain yet.</div>
                    </template>
                </main>
            </template>

            <!-- ══ WORK IN PROGRESS DOMAIN ══ -->
            <template lwc:else>
                <main class="wip-main">
                    <div class="wip-card">
                        <div class="wip-title">{heroTitle} is still being mapped</div>
                        <div class="wip-text">
                            Capability groups for this domain have not been published. Check back once the
                            architecture review completes.
                        </div>
                    </div>
                </main>
            </template>

            <footer class="placemat-footer">
                <span>Capability Placemat</span>
                <span class="footer-sep">·</span>
                <span>Architect {architect}</span>
                <span class="footer-sep">·</span>
                <span>Annual forecast {annualForecast}</span>
            </footer>
        </div>
    </div>
</template>
