    @AuraEnabled
    public static List<ASP_ApprovalEventDTO> getStandardApprovalEventsByStandardId(String standardId) {
        List<ASP_ApprovalEventDTO> approvalEventDTOs = new List<ASP_ApprovalEventDTO>();

        try {
            List<ASP_Approval_Workflow_Event__c> events = [
                SELECT
                    Id,
                    Name,
                    Event_Date__c,
                    Action__c,
                    Comments__c,
                    Performed_By__c,
                    Performed_By__r.Name,
                    Performed_By__r.Employee_ID__c,
                    Submitted_Approver__c,
                    Submitted_Approver__r.Name,
                    Submitted_Approver__r.Employee_ID__c,
                    Approver_Reassigned_From__c,
                    Approver_Reassigned_From__r.Name,
                    Approver_Reassigned_From__r.Employee_ID__c,
                    Approver_Reassigned_To__c,
                    Approver_Reassigned_To__r.Name,
                    Approver_Reassigned_To__r.Employee_ID__c
                FROM ASP_Approval_Workflow_Event__c
                WHERE Standard__c = :standardId WITH SYSTEM_MODE
                ORDER BY Event_Date__c DESC  
            ];

            //pmd fix 8-27
            Set<Id> submittedApprovalEventIds = new Set<Id>();
            for (ASP_Approval_Workflow_Event__c event : events) {
                if (event.Action__c == 'Submitted For Approval') {
                    submittedApprovalEventIds.add(event.Id);
                }
            }

            //pmd fix 8-27
            Map<Id, List<ASP_Approval_Workflow_Event_Acknowledger__c>> acknowledgersByEventId =
                new Map<Id, List<ASP_Approval_Workflow_Event_Acknowledger__c>>();
            if (!submittedApprovalEventIds.isEmpty()) {
                List<ASP_Approval_Workflow_Event_Acknowledger__c> acknowledgers = [
                    SELECT Id, Name, Workflow_Event__c, Acknowledger__r.Name, Acknowledger__r.Employee_ID__c
                    FROM ASP_Approval_Workflow_Event_Acknowledger__c
                    WHERE Workflow_Event__c IN :submittedApprovalEventIds  WITH SYSTEM_MODE
                ];

                for (ASP_Approval_Workflow_Event_Acknowledger__c ack : acknowledgers) {
                    if (!acknowledgersByEventId.containsKey(ack.Workflow_Event__c)) {
                        acknowledgersByEventId.put(
                            ack.Workflow_Event__c,
                            new List<ASP_Approval_Workflow_Event_Acknowledger__c>()
                        );
                    }
                    acknowledgersByEventId.get(ack.Workflow_Event__c).add(ack);
                }
            }

            for (ASP_Approval_Workflow_Event__c event : events) {
                List<ASP_USAAEmployeeDTO> acknowledgerDTOs = new List<ASP_USAAEmployeeDTO>();

                if (event.Action__c == 'Submitted For Approval') {
                    //pmd fix 8-27
                    List<ASP_Approval_Workflow_Event_Acknowledger__c> acknowledgers =
                        acknowledgersByEventId.get(event.Id);

                    if (acknowledgers != null && acknowledgers.size() > 0) {
                        for (ASP_Approval_Workflow_Event_Acknowledger__c ack : acknowledgers) {
                            acknowledgerDTOs.add(
                                new ASP_USAAEmployeeDTO(ack.Acknowledger__r.Name, ack.Acknowledger__r.Employee_ID__c)
                            );
                        }
                    }
                }

                approvalEventDTOs.add(
                    new ASP_ApprovalEventDTO(
                        event.Name,
                        event.Action__c,
                        event.Event_Date__c,
                        event.Comments__c,
                        event.Performed_By__c != null
                            ? new ASP_USAAEmployeeDTO(event.Performed_By__r.Name, event.Performed_By__r.Employee_ID__c)
                            : null,
                        event.Submitted_Approver__c != null
                            ? new ASP_USAAEmployeeDTO(
                                  event.Submitted_Approver__r.Name,
                                  event.Submitted_Approver__r.Employee_ID__c
                              )
                            : null,
                        event.Approver_Reassigned_From__c != null
                            ? new ASP_USAAEmployeeDTO(
                                  event.Approver_Reassigned_From__r.Name,
                                  event.Approver_Reassigned_From__r.Employee_ID__c
                              )
                            : null,
                        event.Approver_Reassigned_To__c != null
                            ? new ASP_USAAEmployeeDTO(
                                  event.Approver_Reassigned_To__r.Name,
                                  event.Approver_Reassigned_To__r.Employee_ID__c
                              )
                            : null,
                        (acknowledgerDTOs != null && acknowledgerDTOs.size() > 0) ? acknowledgerDTOs : null
                    )
                );
            }

            return approvalEventDTOs;
        } catch (Exception e) {
            throw new AuraHandledException(e.getMessage());
        }
    }

