				]
			}
		];
	}

	get portfolioHealthRows() {
		return this.visiblePortfolios.map((portfolio) => ({
			...portfolio,
			scoreCells: SCORE_DIMENSIONS.map((dimension) => {
				const score = portfolio[dimension.key];
				const previous = this.hasAssessmentData ? null : portfolio[this.previousDimensionKey(dimension.key)];
				const delta = previous === null || previous === undefined ? null : score - previous;
				return {
					key: dimension.key,
					label: dimension.label,
					score: this.formatScore(score),
					delta: delta === null || Math.abs(delta) < 0.005 ? '' : `${delta > 0 ? '▲' : '▼'}${Math.abs(delta).toFixed(2)}`,
					className: `heat-cell ${this.scoreBand(score)}`
				};
			})
		}));
	}

	get enterpriseDimensionBars() {
		const data = this.enterprise;
		return SCORE_DIMENSIONS.map((dimension) => ({
			label: dimension.label,
			value: data[dimension.key],
			prior: this.hasAssessmentData || this.isPriorCycle ? null : this.priorEnterprise[dimension.key],
			delta: this.hasAssessmentData || this.isPriorCycle ? '' : this.formatDelta(data[dimension.key] - this.priorEnterprise[dimension.key])
		}));
	}

	get priorEnterprise() {
		return { overall: 4.14, tech: 4.05, resource: 4.08, business: 4.17, compliance: 4.27 };
	}

	get portfolioGroups() {
		if (this.hasAssessmentData) {
			return [{
				label: 'Portfolios',
				portfolios: this.visiblePortfolios.map((portfolio) => ({
					...portfolio,
					riskSummary: `${portfolio.criticalHigh} Critical/High · ${portfolio.unhealthyCriticalHigh} unhealthy`,
					hasRiskSummary: true,
					dimensions: SCORE_DIMENSIONS.filter((dimension) => dimension.key !== 'overall').map((dimension) => ({
						label: dimension.label,
						value: portfolio[dimension.key]
					}))
				}))
			}];
		}

		const portfolioMap = new Map(this.visiblePortfolios.map((portfolio) => [portfolio.name, portfolio]));
		return PORTFOLIO_GROUPS.map((group) => ({
			...group,
			portfolios: group.names.map((name) => {
				const portfolio = portfolioMap.get(name);
				const risk = PORTFOLIO_RISK[name];
				return {
					...portfolio,
					riskSummary: this.isPriorCycle ? '' : `${risk.criticalHigh} Critical/High · ${risk.unhealthyCriticalHigh} unhealthy`,
					hasRiskSummary: !this.isPriorCycle,
					dimensions: SCORE_DIMENSIONS.filter((dimension) => dimension.key !== 'overall').map((dimension) => ({
						label: dimension.label,
						value: portfolio[dimension.key]
					}))
				};
			})
		}));
	}

	get decliners() {
		return PORTFOLIO_MOVERS.decliners;
	}

	get improvers() {
		return PORTFOLIO_MOVERS.improvers;
	}

	get showMovement() {
		return !this.hasAssessmentData && !this.isPriorCycle;
	}

	get visiblePortfolios() {
		if (this.hasAssessmentData) {
			return this.summarizePortfolios(this.explorerAllRows);
		}
		return PORTFOLIOS.map((portfolio) => {
			const score = this.isPriorCycle ? portfolio.prior : portfolio.overall;
			const red = this.isPriorCycle ? portfolio.priorRed : portfolio.red;
			const yellow = this.isPriorCycle ? portfolio.priorYellow : portfolio.yellow;
			const green = this.isPriorCycle ? portfolio.priorGreen : portfolio.green;
			return {
				...portfolio,
				count: this.isPriorCycle ? PRIOR_COUNTS[portfolio.name] : portfolio.count,
				overall: score,
				tech: this.isPriorCycle ? portfolio.priorTech : portfolio.tech,
				resource: this.isPriorCycle ? portfolio.priorResource : portfolio.resource,
				business: this.isPriorCycle ? portfolio.priorBusiness : portfolio.business,
				compliance: this.isPriorCycle ? portfolio.priorCompliance : portfolio.compliance,
				red, yellow, green,
				healthSegments: [
					{ label: 'Red', value: red, color: 'var(--slds-g-color-error-base-40)' },
					{ label: 'Yellow', value: yellow, color: 'var(--slds-g-color-warning-base-40)' },
					{ label: 'Green', value: green, color: 'var(--slds-g-color-success-base-40)' }
				],
				healthLabel: `${red} red, ${yellow} yellow, ${green} green applications`
			};
		});
	}

	handleCycleChange(event) {
		const nextCycle = event.detail?.value || event.target?.value || this.activeAssessmentPeriod;
		if (!nextCycle || nextCycle === this.selectedCycle) {
			return;
		}
		this.selectedCycle = nextCycle;
		this.explorerPage = 1;
		// Re-pull the dashboard, portfolio health, and explorer for the chosen period.
		this.loadAssessmentData();
	}

	explorerDistinctValues(fieldName) {
		return [...new Set(this.explorerAllRows.map((application) => application[fieldName]).filter(Boolean))].sort();
	}

	get hasActiveExplorerFilters() {
		return Boolean(this.applicationSearch || this.applicationPortfolio || this.applicationDomain || this.applicationBarr || this.applicationTime || this.applicationRag || this.applicationStatus);
	}

	loadAssessmentData() {
		const requestSequence = ++this.explorerRequestSequence;
		this.explorerLoading = true;
		this.explorerError = '';
		const requestedPeriod = this.selectedCycle || this.explorerAssessmentPeriod;
		getAssessmentData({
			filtersJson: JSON.stringify({
				searchTerm: this.applicationSearch,
				portfolio: this.applicationPortfolio,
				domain: this.applicationDomain,
				barr: this.applicationBarr,
				timeRecommendation: this.applicationTime,
				health: this.applicationRag,
				status: this.applicationStatus,
				assessmentPeriod: requestedPeriod
			})
		})
			.then((result) => {
				if (requestSequence !== this.explorerRequestSequence) return;
				const normalizedRows = this.normalizeAssessmentRows(result.records || []);
				const periodChanged = result.assessmentPeriod && result.assessmentPeriod !== this.explorerAssessmentPeriod;
				this.explorerRows = normalizedRows;
				this.explorerRecordCount = result.rowCount || normalizedRows.length;
				this.explorerAssessmentPeriod = result.assessmentPeriod || this.explorerAssessmentPeriod;
				// Sync the selector to the period Apex actually used (handles first load and fallbacks).
				this.selectedCycle = this.explorerAssessmentPeriod;
				// Refresh the dashboard/portfolio dataset on an unfiltered load, the first load,
				// or whenever the period changed — so a cycle switch repopulates every view.
				if (!this.hasActiveExplorerFilters || this.explorerAllRows.length === 0 || periodChanged) {
					this.explorerAllRows = normalizedRows;
				}
				this.explorerPage = 1;
			})
			.catch((error) => {
				if (requestSequence !== this.explorerRequestSequence) return;
				this.explorerRows = [];
				this.explorerRecordCount = 0;
				this.explorerError = error?.body?.message || error?.message || 'Unable to load assessment data from Salesforce.';
			})
			.finally(() => {
				if (requestSequence === this.explorerRequestSequence) {
					this.explorerLoading = false;
					this.hasLoadedOnce = true;
				}
			});
	}

	filterOptions(values, placeholder) {
		return [{ label: placeholder, value: '' }, ...values.map((value) => ({ label: value, value }))];
	}

	handleExplorerSearch(event) {
		this.applicationSearch = event.detail.value || '';
		this.explorerPage = 1;
		window.clearTimeout(this.explorerSearchTimer);
		this.explorerSearchTimer = window.setTimeout(() => this.loadAssessmentData(), 300);
	}

	handleTopbarSearchInput(event) {
		this.applicationSearch = event.target.value || '';
		this.explorerPage = 1;
		window.clearTimeout(this.explorerSearchTimer);
		if (!this.applicationSearch && this.currentPage !== 'applications') {
			return;
		}
		this.explorerSearchTimer = window.setTimeout(() => {
			this.currentPage = 'applications';
			this.loadAssessmentData();
		}, 300);
	}

	handleTopbarSearchKeydown(event) {
		if (event.key !== 'Enter') {
			return;
		}
		window.clearTimeout(this.explorerSearchTimer);
		if (!this.applicationSearch && this.currentPage !== 'applications') {
			return;
		}
		this.currentPage = 'applications';
		this.loadAssessmentData();
	}

	handleExplorerFilter(event) {
		const filterName = event.target.dataset.filter;
		this[`application${filterName}`] = event.detail.value;
		if (filterName === 'Portfolio') {
			this.applicationDomain = '';
		}
		this.explorerPage = 1;
		this.loadAssessmentData();
	}

	handleExplorerReset() {
		this.applicationSearch = '';
		this.applicationPortfolio = '';
		this.applicationDomain = '';
		this.applicationBarr = '';
		this.applicationTime = '';
		this.applicationRag = '';
		this.applicationStatus = '';
		this.explorerPage = 1;
		this.loadAssessmentData();
	}

	handleExplorerSort(event) {
		this.explorerSortBy = event.detail.fieldName;
		this.explorerSortDirection = event.detail.sortDirection;
	}

	handleExplorerPrevious() {
		this.explorerPage = Math.max(1, this.explorerPage - 1);
	}

	handleExplorerNext() {
		this.explorerPage = Math.min(this.explorerPageCount, this.explorerPage + 1);
	}

	previousDimensionKey(key) {
		return key === 'overall' ? 'prior' : `prior${key.charAt(0).toUpperCase()}${key.slice(1)}`;
	}

	scoreBand(score) {
		if (score === null || score === undefined || Number.isNaN(score)) {
			return 'heat-neutral';
		}
		if (score < 2.5) {
			return 'heat-red';
		}
		return score < 3.5 ? 'heat-yellow' : 'heat-green';
	}

	formatDelta(delta) {
		if (Math.abs(delta) < 0.005) {
			return '—';
		}
		return `${delta > 0 ? '▲' : '▼'}${Math.abs(delta).toFixed(2)}`;
	}

	formatScore(score) {
		return score === null || score === undefined || Number.isNaN(score) ? '—' : score.toFixed(2);
	}

	shortDelta(delta) {
		if (Math.abs(delta) < 0.005) {
			return '';
		}
		return `${delta > 0 ? '▲' : '▼'}${Math.abs(delta).toFixed(2)}`;
	}

	findSourcePortfolio(name) {
		return PORTFOLIOS.find((portfolio) => portfolio.name === name) || null;
	}

	priorValueForPortfolio(portfolio, key) {
		if (!portfolio) {
			return null;
		}
		return key === 'overall' ? portfolio.prior : portfolio[`prior${key.charAt(0).toUpperCase()}${key.slice(1)}`];
	}

	dimensionFillStyle(value) {
		const percent = value === null || value === undefined || Number.isNaN(value) ? 0 : Math.max(0, Math.min(100, (value / 5) * 100));
		return `width:${percent}%;background:${this.ragColor(value)}`;
	}

	ragColor(value) {
		if (value === null || value === undefined || Number.isNaN(value)) {
			return '#B9B6AC';
		}
		if (value < 2.5) {
			return '#960000';
		}
		return value < 3.5 ? '#8C7F4F' : '#6A815E';
	}

	heatColor(value) {
		if (value === null || value === undefined || Number.isNaN(value)) {
			return '#D6D4CC';
		}
		if (value < 2.5) {
			const t = Math.max(0, (value - 1) / 1.5);
			return this.mixColor('#6B0000', '#B70000', t);
		}
		if (value < 3.5) {
			const t = (value - 2.5) / 1.0;
			return this.mixColor('#7A6E44', '#A8996A', t);
		}
		const t = Math.min(1, (value - 3.5) / 1.5);
		return this.mixColor('#8CA37F', '#4E6344', t);
	}

	mixColor(from, to, ratio) {
		const start = [parseInt(from.slice(1, 3), 16), parseInt(from.slice(3, 5), 16), parseInt(from.slice(5, 7), 16)];
		const finish = [parseInt(to.slice(1, 3), 16), parseInt(to.slice(3, 5), 16), parseInt(to.slice(5, 7), 16)];
		const mixed = start.map((value, index) => Math.round(value + (finish[index] - value) * ratio));
		return `rgb(${mixed[0]},${mixed[1]},${mixed[2]})`;
	}

	buildStackSegments(segments) {
		const total = segments.reduce((sum, segment) => sum + (Number(segment.value) || 0), 0);
		return segments.map((segment) => {
			const rawValue = Number(segment.value) || 0;
			const width = total ? (rawValue / total) * 100 : 0;
			return {
				...segment,
				style: `width:${width}%;background:${segment.color}`
			};
		});
	}

	summarizeDomains(rows) {
		const grouped = new Map();
		rows.forEach((row) => {
			const name = row.domain || 'Unassigned';
			if (!grouped.has(name)) {
				grouped.set(name, []);
			}
			grouped.get(name).push(row);
		});
		return [...grouped.entries()].map(([name, domainRows]) => {
			const summary = this.summarizeRows(domainRows);
			const criticalHigh = this.countByCanonicalValues(domainRows, 'barr', ['Critical', 'High']);
			const unhealthyCriticalHigh = domainRows.filter((row) => this.healthBand(row) === 'red' && ['Critical', 'High'].includes(this.canonicalizeValue(row.barr, ['Critical', 'High']))).length;
			return {
				name,
				count: summary.count,
				overall: summary.overall,
				tech: summary.tech,
				resource: summary.resource,
				business: summary.business,
				compliance: summary.compliance,
				red: summary.red,
				yellow: summary.yellow,
				green: summary.green,
				criticalHigh,
				unhealthyCriticalHigh,
				dimensionRows: SCORE_DIMENSIONS.filter((dimension) => dimension.key !== 'overall').map((dimension) => ({
					label: dimension.label,
					value: this.formatScore(summary[dimension.key]),
					fillStyle: this.dimensionFillStyle(summary[dimension.key])
				})),
				healthSegments: this.buildStackSegments([
					{ label: 'Red', value: summary.red, color: '#960000' },
					{ label: 'Yellow', value: summary.yellow, color: '#8C7F4F' },
					{ label: 'Green', value: summary.green, color: '#6A815E' }
				])
			};
		}).sort((left, right) => right.count - left.count);
	}

	safePercent(part, total) {
		return total ? ((part / total) * 100).toFixed(0) : '0';
	}
	rowsSupportPortfolioMetrics(rows) {
		return rows.some(
			(row) => Boolean(row.portfolio) && typeof row.overall === 'number' && !Number.isNaN(row.overall)
		);
	}

	handleNavigate(event) {
		this.currentPage = event.detail?.name || event.currentTarget?.dataset?.page || 'dashboard';
		if (this.currentPage !== 'portfolios') {
			this.selectedPortfolioName = '';
			this.selectedPortfolioTab = 'summary';
		}
		if (!this.explorerAllRows.length && !this.explorerLoading) {
			this.loadAssessmentData();
		}
	}

	handlePortfolioOpen(event) {
		this.selectedPortfolioName = event.currentTarget.dataset.portfolio || '';
		this.selectedPortfolioTab = 'summary';
	}

	handlePortfolioBack() {
		this.selectedPortfolioName = '';
		this.selectedPortfolioTab = 'summary';
	}

	handlePortfolioTab(event) {
		this.selectedPortfolioTab = event.currentTarget.dataset.tab || 'summary';
	}

	normalizeAssessmentRows(records) {
		return records.map((record) => this.normalizeAssessmentRecord(record));
	}

	normalizeAssessmentRecord(record) {
		return {
			...record,
			name: record.name || '',
			portfolio: record.portfolio || 'Unassigned',
			domain: record.domain || '',
			category: record.category || '',
			barr: record.barr || '',
			time: record.time || '',
			status: record.status || '',
			rag: record.rag || '',
			architect: record.architect || '',
			owner: record.owner || '',
			overall: this.numberValue(record.overall),
			tech: this.numberValue(record.tech),
			resource: this.numberValue(record.resource),
			business: this.numberValue(record.business),
			compliance: this.numberValue(record.compliance),
			delta: 0
		};
	}

	numberValue(value) {
		if (value === null || value === undefined || value === '') {
			return null;
		}
		const parsed = Number(value);
		return Number.isFinite(parsed) ? parsed : null;
	}

	summarizeRows(rows) {
		if (!rows.length) {
			return { count: 0, overall: 0, tech: 0, resource: 0, business: 0, compliance: 0, red: 0, yellow: 0, green: 0 };
		}
		const healthCounts = this.countHealth(rows);
		return {
			count: rows.length,
			overall: this.averageForField(rows, 'overall'),
			tech: this.averageForField(rows, 'tech'),
			resource: this.averageForField(rows, 'resource'),
			business: this.averageForField(rows, 'business'),
			compliance: this.averageForField(rows, 'compliance'),
			red: healthCounts.red,
			yellow: healthCounts.yellow,
			green: healthCounts.green
		};
	}

	averageForField(rows, fieldName) {
		const values = rows.map((row) => row[fieldName]).filter((value) => typeof value === 'number' && !Number.isNaN(value));
		if (!values.length) {
			return 0;
		}
		return values.reduce((sum, value) => sum + value, 0) / values.length;
	}

	countHealth(rows) {
		return rows.reduce((counts, row) => {
			counts[this.healthBand(row)] += 1;
			return counts;
		}, { red: 0, yellow: 0, green: 0 });
	}

	healthBand(row) {
		const rag = String(row.rag || '').trim().toLowerCase();
		if (rag === 'red') {
			return 'red';
		}
		if (rag === 'yellow') {
			return 'yellow';
		}
		if (rag === 'green') {
			return 'green';
		}
		if (typeof row.overall === 'number') {
			return row.overall < 2.5 ? 'red' : row.overall < 3.5 ? 'yellow' : 'green';
		}
		return 'green';
	}

	countByCanonicalValues(rows, fieldName, canonicalValues) {
		return rows.reduce((count, row) => count + (canonicalValues.includes(this.canonicalizeValue(row[fieldName], canonicalValues)) ? 1 : 0), 0);
	}

	canonicalizeValue(value, candidates) {
		const raw = String(value || '').trim();
		const match = candidates.find((candidate) => candidate.toLowerCase() === raw.toLowerCase());
		return match || raw;
	}

	summarizePortfolios(rows) {
		const grouped = new Map();
		rows.forEach((row) => {
			const name = row.portfolio || 'Unassigned';
			if (!grouped.has(name)) {
				grouped.set(name, []);
			}
			grouped.get(name).push(row);
		});
		return [...grouped.entries()].map(([name, portfolioRows]) => {
			const summary = this.summarizeRows(portfolioRows);
			const criticalHigh = this.countByCanonicalValues(portfolioRows, 'barr', ['Critical', 'High']);
			const unhealthyCriticalHigh = portfolioRows.filter((row) => this.healthBand(row) === 'red' && ['Critical', 'High'].includes(this.canonicalizeValue(row.barr, ['Critical', 'High']))).length;
			return {
				name,
				count: summary.count,
				overall: summary.overall,
				tech: summary.tech,
				resource: summary.resource,
				business: summary.business,
				compliance: summary.compliance,
				red: summary.red,
				yellow: summary.yellow,
				green: summary.green,
				criticalHigh,
				unhealthyCriticalHigh,
				healthSegments: [
					{ label: 'Red', value: summary.red, color: 'var(--slds-g-color-error-base-40)' },
					{ label: 'Yellow', value: summary.yellow, color: 'var(--slds-g-color-warning-base-40)' },
					{ label: 'Green', value: summary.green, color: 'var(--slds-g-color-success-base-40)' }
				],
				healthLabel: `${summary.red} red, ${summary.yellow} yellow, ${summary.green} green applications`
			};
		}).sort((left, right) => left.name.localeCompare(right.name));
	}
}


