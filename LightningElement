// NEW: Convert "Q4 2024" to "Q42024".
// Also supports names such as "Spring Q1 2015".
@TestVisible
private static String cycleCodeForPeriodName(String name) {
    if (String.isBlank(name)) {
        return null;
    }

    String value = name.trim().toUpperCase();

    if (Pattern.matches('^Q[1-4](19|20)[0-9]{2}$', value)) {
        return value;
    }

    Matcher m = Pattern.compile(
        'Q([1-4])\\s+((?:19|20)[0-9]{2})'
    ).matcher(value);

    if (m.find()) {
        return 'Q' + m.group(1) + m.group(2);
    }

    return null;
}
