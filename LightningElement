<template>
    <!-- Class -->
    <c-asp-class-filter
        value={filters.classes}
        default-value={classFilterDefaultValue}
        onchange={handleClassFilterChange}
        class="slds-m-horizontal_medium"
    ></c-asp-class-filter>

    <!-- Filter accordion sections -->
    <div class="slds-border_top">
        <lightning-accordion allow-multiple-sections-open active-section-name={activeFilterSections}>
            <lightning-accordion-section data-id="status-filter-section" label="Status" name="status">
                <lightning-button
                    lwc:if={hasStatusFilterApplied}
                    slot="actions"
                    variant="base"
                    label="clear"
                    onclick={handleStatusClearClick}
                    class="clear-button"
                ></lightning-button>
                <lightning-checkbox-group
                    data-id="status-filter-checkbox-group"
                    name="Status"
                    options={statusOptions}
                    value={filters.statuses}
                    onchange={handleStatusChange}
                    variant="label-hidden"
                    class="slds-m-bottom_x-small"
                ></lightning-checkbox-group>
            </lightning-accordion-section>
            <lightning-accordion-section
                data-id="owner-filter-section"
                label="Owner"
                name="owner"
                class="slds-border_bottom"
            >
                <lightning-button
                    lwc:if={hasOwnerFilterApplied}
                    slot="actions"
                    variant="base"
                    label="clear"
                    onclick={handleOwnerClearClick}
                    class="clear-button"
                ></lightning-button>
                <lightning-checkbox-group
                    data-id="owner-filter-checkbox-group"
                    name="Owner"
                    options={ownerOptions}
                    value={filters.owners}
                    onchange={handleOwnerChange}
                    variant="label-hidden"
                    class="slds-m-bottom_x-small"
                ></lightning-checkbox-group>
            </lightning-accordion-section>

            <template lwc:if={showArchAppAndTechFilters}>
                <h4 class="slds-text-title_caps filter-section-header">Class Specific Filters</h4>
                <h5 class="filter-section-sub-header">Architecture</h5>
                <h6 class="filter-section-sub-sub-header">Application &amp; Technology</h6>
                <lightning-accordion-section data-id="portfolio-filter-section" label="Portfolio" name="portfolio">
                    <lightning-button
                        lwc:if={hasPortfolioFilterApplied}
                        slot="actions"
                        variant="base"
                        label="clear"
                        onclick={handlePortfolioClearClick}
                        class="clear-button"
                    ></lightning-button>
                    <lightning-checkbox-group
                        data-id="portfolio-filter-checkbox-group"
                        name="Portfolio"
                        options={portfolioOptions}
                        value={filters.portfolios}
                        onchange={handlePortfolioChange}
                        variant="label-hidden"
                        class="slds-m-bottom_x-small"
                    ></lightning-checkbox-group>
                </lightning-accordion-section>
                <lightning-accordion-section data-id="domain-filter-section" label="Domain" name="domain">
                    <lightning-button
                        lwc:if={hasDomainFilterApplied}
                        slot="actions"
                        variant="base"
                        label="clear"
                        onclick={handleDomainClearClick}
                        class="clear-button"
                    ></lightning-button>
                    <template iterator:it={domainOptionsByPortfolio}>
                        <div key={it.value.id}>
                            <template lwc:if={it.first}></template>
                            <div lwc:else class="slds-m-top_x-small"></div>
                            <lightning-checkbox-group
                                data-portfolio-group-id={it.value.id}
                                label={it.value.name}
                                name={it.value.id}
                                options={it.value.options}
                                value={it.value.value}
                                onchange={handleDomainChange}
                                class="slds-m-bottom_x-small"
                            ></lightning-checkbox-group>
                        </div>
                    </template>
                </lightning-accordion-section>
                <lightning-accordion-section
                    data-id="stack-layer-filter-section"
                    label="Stack Layer"
                    name="stackLayer"
                    class="slds-border_bottom"
                >
                    <lightning-button
                        lwc:if={hasStackLayerFilterApplied}
                        slot="actions"
                        variant="base"
                        label="clear"
                        onclick={handleStackLayerClearClick}
                        class="clear-button"
                    ></lightning-button>
                    <template iterator:it={layerOptionsByStack}>
                        <div key={it.value.id}>
                            <template lwc:if={it.first}></template>
                            <div lwc:else class="slds-m-top_x-small"></div>
                            <lightning-checkbox-group
                                data-stack-group-id={it.value.id}
                                label={it.value.name}
                                name={it.value.id}
                                options={it.value.options}
                                value={it.value.value}
                                onchange={handleStackLayerChange}
                                class="slds-m-bottom_x-small"
                            ></lightning-checkbox-group>
                        </div>
                    </template>
                </lightning-accordion-section>
            </template>
        </lightning-accordion>
    </div>
</template>
