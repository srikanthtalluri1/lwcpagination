import { LightningElement, track } from 'lwc';
import {
    DOMAINS,
    L1_META,
    buildGroups,
    buildNavRows,
    computeDomainStats
} from 'c/placematData';


export default class CapabilityPlacemat extends LightningElement {
    @track currentDomain = null;
    @track currentGroup = null;
    @track dataState = 'current';
    @track navCollapsed = false;
    @track expandedKeys = [];
    @track activeLeafId = null;

    /* ── root wrapper class: replaces body[data-state] ── */
    get rootClass() {
        let c = 'placemat-root state-' + this.dataState;
        if (this.navCollapsed) c += ' nav-collapsed';
        return c;
    }

    /* ── hero ── */
    get domainRecord() {
        return this.currentDomain ? DOMAINS.find((d) => d.key === this.currentDomain) : null;
    }

    get isLevel1() {
        return !this.currentDomain;
    }

    get isLiveDomain() {
        const d = this.domainRecord;
        return !!d && d.status === 'live';
    }

    get heroTitle() {
        return this.domainRecord ? this.domainRecord.name : 'Member Communications';
    }

    get heroDesc() {
        return this.domainRecord ? this.domainRecord.desc : L1_META.desc;
    }

    get hasCrumbTail() {
        return !!this.domainRecord;
    }

    get crumbTail() {
        if (!this.domainRecord) return '';
        return this.currentGroup
            ? this.domainRecord.name + ' / Group ' + this.currentGroup
            : this.domainRecord.name;
    }

    get architect() {
        return L1_META.architect;
    }

    get annualForecast() {
        return L1_META.annualForecast;
    }

    get owners() {
        return [
            { id: 'o1', label: 'Business Owner', value: L1_META.owner },
            { id: 'o2', label: 'Delivery Owner', value: L1_META.deliveryOwner },
            { id: 'o3', label: 'Architect', value: L1_META.architect },
            { id: 'o4', label: 'Annual Forecast', value: L1_META.annualForecast }
        ];
    }

    /* ── KPI strip ── */
    get showKpis() {
        return this.isLiveDomain;
    }

    get kpis() {
        return this.currentDomain ? computeDomainStats(this.currentDomain) : [];
    }

    /* ── state toggle button classes (precomputed, not expressions) ── */
    get curBtnClass() {
        return this.dataState === 'current' ? 'active' : '';
    }
    get tgtBtnClass() {
        return this.dataState === 'target' ? 'active' : '';
    }
    get rygBtnClass() {
        return this.dataState === 'ryg' ? 'active' : '';
    }

    /* ── level 1 domain cards ── */
    get domainCards() {
        return DOMAINS.map((d) => ({
            ...d,
            isWip: d.status !== 'live',
            cardClass: d.status === 'live' ? 'domain-card' : 'domain-card is-wip'
        }));
    }

    /* ── groups ── */
    get allGroups() {
        return this.currentDomain ? buildGroups(this.currentDomain) : [];
    }

    get isGroupFocused() {
        return !!this.currentGroup;
    }

    get visibleGroups() {
        const groups = this.allGroups;
        if (!this.currentGroup) return groups;
        const one = groups.find((g) => g.num === this.currentGroup);
        return one ? [one] : groups;
    }

    get hasNoGroups() {
        return this.allGroups.length === 0;
    }

    /* ── legend ── */
    get legendItems() {
        if (this.dataState === 'ryg') {
            return [
                { id: 'r', label: 'Not in target', swatchClass: 'swatch sw-red' },
                { id: 'y', label: 'Constrained', swatchClass: 'swatch sw-yellow' },
                { id: 'g', label: 'Target', swatchClass: 'swatch sw-green' },
                { id: 'b', label: 'Under consideration', swatchClass: 'swatch sw-blue' }
            ];
        }
        return [
            { id: 'n', label: 'New in target', swatchClass: 'swatch sw-new' },
            { id: 'rt', label: 'Retiring', swatchClass: 'swatch sw-ret' },
            { id: 'c', label: 'Constrained', swatchClass: 'swatch sw-con' },
            { id: 'u', label: 'Under consideration', swatchClass: 'swatch sw-under' }
        ];
    }

    /* ── nav ── */
    get navRows() {
        return buildNavRows(this.expandedKeys, this.activeLeafId, this.currentDomain);
    }

    get navToggleTitle() {
        return this.navCollapsed ? 'Expand navigation' : 'Collapse navigation';
    }

    /* ════════ HANDLERS ════════ */

    handleHome() {
        this.currentDomain = null;
        this.currentGroup = null;
        this.activeLeafId = null;
    }

    handleState(event) {
        this.dataState = event.currentTarget.dataset.mode;
    }

    handleNavRailToggle() {
        this.navCollapsed = !this.navCollapsed;
        /*
         * localStorage works under Lightning Web Security, but it is namespaced
         * per site and unavailable to some guest-user configurations, so it is
         * wrapped and failure is silently ignored.
         */
        try {
            window.localStorage.setItem('placematNavCollapsed', this.navCollapsed ? '1' : '0');
        } catch (e) {
            /* preference simply not persisted */
        }
    }

    handleNavToggle(event) {
        const key = event.detail.navId;
        const i = this.expandedKeys.indexOf(key);
        this.expandedKeys =
            i === -1
                ? [...this.expandedKeys, key]
                : this.expandedKeys.filter((k) => k !== key);
    }

    handleNavSelect(event) {
        this.applyNav(event.detail.navId, event.detail.navType);
    }

    handleNavSelectFromCard(event) {
        const { navId, navType } = event.currentTarget.dataset;
        this.applyNav(navId, navType);
    }

    applyNav(navId, navType) {
        if (navType === 'domain') {
            this.currentDomain = navId;
            this.currentGroup = null;
            this.activeLeafId = null;
            if (!this.expandedKeys.includes(navId)) {
                this.expandedKeys = [...this.expandedKeys, navId];
            }
            return;
        }

        const [domainKey, num] = navId.split('::');
        this.currentDomain = domainKey;

        if (navType === 'group') {
            this.currentGroup = num;
            this.activeLeafId = null;
        } else {
            this.currentGroup = null;
            this.activeLeafId = navId;
            this.scrollToCapability(num);
        }
    }

    handleGroupFocus(event) {
        const num = event.detail.groupNum;
        this.currentGroup = this.currentGroup === num ? null : num;
    }

    handleExitFocus() {
        this.currentGroup = null;
    }

    /**
     * document.getElementById() cannot see into shadow DOM.
     * this.template.querySelector() is the equivalent, and it must run after
     * the re-render, hence the rAF.
     */
    scrollToCapability(num) {
        window.requestAnimationFrame(() => {
            const el = this.template.querySelector(`[data-cap-num="${num}"]`);
            if (el && el.scrollIntoView) {
                el.scrollIntoView({ block: 'center', behavior: 'smooth' });
            }
        });
    }

    connectedCallback() {
        try {
            this.navCollapsed = window.localStorage.getItem('placematNavCollapsed') === '1';
        } catch (e) {
            this.navCollapsed = false;
        }
    }
}
