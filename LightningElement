.paam-app-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.paam-app-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    padding: 0;
    flex-shrink: 0;
    border: 1px solid #b8c8d6;
    border-radius: 50%;
    background: #f7fafc;
    cursor: pointer;
}

.paam-app-info:hover {
    background: #eaf2f8;
    border-color: var(--paam-primary);
}

.paam-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 12000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(2, 17, 28, 0.45);
}

.paam-modal {
    width: min(650px, 100%);
    max-height: 85vh;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--paam-border);
    border-radius: 14px;
    box-shadow:
        0 24px 60px -28px
        rgba(2, 23, 45, 0.5);
}

.paam-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--paam-border);
}

.paam-modal__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
}

.paam-modal__subtitle {
    margin: 0.25rem 0 0;
    color: var(--paam-muted);
    font-size: 0.82rem;
}

.paam-modal__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
}

.paam-modal__close:hover {
    background: #eef2f6;
}

.paam-modal__body {
    max-height: 65vh;
    overflow: auto;
    padding: 1rem 1.2rem;
}

.paam-modal__grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.9rem 1rem;
    margin: 0;
}

.paam-modal__item {
    padding: 0.65rem 0.75rem;
    border: 1px solid #e5ecf2;
    border-radius: 10px;
    background: #fafcfe;
}

.paam-modal__item dt {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--paam-muted);
    text-transform: uppercase;
}

.paam-modal__item dd {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
}

.paam-modal__footer {
    display: flex;
    justify-content: flex-end;
    padding: 0.9rem 1.2rem 1rem;
    border-top: 1px solid var(--paam-border);
}
