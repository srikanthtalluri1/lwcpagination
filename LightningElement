import { LightningElement } from 'lwc';
import getAssessmentData from '@salesforce/apex/TpmArchitectureHubController.getAssessmentData';
import getAvailableCycles from '@salesforce/apex/TpmArchitectureHubController.getAvailableCycles';

const NAVIGATION = [
	{ label: 'Overview', items: [{ label: 'Enterprise Dashboard', page: 'dashboard' }] },
	{ label: 'Assess', items: [
		{ label: 'Portfolio Health', page: 'portfolios' },
		{ label: 'Application Explorer', page: 'applications' }
	] }

];

const PAGE_TITLES = {
	dashboard: 'Enterprise Dashboard', portfolios: 'Portfolio Health', taxonomy: 'Taxonomy Browser',
	applications: 'Application Explorer', risk: 'Risk & Compliance', methodology: 'AMA Methodology',
	governance: 'Governance Model', decisions: 'Technology Decisions', standards: 'Standards Catalog',
	waivers: 'Waivers & Exceptions', capabilities: 'Capability Portfolio', capabilityHealth: 'Capability Health',
	healthMethod: 'Health Method', strategy: 'Strategy & Direction', initiatives: 'Initiatives & Roadmaps',
	publications: 'Publications', reference: 'Reference', sitemap: 'Site Map'
};

const PORTFOLIO_DETAIL_TABS = [
	{ value: 'summary', label: 'Summary' },
	{ value: 'health', label: 'Health Assessments' },
	{ value: 'unhealthy', label: 'Unhealthy Apps' },
	{ value: 'domains', label: 'Domains & Categories' }
];

// Business-approved original portfolio grouping. Names are classification only;
// all portfolio counts, ratings and charts are sourced from Apex assessment rows.
// A group is displayed only when Salesforce returns a matching portfolio.
const PORTFOLIO_GROUPS = [
    { label: 'Companies', names: ['Banking', 'P&C Insurance', 'Life Company', 'Investments'] },
    { label: 'Enterprise', names: ['Contact Center', 'Enterprise Applications & Services', 'Member Digital Platforms', 'Marketing'] },
    { label: 'Employee', names: ['Digital Workplace', 'Corporate', 'Chief Financial Office'] },
    { label: 'Infrastructure', names: ['Operations Infrastructure', 'Application Infrastructure', 'Data & Analytics Infrastructure', 'Enterprise Security'] }
];

const SCORE_DIMENSIONS = [
	{ key: 'overall', label: 'Overall Rating' },
	{ key: 'tech', label: 'Technology' },
	{ key: 'resource', label: 'Resource' },
	{ key: 'business', label: 'Business Value' },
	{ key: 'compliance', label: 'Compliance' }
];

const NUMBER_FORMAT = new Intl.NumberFormat('en-US');
const PORTFOLIO_COLUMNS = [
	{ label: 'Portfolio', fieldName: 'name', type: 'text', initialWidth: 250 },
	{ label: 'Applications', fieldName: 'count', type: 'number', typeAttributes: { maximumFractionDigits: 0 } },
	{ label: 'Overall', fieldName: 'overall', type: 'number', typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Tech', fieldName: 'tech', type: 'number', typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Resource', fieldName: 'resource', type: 'number', typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Business', fieldName: 'business', type: 'number', typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Compliance', fieldName: 'compliance', type: 'number', typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Red', fieldName: 'red', type: 'number', typeAttributes: { maximumFractionDigits: 0 } },
	{ label: 'Yellow', fieldName: 'yellow', type: 'number', typeAttributes: { maximumFractionDigits: 0 } },
	{ label: 'Green', fieldName: 'green', type: 'number', typeAttributes: { maximumFractionDigits: 0 } }
];

const EXPLORER_COLUMNS = [
	{ label: 'Application', fieldName: 'name', type: 'text', sortable: true, wrapText: true },
	{ label: 'Portfolio', fieldName: 'portfolio', type: 'text', sortable: true, wrapText: true },
	{ label: 'Domain', fieldName: 'domain', type: 'text', sortable: true, wrapText: true },
	{ label: 'BARR', fieldName: 'barr', type: 'text', sortable: true },
	{ label: 'TIME', fieldName: 'time', type: 'text', sortable: true },
	{ label: 'Overall', fieldName: 'overall', type: 'number', sortable: true, typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Tech', fieldName: 'tech', type: 'number', sortable: true, typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Rsrc', fieldName: 'resource', type: 'number', sortable: true, typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Biz', fieldName: 'business', type: 'number', sortable: true, typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'Cmpl', fieldName: 'compliance', type: 'number', sortable: true, typeAttributes: { minimumFractionDigits: 2, maximumFractionDigits: 2 } },
	{ label: 'IT Architect', fieldName: 'architect', type: 'text', sortable: true, wrapText: true }
];


export default class TpmArchitectureHub extends LightningElement {
	// Added: cycles are supplied by Salesforce and ordered newest-first in Apex.
	availableCycles = [];
	cyclePeriods = [];
	selectedCycle = '';
	cyclesLoading = false;
	currentPage = 'dashboard';
	selectedPortfolioName = '';
	selectedPortfolioTab = 'summary';
	applicationSearch = '';
	applicationPortfolio = '';
	applicationDomain = '';
	applicationBarr = '';
	applicationTime = '';
	applicationRag = '';
	applicationStatus = '';
	explorerPage = 1;
	explorerPageSize = 10;
	explorerSortBy = 'overall';
	explorerSortDirection = 'desc';
	explorerRows = [];
	explorerAllRows = [];
	explorerRecordCount = 0;
	explorerLoading = false;
	// True once the first Apex response has come back.
	hasLoadedOnce = false;
	explorerError = '';
	explorerAssessmentPeriod = '';
	explorerSearchTimer;
	explorerRequestSequence = 0;

	connectedCallback() {
		// Load the newest *available* cycle before making the assessment query.
		this.loadAvailableCycles();
	}

	loadAvailableCycles() {
		this.cyclesLoading = true;
		this.explorerLoading = true;
		this.explorerError = '';
		getAvailableCycles()
			.then((cycles) => {
				if (!Array.isArray(cycles) || !cycles.length) {
					throw new Error('No valid Salesforce assessment cycles were found.');
				}
				this.availableCycles = cycles.map((cycle) => ({
					period: cycle.period,
					count: Number(cycle.count) || 0
				}));
				this.cyclePeriods = this.availableCycles.map((cycle) => cycle.period);
				this.selectedCycle = this.availableCycles[0].period;
				this.explorerAssessmentPeriod = this.selectedCycle;
				this.loadAssessmentData();
			})
			.catch((error) => {
				this.availableCycles = [];
				this.cyclePeriods = [];
				this.explorerAllRows = [];
				this.explorerRows = [];
				this.explorerError = error?.body?.message || error?.message || 'Unable to load assessment cycles from Salesforce.';
				this.explorerLoading = false;
				this.hasLoadedOnce = true;
			})
			.finally(() => {
				this.cyclesLoading = false;
			});
	}

	get isDashboard() {
		return this.currentPage === 'dashboard';
	}

	get isPortfolioHealth() {
		return this.currentPage === 'portfolios';
	}

	get isApplicationExplorer() {
		return this.currentPage === 'applications';
	}

	// Mask stale results while a new assessment period loads.
	get showInitialSpinner() {
		return this.explorerLoading;
	}

	// Dashboard data blocks render only after the first load has returned real rows.
	get showDashboardData() {
		return this.isDashboard && this.hasLoadedOnce && !this.explorerLoading && !this.hasExplorerError && this.hasAssessmentData;
	}

	// Portfolio Health data blocks render only after the first load has returned real rows.
	get showPortfolioData() {
		return this.isPortfolioHealth && this.hasLoadedOnce && !this.explorerLoading && !this.hasExplorerError && this.hasAssessmentData;
	}

	get pageTitle() {
		return PAGE_TITLES[this.currentPage] || PAGE_TITLES.dashboard;
	}

	get dashboardStatusLine() {
		return `Cycle ${this.activeAssessmentPeriod}. ${NUMBER_FORMAT.format(this.enterprise.count)} assessed applications in scope.`;
	}

	get hasAssessmentData() {
		return this.explorerAllRows.length > 0;
	}

	get activeAssessmentPeriod() {
		// The period Apex actually queried is the source of truth; selectedCycle is the user's pending pick.
		return this.selectedCycle || this.explorerAssessmentPeriod;
	}

	get cycleOptions() {
		// Salesforce cycles only. Show record counts to explain partial newest cycles.
		return this.availableCycles.map((cycle) => ({
			label: `${cycle.period} (${NUMBER_FORMAT.format(cycle.count)} records)`,
			value: cycle.period
		}));
	}

	get navigation() {
		return NAVIGATION.map((group, groupIndex) => ({
			...group,
			key: group.label || `group-${groupIndex}`,
			items: group.items.map((item) => ({
				...item,
				navLabel: `${item.label}${item.badge ? ` (${item.badge})` : ''}${item.soon ? ' (Soon)' : ''}`,
				navClass: item.page === this.currentPage ? 'nav-link active' : 'nav-link'
			}))
		}));
	}

	get enterprise() {
		return this.summarizeRows(this.explorerAllRows);
	}

	get hasEnterpriseHealth() {
		const d = this.enterprise;
		return d.red + d.yellow + d.green > 0;
	}

	get hasEnterpriseDimensions() {
		return this.dimensionScores.length > 0;
	}

	get hasCompositionCharts() {
		return this.compositionChartsForView.length > 0;
	}

	get hasPortfolioRatings() {
		return this.visiblePortfolios.some((portfolio) => typeof portfolio.overall === 'number');
	}

	get showPageLoadError() {
		return !this.isApplicationExplorer && this.hasExplorerError && !this.explorerLoading;
	}

	get showEmptyAssessmentNotice() {
		return !this.isApplicationExplorer && this.hasLoadedOnce && !this.explorerLoading &&
			!this.hasExplorerError && !this.hasAssessmentData;
	}

	get kpis() {
		const d = this.enterprise;
		if (!d.count) return [];
		const items = [{ label: 'Assessed Applications', value: NUMBER_FORMAT.format(d.count), detail: 'records in scope', className: 'kpi-card accent-blue' }];
		if (this.hasEnterpriseHealth) {
			items.push(
				{ label: 'Red - Unhealthy', value: NUMBER_FORMAT.format(d.red), detail: 'rated red', className: 'kpi-card accent-red' },
				{ label: 'Yellow - At Risk', value: NUMBER_FORMAT.format(d.yellow), detail: 'rated yellow', className: 'kpi-card accent-gold' },
				{ label: 'Green - Healthy', value: NUMBER_FORMAT.format(d.green), detail: 'rated green', className: 'kpi-card accent-green' }
			);
		}
		if (typeof d.overall === 'number') {
			items.push({ label: 'Enterprise Overall', value: d.overall.toFixed(2), detail: 'mean of available ratings', className: 'kpi-card accent-navy' });
		}
		return items;
	}

	get sectionCards() {
		if (!this.hasAssessmentData) return [];
		const d = this.enterprise;
		const applications = this.explorerAllRows;
		const cards = [];
		if (typeof d.overall === 'number' || this.hasEnterpriseHealth) {
			cards.push({
				title: 'Assess', kicker: 'Portfolio Health', page: 'portfolios',
				value: typeof d.overall === 'number' ? this.formatScore(d.overall) : '',
				hasValue: typeof d.overall === 'number', detail: 'enterprise overall',
				showMix: this.hasEnterpriseHealth,
				redCount: d.red, yellowCount: d.yellow, greenCount: d.green,
				healthLabel: `${d.red} red, ${d.yellow} yellow, ${d.green} green applications`,
				segments: this.enterpriseHealthSegments,
				footnote: `${d.count} assessment records across ${this.visiblePortfolios.length} named portfolios`
			});
		}
		cards.push({ title: 'Applications', kicker: 'Explorer', page: 'applications', value: NUMBER_FORMAT.format(d.count), hasValue: true, detail: 'records loaded', footnote: `Assessment period ${this.activeAssessmentPeriod}` });
		const domains = this.explorerDistinctValues('domain');
		if (domains.length) cards.push({ title: 'Domains', kicker: 'Coverage', page: 'applications', value: NUMBER_FORMAT.format(domains.length), hasValue: true, detail: 'distinct domains' });
		if (applications.some((r) => Boolean(r.barr))) {
			cards.push({ title: 'BARR', kicker: 'Risk', page: 'applications', value: NUMBER_FORMAT.format(this.countByCanonicalValues(applications, 'barr', ['Critical', 'High'])), hasValue: true, detail: 'critical + high' });
		}
		if (applications.some((r) => Boolean(r.time))) {
			cards.push({ title: 'TIME', kicker: 'Action', page: 'applications', value: NUMBER_FORMAT.format(this.countByCanonicalValues(applications, 'time', ['Migrate', 'Eliminate'])), hasValue: true, detail: 'migrate + eliminate' });
		}
		return cards;
	}

	get portfolioColumns() {
		return PORTFOLIO_COLUMNS;
	}

	get explorerColumns() {
		return EXPLORER_COLUMNS;
	}

	get portfolioOptions() {
		const names = this.visiblePortfolios.map((p) => p.name);
		return [{ label: 'All portfolios', value: '' }, ...names.map((name) => ({ label: name, value: name }))];
	}

	get domainOptions() {
		const domains = [...new Set(this.explorerAllRows
			.filter((application) => !this.applicationPortfolio || application.portfolio === this.applicationPortfolio)
			.map((application) => application.domain).filter(Boolean))].sort();
		return [{ label: 'All domains', value: '' }, ...domains.map((domain) => ({ label: domain, value: domain }))];
	}

	get barrOptions() {
		const values = this.explorerDistinctValues('barr');
		return this.filterOptions(values, 'All BARR ratings');
	}

	get timeOptions() {
		const values = this.explorerDistinctValues('time');
		return this.filterOptions(values, 'All TIME recommendations');
	}

	get ragOptions() {
		const values = this.explorerDistinctValues('rag');
		return this.filterOptions(values, 'All health ratings');
	}

	get statusOptions() {
		return this.filterOptions(this.explorerDistinctValues('status'), 'All statuses');
	}

	get filteredApplications() {
		const rows = [...this.explorerRows];
		const direction = this.explorerSortDirection === 'asc' ? 1 : -1;
		return rows.sort((left, right) => {
			const a = left[this.explorerSortBy];
			const b = right[this.explorerSortBy];
			return typeof a === 'number' && typeof b === 'number'
				? (a - b) * direction
				: String(a ?? '').localeCompare(String(b ?? '')) * direction;
		});
	}

	get explorerPageRows() {
		const start = (this.explorerPage - 1) * this.explorerPageSize;
		return this.filteredApplications.slice(start, start + this.explorerPageSize);
	}

	get explorerPageCount() {
		return Math.max(1, Math.ceil(this.filteredApplications.length / this.explorerPageSize));
	}

	get explorerPageLabel() {
		return `Page ${this.explorerPage} of ${this.explorerPageCount}`;
	}

	get explorerResultLabel() {
		return `${this.explorerRecordCount} matching of ${this.explorerAllRows.length} applications · Assessment Period ${this.explorerAssessmentPeriod}`;
	}

	get explorerPreviousDisabled() {
		return this.explorerPage <= 1;
	}

	get explorerNextDisabled() {
		return this.explorerPage >= this.explorerPageCount;
	}

	get isDomainFilterDisabled() {
		return !this.applicationPortfolio;
	}

	get hasExplorerError() {
		return Boolean(this.explorerError);
	}

	get hasExplorerRows() {
		return this.explorerRows.length > 0;
	}

	get showExplorerEmptyState() {
		return !this.explorerLoading && !this.hasExplorerError && !this.hasExplorerRows;
	}

	get portfolioDimensions() {
		return SCORE_DIMENSIONS;
	}

	get dimensionScores() {
		const data = this.enterprise;
		return [
			{ label: 'Technology', value: data.tech },
			{ label: 'Resource', value: data.resource },
			{ label: 'Business', value: data.business },
			{ label: 'Compliance', value: data.compliance }
		].filter((row) => typeof row.value === 'number');
	}

		get enterpriseHealthStackSegments() {
		return this.buildStackSegments([
			{ label: 'Red', value: this.enterprise.red, color: '#960000' },
			{ label: 'Yellow', value: this.enterprise.yellow, color: '#8C7F4F' },
			{ label: 'Green', value: this.enterprise.green, color: '#6A815E' }
		]);
	}

	get enterpriseDimensionRowsForView() {
		const d = this.enterprise;
		return SCORE_DIMENSIONS.filter((dim) => dim.key !== 'overall' && typeof d[dim.key] === 'number').map((dim) => ({
			label: dim.label, value: this.formatScore(d[dim.key]), delta: '', fillStyle: this.dimensionFillStyle(d[dim.key])
		}));
	}

	get compositionChartsForView() {
		return this.compositionCharts.map((chart) => ({ ...chart, stackSegments: this.buildStackSegments(chart.segments) }));
	}

	get portfolioHeatmapRows() {
		return [...this.visiblePortfolios].sort((a,b) =>
    a.name.localeCompare(b.name, undefined, {
        sensitivity: 'base'
    })
).map((portfolio) => ({
			...portfolio,
			redClass: portfolio.red ? 'cnt risk-hot' : 'cnt',
			redDisplay: portfolio.red + portfolio.yellow + portfolio.green > 0 ? portfolio.red : '',
			scoreCells: SCORE_DIMENSIONS.map((dimension) => ({
				key: dimension.key,
				score: typeof portfolio[dimension.key] === 'number' ? this.formatScore(portfolio[dimension.key]) : '',
				delta: '',
				style: `background:${this.heatColor(portfolio[dimension.key])}`
			}))
		}));
	}

	get portfolioOverviewGroups() {
		const portfolios = this.visiblePortfolios.map((portfolio) => ({
			...portfolio,
			overallDisplay: this.formatScore(portfolio.overall),
			hasOverall: typeof portfolio.overall === 'number',
			hasHealth: portfolio.red + portfolio.yellow + portfolio.green > 0,
			hasRiskData: this.explorerAllRows.some((r) => r.portfolio === portfolio.name && Boolean(r.barr)),
			hasDimensionData: SCORE_DIMENSIONS.some((dim) => dim.key !== 'overall' && typeof portfolio[dim.key] === 'number'),
			overallDelta: '',
			overallStyle: `color:${this.ragColor(portfolio.overall)}`,
			unhealthyClass: portfolio.unhealthyCriticalHigh ? 'risk-hot-text' : 'risk-muted-text',
			// Keep the full Image 1 card layout even when a cycle has no ratings.
			// No hardcoded scores: every value still comes from the selected-cycle records.
			healthStackSegments: this.buildStackSegments([
				{ label: 'Red', value: portfolio.red, color: '#960000' },
				{ label: 'Yellow', value: portfolio.yellow, color: '#8C7F4F' },
				{ label: 'Green', value: portfolio.green, color: '#6A815E' }
			]),
			dimensionRows: SCORE_DIMENSIONS.filter((dim) => dim.key !== 'overall').map((dim) => ({
				label: dim.label,
				value: typeof portfolio[dim.key] === 'number' ? this.formatScore(portfolio[dim.key]) : '—',
				fillStyle: typeof portfolio[dim.key] === 'number'
					? this.dimensionFillStyle(portfolio[dim.key])
					: 'width:0%;background:transparent',
				rowClass: typeof portfolio[dim.key] === 'number'
					? 'dimrow compact-dimrow'
					: 'dimrow compact-dimrow portfolio-dimension-unrated'
			}))
		}));
		// Preserve the original four named groups for exact-name matches only.
		// Any other genuine Salesforce portfolio remains visible under Other.
		const byName = new Map(portfolios.map((portfolio) => [portfolio.name, portfolio]));
		const knownNames = new Set(PORTFOLIO_GROUPS.flatMap((group) => group.names));
		const groups = PORTFOLIO_GROUPS.map((group) => ({
			label: group.label,
			portfolios: group.names.map((name) => byName.get(name)).filter(Boolean)
				.sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }))
		})).filter((group) => group.portfolios.length > 0);
		const other = portfolios.filter((portfolio) => !knownNames.has(portfolio.name))
			.sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
		if (other.length) groups.push({ label: 'Other', portfolios: other });
		return groups;
	}

	get isPortfolioDetailView() {
		return this.isPortfolioHealth && Boolean(this.selectedPortfolioName);
	}

	get selectedPortfolio() {
		const portfolio = this.visiblePortfolios.find((item) => item.name === this.selectedPortfolioName) || null;
		if (!portfolio) {
			return null;
		}
		return {
			...portfolio,
			hasOverall: typeof portfolio.overall === 'number',
			overallDisplay: this.formatScore(portfolio.overall)
		};
	}

	get selectedPortfolioGroupLabel() {
		const group = PORTFOLIO_GROUPS.find((item) => item.names.includes(this.selectedPortfolioName));
		return group ? group.label : 'Other';
	}

	get portfolioDetailTabs() {
		return PORTFOLIO_DETAIL_TABS.filter((tab) => {
			if (tab.value === 'health' || tab.value === 'unhealthy') return this.selectedPortfolioHasHealth;
			if (tab.value === 'domains') return this.selectedPortfolioDomainRows.length > 0;
			return true;
		}).map((tab) => ({
			...tab,
			className: tab.value === this.selectedPortfolioTab ? 'portfolio-detail-tab active' : 'portfolio-detail-tab'
		}));
	}

	get isPortfolioSummaryTab() { return this.selectedPortfolioTab === 'summary'; }
	get isPortfolioHealthTab() { return this.selectedPortfolioTab === 'health'; }
	get isPortfolioUnhealthyTab() { return this.selectedPortfolioTab === 'unhealthy'; }
	get isPortfolioDomainsTab() { return this.selectedPortfolioTab === 'domains'; }
	get isPortfolioRisksTab() { return this.selectedPortfolioTab === 'risks'; }
	get isPortfolioWaiversTab() { return this.selectedPortfolioTab === 'waivers'; }
	get isPortfolioInitiativesTab() { return this.selectedPortfolioTab === 'initiatives'; }
	get isPortfolioDecisionsTab() { return this.selectedPortfolioTab === 'decisions'; }

	get hasSelectedPortfolioUnhealthyRows() { return this.selectedPortfolioUnhealthyRows.length > 0; }

	get selectedPortfolioRows() {
		if (!this.selectedPortfolioName) {
			return [];
		}
		return this.explorerAllRows.filter((row) => row.portfolio === this.selectedPortfolioName);
	}

	get selectedPortfolioHasHealth() {
		const p = this.selectedPortfolio;
		return Boolean(p && p.red + p.yellow + p.green > 0);
	}

	get selectedPortfolioHasScores() {
		const p = this.selectedPortfolio;
		return Boolean(p && SCORE_DIMENSIONS.some((dim) => typeof p[dim.key] === 'number'));
	}

	get selectedPortfolioHasNoScores() {
		return Boolean(this.selectedPortfolio && !this.selectedPortfolioHasScores);
	}

	get hasSelectedPortfolioComposition() {
		return this.selectedPortfolioCompositionCharts.length > 0;
	}

	get hasSelectedPortfolioHighlights() {
		return this.selectedPortfolioHighlights.length > 0;
	}

	get selectedPortfolioDetailCards() {
		const p = this.selectedPortfolio;
		if (!p) return [];
		const cards = [{ label: 'Applications', value: NUMBER_FORMAT.format(p.count), detail: 'assessment records' }];
		if (typeof p.overall === 'number') cards.push({ label: 'Overall Rating', value: this.formatScore(p.overall), detail: 'current mean' });
		if (this.selectedPortfolioHasHealth) cards.push({ label: 'Red', value: NUMBER_FORMAT.format(p.red), detail: 'rated red' });
		if (this.selectedPortfolioRows.some((row) => Boolean(row.barr))) {
			cards.push({ label: 'Critical / High', value: NUMBER_FORMAT.format(p.criticalHigh), detail: 'BARR' });
			if (this.selectedPortfolioHasHealth) cards.push({ label: 'Unhealthy Crit/High', value: NUMBER_FORMAT.format(p.unhealthyCriticalHigh), detail: 'rated red with Critical/High BARR' });
		}
		return cards;
	}

	get selectedPortfolioHealthStackSegments() {
		const portfolio = this.selectedPortfolio;
		if (!portfolio) {
			return [];
		}
		return this.buildStackSegments([
			{ label: 'Red', value: portfolio.red, color: '#960000' },
			{ label: 'Yellow', value: portfolio.yellow, color: '#8C7F4F' },
			{ label: 'Green', value: portfolio.green, color: '#6A815E' }
		]);
	}

	get selectedPortfolioDimensionRows() {
		const portfolio = this.selectedPortfolio;
		if (!portfolio) {
			return [];
		}
		return SCORE_DIMENSIONS.filter((dimension) => typeof portfolio[dimension.key] === 'number').map((dimension) => ({
			label: dimension.label,
			value: this.formatScore(portfolio[dimension.key]),
			fillStyle: this.dimensionFillStyle(portfolio[dimension.key])
		}));
	}

	get selectedPortfolioCompositionCharts() {
		const rows = this.selectedPortfolioRows;
		const toLegend = (segments) => segments.map((segment) => ({ label: segment.label, value: segment.value, indicatorStyle: `background-color:${segment.color}` }));
		const barrSegments = [
			{ label: 'Critical', value: this.countByCanonicalValues(rows, 'barr', ['Critical']), color: '#960000' },
			{ label: 'High', value: this.countByCanonicalValues(rows, 'barr', ['High']), color: '#8C7F4F' },
			{ label: 'Medium', value: this.countByCanonicalValues(rows, 'barr', ['Medium']), color: '#4E86B5' },
			{ label: 'Low', value: this.countByCanonicalValues(rows, 'barr', ['Low']), color: '#AAB4C0' }
		];
		const timeSegments = [
			{ label: 'Invest', value: this.countByCanonicalValues(rows, 'time', ['Invest']), color: '#6A815E' },
			{ label: 'Tolerate', value: this.countByCanonicalValues(rows, 'time', ['Tolerate']), color: '#4E86B5' },
			{ label: 'Migrate', value: this.countByCanonicalValues(rows, 'time', ['Migrate']), color: '#8C7F4F' },
			{ label: 'Eliminate', value: this.countByCanonicalValues(rows, 'time', ['Eliminate']), color: '#960000' }
		];
		return [
			{ title: 'BARR', stackSegments: this.buildStackSegments(barrSegments), legend: toLegend(barrSegments), total: barrSegments.reduce((n,s) => n + s.value,0) },
			{ title: 'TIME', stackSegments: this.buildStackSegments(timeSegments), legend: toLegend(timeSegments), total: timeSegments.reduce((n,s) => n + s.value,0) }
		].filter((chart) => chart.total > 0);
	}

	get selectedPortfolioNarrative() {
		const p = this.selectedPortfolio;
		if (!p) return '';
		const rows = this.selectedPortfolioRows;
		const domains = this.selectedPortfolioDomainRows;
		const parts = [`${NUMBER_FORMAT.format(p.count)} Salesforce assessment records`];
		if (domains.length) parts.push(`across ${NUMBER_FORMAT.format(domains.length)} named domains`);
		let text = parts.join(' ') + '.';
		if (typeof p.overall === 'number') text += ` Overall rating ${this.formatScore(p.overall)}.`;
		if (this.selectedPortfolioHasHealth) text += ` Rated health: ${p.red} red, ${p.yellow} yellow, ${p.green} green.`;
		if (rows.some((r) => Boolean(r.barr))) text += ` ${p.criticalHigh} applications have Critical/High BARR ratings.`;
		const migrated = this.countByCanonicalValues(rows, 'time', ['Migrate','Eliminate']);
		if (migrated) text += ` ${migrated} are marked Migrate/Eliminate.`;
		const measurableDomains = domains.filter((d) => typeof d.overall === 'number');
		if (measurableDomains.length) {
			const worst = [...measurableDomains].sort((a,b) => a.overall - b.overall)[0];
			text += ` Lowest-rated domain: ${worst.name} (${this.formatScore(worst.overall)}).`;
		}
		return text;
	}

	get selectedPortfolioHighlights() {
		const p = this.selectedPortfolio;
		if (!p) return [];
		const highlights = [];
		if (typeof p.overall === 'number') highlights.push(`Overall rating ${this.formatScore(p.overall)} across ${NUMBER_FORMAT.format(p.count)} applications.`);
		if (this.selectedPortfolioHasHealth) highlights.push(`${p.red} red / ${p.yellow} yellow / ${p.green} green rated applications.`);
		if (this.selectedPortfolioRows.some((r) => Boolean(r.barr)) && this.selectedPortfolioHasHealth) {
			highlights.push(`${p.unhealthyCriticalHigh} Critical/High BARR applications are rated unhealthy.`);
		}
		return highlights;
	}

	get selectedPortfolioDomainRows() {
		return this.summarizeDomains(this.selectedPortfolioRows).map((domain) => ({
			...domain,
			hasOverall: typeof domain.overall === 'number',
			hasHealth: domain.red + domain.yellow + domain.green > 0,
			hasDimensionData: domain.dimensionRows.length > 0,
			hasRiskData: this.selectedPortfolioRows.some((row) => row.domain === domain.name && Boolean(row.barr)),
			overallDisplay: this.formatScore(domain.overall),
			overallStyle: `color:${this.ragColor(domain.overall)}`,
			unhealthyClass: domain.unhealthyCriticalHigh ? 'risk-hot-text' : 'risk-muted-text'
		}));
	}

	get selectedPortfolioUnhealthyRows() {
		return this.selectedPortfolioRows
			.filter((row) => this.healthBand(row) === 'red')
			.sort((left, right) => (left.overall || 0) - (right.overall || 0))
			.map((row) => ({
				...row,
				overallDisplay: this.formatScore(row.overall),
				techDisplay: this.formatScore(row.tech),
				resourceDisplay: this.formatScore(row.resource),
				businessDisplay: this.formatScore(row.business),
				complianceDisplay: this.formatScore(row.compliance)
			}));
