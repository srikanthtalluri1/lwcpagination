
Map<String, Object> result =
    TpmArchitectureHubController.getAssessmentData(
        '{"assessmentPeriod":"Q12021"}'
    );

List<Map<String, Object>> rows =
    (List<Map<String, Object>>) result.get('records');

List<String> metrics = new List<String>{
    'overall',
    'tech',
    'resource',
    'business',
    'compliance',
    'barr',
    'time',
    'rag',
    'status'
};

Map<String, Integer> populated =
    new Map<String, Integer>();

Map<String, Integer> healthValues =
    new Map<String, Integer>();

for (String metric : metrics) {
    populated.put(metric, 0);
}

for (Map<String, Object> row : rows) {
    for (String metric : metrics) {
        Object value = row.get(metric);

        if (value != null &&
            !String.isBlank(String.valueOf(value))) {
            populated.put(
                metric,
                populated.get(metric) + 1
            );
        }
    }

    Object rag = row.get('rag');

    if (rag != null &&
        !String.isBlank(String.valueOf(rag))) {
        String health = String.valueOf(rag);
        Integer count = healthValues.containsKey(health)
            ? healthValues.get(health) : 0;

        healthValues.put(health, count + 1);
    }
}

System.debug('HUB_TOTAL=' + rows.size());

for (String metric : metrics) {
    System.debug(
        'HUB_POPULATED_' + metric.toUpperCase()
        + '=' + populated.get(metric)
    );
}

System.debug(
    'HUB_RAG_VALUES=' + JSON.serialize(healthValues)
);
