:host{display:block;color:#1e3546;font-family:Arial,Helvetica,sans-serif}
.waivers-page{width:100%;min-width:0}
.pagehead{margin:0 0 24px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:11px;color:#6f7f86}
h1,h2{font-family:Georgia,serif;color:#17354a}h1{font-size:32px;margin:6px 0 10px}h2{font-size:20px;margin:0}
.lede{color:#566a75;max-width:880px;font-size:14px;line-height:1.65}.load-area{min-height:110px}
.kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(130px,1fr));gap:13px;margin-bottom:18px}
.kpi{padding:17px 14px;border:1px solid #d7dee3;border-top:3px solid #244d63;border-radius:8px;background:#fff;min-width:0}
.kpi strong{display:block;font:700 30px Georgia,serif;color:#1d3b4d;margin:10px 0 2px}
.kpi small{color:#667984;line-height:1.4;display:block}.kpi.red{border-top-color:#ac293e}.kpi.gold{border-top-color:#aa8553}
.card{background:#fff;border:1px solid #d8e0e4;border-radius:8px;padding:22px 20px;margin-bottom:18px;min-width:0}
.card-heading{display:flex;gap:12px;align-items:baseline;justify-content:space-between;flex-wrap:wrap;margin-bottom:18px}
.index{font:600 12px Arial,sans-serif;color:#8e9ca4;margin-right:10px}.note{color:#76848d;font-size:11px}
.standard-row{display:grid;grid-template-columns:minmax(180px,260px) 1fr 46px 60px;align-items:center;gap:15px;background:transparent;border:0;width:100%;text-align:left;padding:8px;cursor:pointer;color:#274253}
.standard-row:hover,.standard-row:focus{background:#f1f7fa}.standard-name{font-size:12px;overflow-wrap:anywhere}.bar-track{height:11px;border-radius:3px;overflow:hidden;background:#e9edf0}.bar-fill{display:block;background:#4d7f8a;height:100%}.standard-row strong{font-size:12px}.standard-row small{font-size:11px;color:#6b7c87}
.table-scroll{overflow:auto;width:100%}table{width:100%;border-collapse:collapse;font-size:12px;min-width:840px}
th{background:#f4f7f8;text-transform:uppercase;letter-spacing:.04em;color:#5c6e77;white-space:nowrap;text-align:left;font-weight:600}
th,td{padding:10px 12px;border-bottom:1px solid #e2e8eb;vertical-align:top}tbody tr:hover{background:#f8fafb}
.primary{font-weight:600;color:#1e3c4f;min-width:210px}.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;align-items:center}
.filters select,.filters input{border:1px solid #b9c7cf;border-radius:6px;background:#fff;padding:9px 10px;color:#243e4e;max-width:100%;min-width:170px}.filters .search{flex:1;min-width:230px}
.sort-button,.text-link{background:transparent;border:0;padding:0;cursor:pointer;color:#246b89;font:inherit;text-align:left}.sort-button{font-size:12px;font-weight:600;color:#51626f;white-space:nowrap}.text-link:hover{text-decoration:underline}
.pill{display:inline-block;border-radius:999px;padding:4px 9px;font-size:11px;white-space:nowrap}.pill.danger{background:#f9e9ea;color:#a42c3d}.pill.warning{background:#f8efde;color:#79591c}.pill.muted{background:#eef1f2;color:#5e707c}
.health{font-weight:600;padding:3px 6px;border-radius:4px}.health.red{color:#b1263e;background:#fff0f1}.health.yellow{color:#8b671f;background:#fff6e4}.health.green{color:#286345;background:#eef8f1}.health.neutral{color:#66737b}
.pager{display:flex;justify-content:flex-end;align-items:center;gap:12px;margin-top:12px;color:#697c87;font-size:12px}.notice{background:#f5f8fa;border-left:3px solid #b1c4cf;padding:11px 13px;color:#5a6d78;font-size:12px;line-height:1.5;margin-top:15px}.error{display:flex;gap:15px;align-items:center}.empty{padding:26px}
@media(max-width:1050px){.kpi-grid{grid-template-columns:repeat(3,minmax(150px,1fr))}.standard-row{grid-template-columns:minmax(150px,220px) 1fr 40px 52px}}
@media(max-width:650px){.kpi-grid{grid-template-columns:repeat(2,minmax(130px,1fr))}.card{padding:14px}.standard-row{grid-template-columns:1fr 70px 38px 50px;gap:8px}.standard-name{font-size:11px}h1{font-size:25px}}
