    handleNavigation(event) {

        const selectedKey = event.currentTarget.dataset.key;

        this.selectedPage = selectedKey;
    }


    handleDashboardClick() {
        this.selectedPage = 'dashboard';
    }


    get isEnterpriseDashboard() {
        return this.selectedPage === 'dashboard';
    }


    get selectedPageLabel() {

        const selectedItem =
            this.navigationItems.find(
                item => item.key === this.selectedPage
            );

        return selectedItem
            ? selectedItem.label
            : 'Enterprise Dashboard';
    }


    /**
     * Add selected CSS dynamically.
     */
    get navigationWithClasses() {

        return this.navigationItems.map(item => {

            return {
                ...item,
                className:
                    item.key === this.selectedPage
                        ? 'nav-item nav-item-active'
                        : 'nav-item'
            };

        });
    }


    get homeNavigation() {

        return this.navigationWithClasses.filter(
            item => item.group === 'home'
        );
    }


    get assessNavigation() {

        return this.navigationWithClasses.filter(
            item => item.group === 'assess'
        );
    }


    get practiceNavigation() {

        return this.navigationWithClasses.filter(
            item => item.group === 'practice'
        );
    }
