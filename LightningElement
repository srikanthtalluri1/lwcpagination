    }
    .main-content {
        margin-left: 208px;
        padding: 22px 20px 38px;
    }
    .g2,
    .g3,
    .g5 {
        grid-template-columns: 1fr;
    }
}
@media (max-width: 650px) {
    .sidebar {
        position: static;
        width: 100%;
        top: 0;
    }
    .topbar {
        position: static;
        left: 0;
        height: auto;
        flex-wrap: wrap;
        padding: 12px 14px;
    }
    .main-content {
        margin: 0;
        padding: 18px 14px 32px;
    }
    .gsearch-input,
    .gsearch-input:focus {
        width: 100%;
    }
}

