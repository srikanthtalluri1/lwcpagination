	scoreBand(score) {
		if (score === null || score === undefined || Number.isNaN(score)) {
			return 'heat-neutral';
		}
		if (score < 2.5) {
			return 'heat-red';
		}
		return score < 3.5 ? 'heat-yellow' : 'heat-green';
	}

	formatDelta(delta) {
		if (Math.abs(delta) < 0.005) {
			return '—';
		}
		return `${delta > 0 ? '▲' : '▼'}${Math.abs(delta).toFixed(2)}`;
	}

	formatScore(score) {
		return score === null || score === undefined || Number.isNaN(score) ? '—' : score.toFixed(2);
	}

	shortDelta(delta) {
		if (Math.abs(delta) < 0.005) {
			return '';
		}
		return `${delta > 0 ? '▲' : '▼'}${Math.abs(delta).toFixed(2)}`;
	}

	dimensionFillStyle(value) {
		const percent = value === null || value === undefined || Number.isNaN(value) ? 0 : Math.max(0, Math.min(100, (value / 5) * 100));
		return `width:${percent}%;background:${this.ragColor(value)}`;
	}

	ragColor(value) {
		if (value === null || value === undefined || Number.isNaN(value)) {
			return '#B9B6AC';
		}
		if (value < 2.5) {
			return '#960000';
		}
		return value < 3.5 ? '#8C7F4F' : '#6A815E';
	}

	heatColor(value) {
		if (value === null || value === undefined || Number.isNaN(value)) {
			return '#D6D4CC';
		}
		if (value < 2.5) {
			const t = Math.max(0, (value - 1) / 1.5);
			return this.mixColor('#6B0000', '#B70000', t);
		}
		if (value < 3.5) {
			const t = (value - 2.5) / 1.0;
			return this.mixColor('#7A6E44', '#A8996A', t);
		}
		const t = Math.min(1, (value - 3.5) / 1.5);
		return this.mixColor('#8CA37F', '#4E6344', t);
	}

	mixColor(from, to, ratio) {
		const start = [parseInt(from.slice(1, 3), 16), parseInt(from.slice(3, 5), 16), parseInt(from.slice(5, 7), 16)];
		const finish = [parseInt(to.slice(1, 3), 16), parseInt(to.slice(3, 5), 16), parseInt(to.slice(5, 7), 16)];
		const mixed = start.map((value, index) => Math.round(value + (finish[index] - value) * ratio));
		return `rgb(${mixed[0]},${mixed[1]},${mixed[2]})`;
	}

	buildStackSegments(segments) {
		const total = segments.reduce((sum, segment) => sum + (Number(segment.value) || 0), 0);
		return segments.map((segment) => {
			const rawValue = Number(segment.value) || 0;
			const width = total ? (rawValue / total) * 100 : 0;
			return {
				...segment,
				style: `width:${width}%;background:${segment.color}`
			};
		});
	}

	summarizeDomains(rows) {
		const grouped = new Map();
		rows.forEach((row) => {
			const name = row.domain;
			if (!name) return; // No fabricated Unassigned domain tiles.
			if (!grouped.has(name)) {
				grouped.set(name, []);
			}
			grouped.get(name).push(row);
		});
		return [...grouped.entries()].map(([name, domainRows]) => {
			const summary = this.summarizeRows(domainRows);
			const criticalHigh = this.countByCanonicalValues(domainRows, 'barr', ['Critical', 'High']);
			const unhealthyCriticalHigh = domainRows.filter((row) => this.healthBand(row) === 'red' && ['Critical', 'High'].includes(this.canonicalizeValue(row.barr, ['Critical', 'High']))).length;
			return {
				name,
				count: summary.count,
				overall: summary.overall,
				tech: summary.tech,
				resource: summary.resource,
				business: summary.business,
				compliance: summary.compliance,
				red: summary.red,
				yellow: summary.yellow,
				green: summary.green,
				criticalHigh,
				unhealthyCriticalHigh,
				dimensionRows: SCORE_DIMENSIONS.filter((dimension) => dimension.key !== 'overall' && typeof summary[dimension.key] === 'number').map((dimension) => ({
					label: dimension.label,
					value: this.formatScore(summary[dimension.key]),
					fillStyle: this.dimensionFillStyle(summary[dimension.key])
				})),
				healthSegments: this.buildStackSegments([
					{ label: 'Red', value: summary.red, color: '#960000' },
					{ label: 'Yellow', value: summary.yellow, color: '#8C7F4F' },
					{ label: 'Green', value: summary.green, color: '#6A815E' }
				])
			};
		}).sort((left, right) => right.count - left.count);
	}

	safePercent(part, total) {
		return total ? ((part / total) * 100).toFixed(0) : '0';
	}
	rowsSupportPortfolioMetrics(rows) {
		return rows.some(
			(row) => Boolean(row.portfolio) && typeof row.overall === 'number' && !Number.isNaN(row.overall)
		);
	}

	handleNavigate(event) {
		this.currentPage = event.detail?.name || event.currentTarget?.dataset?.page || 'dashboard';
		if (this.currentPage !== 'portfolios') {
			this.selectedPortfolioName = '';
			this.selectedPortfolioTab = 'summary';
		}
		if (!this.explorerAllRows.length && !this.explorerLoading) {
			this.loadAssessmentData();
		}
	}

	// Scroll only once the selected portfolio's detail DOM has been rendered.
	// The former handler scrolled the old overview before LWC finished rendering.
	renderedCallback() {
		if (!this._pendingPortfolioScroll || !this.isPortfolioDetailView) return;
		const detailHeading = this.template.querySelector('.portfolio-detail-pagehead');
		if (!detailHeading) return; // Keep the pending scroll until the view actually exists.
		this._pendingPortfolioScroll = false;
		if (typeof detailHeading.scrollIntoView === 'function') {
			detailHeading.scrollIntoView({ behavior: 'auto', block: 'start' });
		}
	}

	handlePortfolioOpen(event) {
		// Button clicks must not also execute the parent heatmap-row handler.
		if (event && typeof event.stopPropagation === 'function') event.stopPropagation();
		const requestedName = String(event?.currentTarget?.dataset?.portfolio || '').trim();
		if (!requestedName) return;
		// Match to the live Salesforce-backed portfolio list (not the static group mapping).
		// Trimming/case-insensitive matching avoids silently ignoring an actual portfolio.
		const matched = this.visiblePortfolios.find((portfolio) =>
			String(portfolio.name || '').trim().toLocaleLowerCase() === requestedName.toLocaleLowerCase()
		);
		if (!matched) return;
		this.selectedPortfolioName = matched.name;
		this.selectedPortfolioTab = 'summary';
		this.currentPage = 'portfolios';
		this._pendingPortfolioScroll = true;
	}

	// Heatmap rows and portfolio cards support Enter / Space as well as mouse clicks.
	handlePortfolioKeydown(event) {
		if (event.key !== 'Enter' && event.key !== ' ') return;
		event.preventDefault();
		this.handlePortfolioOpen(event);
	}

	handlePortfolioBack() {
		this._pendingPortfolioScroll = false;
		this.selectedPortfolioName = '';
		this.selectedPortfolioTab = 'summary';
	}

	handlePortfolioTab(event) {
		this.selectedPortfolioTab = event.currentTarget.dataset.tab || 'summary';
	}

	normalizeAssessmentRows(records) {
		return records.map((record) => this.normalizeAssessmentRecord(record));
	}

	normalizeAssessmentRecord(record) {
		return {
			...record,
			name: record.name || '',
			portfolio: record.portfolio || '',
			domain: record.domain || '',
			category: record.category || '',
			barr: record.barr || '',
			time: record.time || '',
			status: record.status || '',
			rag: record.rag || '',
			architect: record.architect || '',
			owner: record.owner || '',
			overall: this.numberValue(record.overall),
			tech: this.numberValue(record.tech),
			resource: this.numberValue(record.resource),
			business: this.numberValue(record.business),
			compliance: this.numberValue(record.compliance)
		};
	}

	numberValue(value) {
		if (value === null || value === undefined || value === '') {
			return null;
		}
		const parsed = Number(value);
		return Number.isFinite(parsed) ? parsed : null;
	}

	summarizeRows(rows) {
		if (!rows.length) {
			return { count: 0, overall: null, tech: null, resource: null, business: null, compliance: null, red: 0, yellow: 0, green: 0 };
		}
		const healthCounts = this.countHealth(rows);
		return {
			count: rows.length,
			overall: this.averageForField(rows, 'overall'),
			tech: this.averageForField(rows, 'tech'),
			resource: this.averageForField(rows, 'resource'),
			business: this.averageForField(rows, 'business'),
			compliance: this.averageForField(rows, 'compliance'),
			red: healthCounts.red,
			yellow: healthCounts.yellow,
			green: healthCounts.green
		};
	}

	averageForField(rows, fieldName) {
		const values = rows.map((row) => row[fieldName]).filter((value) => typeof value === 'number' && !Number.isNaN(value));
		if (!values.length) {
			return null;
		}
		return values.reduce((sum, value) => sum + value, 0) / values.length;
	}

	countHealth(rows) {
		return rows.reduce((counts, row) => {
			const band = this.healthBand(row);
			if (band) counts[band] += 1;
			return counts;
		}, { red: 0, yellow: 0, green: 0 });
	}

	healthBand(row) {
		const rag = String(row.rag || '').trim().toLowerCase();
		// Salesforce Assessment_Health_Status__c uses Healthy / Degraded /
		// Unhealthy (confirmed for Q12021). Also honor color aliases.
		if (rag === 'red' || rag === 'unhealthy') {
			return 'red';
		}
		if (rag === 'yellow' || rag === 'degraded') {
			return 'yellow';
		}
		if (rag === 'green' || rag === 'healthy') {
			return 'green';
		}
		if (typeof row.overall === 'number') {
			return row.overall < 2.5 ? 'red' : row.overall < 3.5 ? 'yellow' : 'green';
		}
		return null; // A missing RAG and score must not silently become healthy.
	}

	countByCanonicalValues(rows, fieldName, canonicalValues) {
		return rows.reduce((count, row) => count + (canonicalValues.includes(this.canonicalizeValue(row[fieldName], canonicalValues)) ? 1 : 0), 0);
	}

	canonicalizeValue(value, candidates) {
		const raw = String(value || '').trim();
		const match = candidates.find((candidate) => candidate.toLowerCase() === raw.toLowerCase());
		return match || raw;
	}

	summarizePortfolios(rows) {
		const grouped = new Map();
		rows.forEach((row) => {
			const name = row.portfolio;
			if (!name) return; // Only genuine named portfolios receive tiles.
			if (!grouped.has(name)) {
				grouped.set(name, []);
			}
			grouped.get(name).push(row);
		});
		return [...grouped.entries()].map(([name, portfolioRows]) => {
			const summary = this.summarizeRows(portfolioRows);
			const criticalHigh = this.countByCanonicalValues(portfolioRows, 'barr', ['Critical', 'High']);
			const unhealthyCriticalHigh = portfolioRows.filter((row) => this.healthBand(row) === 'red' && ['Critical', 'High'].includes(this.canonicalizeValue(row.barr, ['Critical', 'High']))).length;
			return {
				name,
				count: summary.count,
				overall: summary.overall,
				tech: summary.tech,
				resource: summary.resource,
				business: summary.business,
				compliance: summary.compliance,
				red: summary.red,
				yellow: summary.yellow,
				green: summary.green,
				criticalHigh,
				unhealthyCriticalHigh,
				healthSegments: [
					{ label: 'Red', value: summary.red, color: 'var(--slds-g-color-error-base-40)' },
					{ label: 'Yellow', value: summary.yellow, color: 'var(--slds-g-color-warning-base-40)' },
					{ label: 'Green', value: summary.green, color: 'var(--slds-g-color-success-base-40)' }
				],
				healthLabel: `${summary.red} red, ${summary.yellow} yellow, ${summary.green} green applications`
			};
		}).sort((left, right) => left.name.localeCompare(right.name));
	}
}


