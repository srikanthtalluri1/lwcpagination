
Schema.SObjectType assessmentType =
    Schema.getGlobalDescribe().get(
        'TPM_Assessment__c'
    );

Schema.DescribeFieldResult appLookup =
    assessmentType.getDescribe()
    .fields.getMap()
    .get('App__c')
    .getDescribe();

for (Schema.SObjectType appType :
     appLookup.getReferenceTo()) {

    System.debug(
        'HUB_APP_OBJECT=' +
        appType.getDescribe().getName()
    );

    for (Schema.SObjectField field :
         appType.getDescribe()
         .fields.getMap().values()) {

        Schema.DescribeFieldResult d =
            field.getDescribe();

        String searchText =
            (d.getName() + ' ' + d.getLabel())
            .toLowerCase();

        if (searchText.contains('portfolio') ||
            searchText.contains('group') ||
            searchText.contains('category')) {

            System.debug(
                'HUB_GROUP_FIELD=' +
                d.getName() +
                ' | LABEL=' + d.getLabel() +
                ' | TYPE=' + d.getType()
            );
        }
    }
}
