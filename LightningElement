	get selectedPortfolioNarrative() {
		const portfolio = this.selectedPortfolio;
		if (!portfolio) {
			return '';
		}
		const rows = this.selectedPortfolioRows;
		const domains = this.selectedPortfolioDomainRows;
		const migrateCount = this.countByCanonicalValues(rows, 'time', ['Migrate', 'Eliminate']);
		const weakestDimension = SCORE_DIMENSIONS.filter((dimension) => typeof portfolio[dimension.key] === 'number').sort((left, right) => portfolio[left.key] - portfolio[right.key])[0];
		const lowestDomain = domains.length ? [...domains].sort((left, right) => left.overall - right.overall)[0] : null;
		const largestDomain = domains.length ? [...domains].sort((left, right) => right.count - left.count)[0] : null;
		let text = `${NUMBER_FORMAT.format(portfolio.count)} assessed applications across ${NUMBER_FORMAT.format(domains.length)} domains with an overall rating of ${this.formatScore(portfolio.overall)}. `;
		text += `${NUMBER_FORMAT.format(portfolio.red)} applications are currently unhealthy (${this.safePercent(portfolio.red, portfolio.count)}% of the portfolio), and ${NUMBER_FORMAT.format(portfolio.criticalHigh)} are rated Critical or High BARR risk.`;
		if (weakestDimension) { text += ` The weakest measured dimension is ${weakestDimension.label} at ${this.formatScore(portfolio[weakestDimension.key])}.`; }
		if (migrateCount) { text += ` ${NUMBER_FORMAT.format(migrateCount)} applications are tagged Migrate or Eliminate in Salesforce.`; }
		if (lowestDomain) { text += ` Lowest-rated domain: ${lowestDomain.name} at ${this.formatScore(lowestDomain.overall)}.`; }
		if (largestDomain && largestDomain.name !== (lowestDomain && lowestDomain.name)) { text += ` Largest domain: ${largestDomain.name} with ${NUMBER_FORMAT.format(largestDomain.count)} applications.`; }
		return text;
	}

