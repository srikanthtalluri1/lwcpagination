@IsTest
private class TPM_PAAMStackDataTest {

    private static void setName(SObject recordItem, String nameValue) {
        Map<String, Schema.SObjectField> fields =
            recordItem.getSObjectType().getDescribe().fields.getMap();

        if (fields.containsKey('Name')) {
            Schema.DescribeFieldResult nameField =
                fields.get('Name').getDescribe();

            if (nameField.isCreateable() && !nameField.isAutoNumber()) {
                recordItem.put('Name', nameValue);
            }
        }
    }

    private static String getPicklistValue(
        Schema.DescribeFieldResult fieldDescribe
    ) {
        for (
            Schema.PicklistEntry entry :
            fieldDescribe.getPicklistValues()
        ) {
            if (entry.isActive()) {
                return entry.getValue();
            }
        }

        return null;
    }

    static List<User> usrList = new List<User>();

    @TestSetup
    public static void setupData() {

        usrList = testUserDataSetUp();

        System.runAs(usrList[0]) {

            UCH_Employee__c employee =
                new UCH_Employee__c(
                    Employee_ID__c = usrList[0].EmployeeNumber,
                    Department_Description__c = 'Test',
                    Department_ID__c = '1232s'
                );

            setName(
                employee,
                'Coverage Employee'
            );

            insert employee;

            Schema.SObjectType appObjectType =
                TPM_Stack_Layer_Import_Relationship__c.App__c
                    .getDescribe()
                    .getReferenceTo()[0];

            SObject appRecord =
                appObjectType.newSObject();

            setName(
                appRecord,
                'Coverage Application'
            );

            appRecord.put(
                'App_Name__c',
                'Coverage Application'
            );

            appRecord.put(
                'InActive__c',
                false
            );

            appRecord.put(
                'IT_Architect__c',
                employee.Id
            );

            appRecord.put(
                'Application_Owner__c',
                employee.Id
            );

            appRecord.put(
                'Business_Owner__c',
                employee.Id
            );

            /*
             * Create Portfolio -> Domain -> Category
             * because main class accesses:
             * Category__r.Domain__r.Port__r.Name
             */
            Schema.SObjectField categoryField =
                appObjectType
                    .getDescribe()
                    .fields
                    .getMap()
                    .get('Category__c');

            if (categoryField != null) {

                Schema.SObjectType categoryObjectType =
                    categoryField
                        .getDescribe()
                        .getReferenceTo()[0];

                Schema.SObjectField domainField =
                    categoryObjectType
                        .getDescribe()
                        .fields
                        .getMap()
                        .get('Domain__c');

                if (domainField != null) {

                    Schema.SObjectType domainObjectType =
                        domainField
                            .getDescribe()
                            .getReferenceTo()[0];

                    Schema.SObjectField portField =
                        domainObjectType
                            .getDescribe()
                            .fields
                            .getMap()
                            .get('Port__c');

                    if (portField != null) {

                        Schema.SObjectType portObjectType =
                            portField
                                .getDescribe()
                                .getReferenceTo()[0];

                        SObject portRecord =
                            portObjectType.newSObject();

                        setName(
                            portRecord,
                            'Coverage Portfolio'
                        );

                        insert portRecord;

                        SObject domainRecord =
                            domainObjectType.newSObject();

                        setName(
                            domainRecord,
                            'Coverage Domain'
                        );

                        domainRecord.put(
                            'Port__c',
                            portRecord.Id
                        );

                        insert domainRecord;

                        SObject categoryRecord =
                            categoryObjectType.newSObject();

                        setName(
                            categoryRecord,
                            'Coverage Category'
                        );

                        categoryRecord.put(
                            'Domain__c',
                            domainRecord.Id
                        );

                        insert categoryRecord;

                        appRecord.put(
                            'Category__c',
                            categoryRecord.Id
                        );
                    }
                }
            }

            Schema.DescribeFieldResult operationalStatusField =
                appObjectType
                    .getDescribe()
                    .fields
                    .getMap()
                    .get('Operational_Status__c')
                    .getDescribe();

            String operationalStatus =
                getPicklistValue(
                    operationalStatusField
                );

            if (operationalStatus != null) {
                appRecord.put(
                    'Operational_Status__c',
                    operationalStatus
                );
            }

            insert appRecord;

            Schema.SObjectType configObjectType =
                TPM_Stack_Layer_Import_Relationship__c
                    .Stack_Layer_Config__c
                    .getDescribe()
                    .getReferenceTo()[0];

            SObject configRecord =
                configObjectType.newSObject();

            setName(
                configRecord,
                'Coverage Layer'
            );

            insert configRecord;

            List<TPM_Stack_Layer_Import_Relationship__c> junctions =
                new List<TPM_Stack_Layer_Import_Relationship__c>();

            for (Integer index = 0; index < 2; index++) {

                TPM_Stack_Layer_Import_Relationship__c junction =
                    new TPM_Stack_Layer_Import_Relationship__c(
                        App__c = appRecord.Id,
                        Stack_Layer_Config__c =
                            (Id) configRecord.get('Id')
                    );

                if (index == 0) {
                    junction.Mapping_Type__c = 'CI';
                } else {
                    junction.Mapping_Type__c = 'PAAM and CI';
                }

                setName(
                    junction,
                    'Coverage Junction ' + index
                );

                junctions.add(junction);
            }

            insert junctions;
        }
    }

    public static List<User> testUserDataSetUp() {

        String licenseName =
            'Salesforce Platform';

        return [
            SELECT
                Id,
                Name,
                EmployeeNumber,
                No_User_Sync__c,
                IsActive,
                Perform_Post_Activation_Steps__c,
                Contractor__c,
                UserType,
                ManagerId
            FROM User
            WHERE
                User_Type__c = null
                AND FederationIdentifier != null
                AND Is_separated__c = false
                AND Profile.UserLicense.Name = :licenseName
                AND IsActive = true
            ORDER BY LastName DESC
            LIMIT 3
        ];
    }

    @IsTest
    static void testGetStackLayJunction() {

        Test.startTest();

        TPM_PAAMStackData.getUniqueAppCount(
            'All'
        );

        TPM_PAAMStackData.PaamPageResult firstPage =
            TPM_PAAMStackData.getStackLayJunction(
                1,
                null,
                null,
                'All',
                'Coverage',
                'All'
            );

        System.assertNotEquals(
            null,
            firstPage
        );

        TPM_PAAMStackData.getStackLayJunction(
            1,
            'Coverage Application',
            firstPage.lastRecordId,
            'All',
            'Coverage',
            'All'
        );

        TPM_PAAMStackData.getStackLayJunction(
            null,
            null,
            null,
            'MyPrimary',
            'Co',
            'conflicts'
        );

        TPM_PAAMStackData.getStackLayJunction(
            0,
            null,
            null,
            'MyAll',
            'Coverage',
            'sync'
        );

        TPM_PAAMStackData.getStackLayJunction(
            500,
            'Coverage Application',
            null,
            'Unknown',
            null,
            'conflicts'
        );

        TPM_PAAMStackData.getStackLayJunction(
            10,
            null,
            null,
            null,
            '',
            'sync'
        );

        Test.stopTest();
    }
}
