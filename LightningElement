	get portfolioOverviewGroups() {
		const visibleMap = new Map(this.visiblePortfolios.map((portfolio) => [portfolio.name, portfolio]));
		const groups = PORTFOLIO_GROUPS.map((group) => ({
			label: group.label,
			portfolios: group.names
				.map((name) => visibleMap.get(name))
				.filter(Boolean)
				.map((portfolio) => {
					const prior = this.findSourcePortfolio(portfolio.name);
					return {
						...portfolio,
						overallDisplay: this.formatScore(portfolio.overall),
						overallDelta: prior ? this.formatDelta(portfolio.overall - prior.prior) : '',
						overallStyle: `color:${this.ragColor(portfolio.overall)}`,
						unhealthyClass: portfolio.unhealthyCriticalHigh ? 'risk-hot-text' : 'risk-muted-text',
						healthStackSegments: this.buildStackSegments([
							{ label: 'Red', value: portfolio.red, color: '#960000' },
							{ label: 'Yellow', value: portfolio.yellow, color: '#8C7F4F' },
							{ label: 'Green', value: portfolio.green, color: '#6A815E' }
						]),
						dimensionRows: SCORE_DIMENSIONS.filter((dimension) => dimension.key !== 'overall').map((dimension) => ({
							label: dimension.label,
							value: this.formatScore(portfolio[dimension.key]),
							fillStyle: this.dimensionFillStyle(portfolio[dimension.key])
						}))
					};
				})
		})).filter((group) => group.portfolios.length);
		const matched = new Set(PORTFOLIO_GROUPS.flatMap((group) => group.names));
		const extras = this.visiblePortfolios.filter((portfolio) => !matched.has(portfolio.name));
		if (extras.length) {
			groups.push({
				label: 'Other',
				portfolios: extras.map((portfolio) => ({
					...portfolio,
					overallDisplay: this.formatScore(portfolio.overall),
					overallDelta: '',
					overallStyle: `color:${this.ragColor(portfolio.overall)}`,
					unhealthyClass: portfolio.unhealthyCriticalHigh ? 'risk-hot-text' : 'risk-muted-text',
					healthStackSegments: this.buildStackSegments([
						{ label: 'Red', value: portfolio.red, color: '#960000' },
						{ label: 'Yellow', value: portfolio.yellow, color: '#8C7F4F' },
						{ label: 'Green', value: portfolio.green, color: '#6A815E' }
					]),
					dimensionRows: SCORE_DIMENSIONS.filter((dimension) => dimension.key !== 'overall').map((dimension) => ({
						label: dimension.label,
						value: this.formatScore(portfolio[dimension.key]),
						fillStyle: this.dimensionFillStyle(portfolio[dimension.key])
					}))
				}))
			});
		}
		return groups;
	}
