    @TestSetup
    static void setupTestData() {
        // Same shared test-user pattern as technologyDecision_CreateFormHelperTest.
        User testUser = new User(
            ProfileId = [SELECT Id FROM Profile WHERE Name = 'Standard User' LIMIT 1].Id,
            LastName = 'TestUser',
            Email = 'testuser@usaa.com',
            Username = 'testuser.' + System.currentTimeMillis() + '@usaa.com',
            Alias = 'tuser',
            TimeZoneSidKey = 'America/Los_Angeles',
            EmailEncodingKey = 'UTF-8',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            EmployeeNumber = 'P4444',
            IsActive = true
        );
        insert testUser;

        System.runAs(testUser) {
            // PermissionSet is metadata: reuse an existing permission set only.
            // Skip assignment if it is not deployed in the target org.
            List<PermissionSet> decisionPermissionSets = [
                SELECT Id FROM PermissionSet
                WHERE Name = 'Technology_Decission'
                LIMIT 1
            ];
            if (!decisionPermissionSets.isEmpty()) {
                insert new PermissionSetAssignment(
                    AssigneeId = testUser.Id,
                    PermissionSetId = decisionPermissionSets[0].Id
                );
            }

            // Create shared TPM objects once; they are available to all test methods.
            Test.startTest();
            TPM_Utility_TestData.createPDCAData();
            Test.stopTest();

            // Ensure the runAs user can be resolved to a matching employee.
            if ([SELECT COUNT() FROM UCH_Employee__c
                 WHERE Employee_ID__c = :testUser.EmployeeNumber] == 0) {
                insert new UCH_Employee__c(
                    Name = 'Technology Decision Test Employee',
                    Employee_ID__c = testUser.EmployeeNumber,
                    Employee_Email_Address__c = testUser.Email,
                    Department_Description__c = 'Testing Dep 1',
                    Department_ID__c = 'Test00',
                    Active_Flag__c = 'TRUE'
                );
            }

            // Match the existing relationship's application lookup filter.
            TPM_App__c app = [
                SELECT Id, Is_Assessment_Present__c, Application_Type__c
                FROM TPM_App__c
                WHERE UUID__c = 'EB5D4C65-4804-48E0-BD8B-HB0A27FC8E63'
                LIMIT 1
            ];
            app.Is_Assessment_Present__c = true;
            app.Application_Type__c = 'Application Services';
            update app;
        }
    }


    // Reuse the employee for the shared test user, created in @TestSetup.
    private static UCH_Employee__c createEmployee() {
        return [
            SELECT Id
            FROM UCH_Employee__c
            WHERE Employee_ID__c = 'P4444'
            LIMIT 1
        ];
    }

    private static TechnologyDecision_Relationship__c createRelationship() {
        // Reuse TPM records from the utility's @TestSetup, not new TPM DML.
        TPM_Domain__c dom = [
            SELECT Id FROM TPM_Domain__c
            WHERE Domain_Id__c = 444444
            LIMIT 1
        ];
        TPM_App__c app = [
            SELECT Id FROM TPM_App__c
            WHERE UUID__c = 'EB5D4C65-4804-48E0-BD8B-HB0A27FC8E63'
            LIMIT 1
        ];

        TechnologyDecision_Relationship__c rel = new TechnologyDecision_Relationship__c(
            Requesting_Domain__c      = dom.Id,
            Requesting_Application__c = app.Id
        );
        insert rel;
        return rel;
    }

    // The Is_Create_Notification_Send__c / Is_Initial_Creation__c flags stop
    // "TechnologyDecision Approval Flow" from sending its create email.
    private static TechnologyDecision__c createBaseDecision(Boolean withRelationship) {
        UCH_Employee__c emp = createEmployee();
        String uniq = String.valueOf(System.now().getTime());

        TechnologyDecision__c dec = new TechnologyDecision__c(
            Name                              = 'Unit Test Decision - ' + uniq,
            Stage__c                          = 'Saved',
            Status__c                         = 'Draft',
            Decision_Reason__c                = 'New Technology',
            Why__c                            = 'Why text',
            What__c                           = 'What text',
            Value__c                          = 'Value text',
            Requestor__c                      = emp.Id,
            Requesting_Technical_Architect__c = emp.Id,
            Requesting_Business_Owner__c      = emp.Id,
            Requesting_Application_Owner__c   = emp.Id,
            Requesting_Tech_Fellow__c         = emp.Id,
            TA_Acknowledged__c                = false,
            Is_Create_Notification_Send__c    = true,
            Is_Initial_Creation__c            = true
        );
        if (withRelationship) {
            dec.TechnologyDecision_Relationship__c = createRelationship().Id;
        }
        insert dec;
        return dec;
    }

    // Updates a tracked field so Salesforce writes a TechnologyDecision__History row
    private static TechnologyDecision__c changeStage(TechnologyDecision__c dec) {
        dec.Stage__c = 'Preparing Decision';
        update dec;
        return dec;
    }

