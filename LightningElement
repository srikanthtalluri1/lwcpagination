        TPM_PAAMStackData.getStackLayJunction(
            10,
            null,
            null,
            null,
            '',
            'sync',
                null
        );
        TPM_PAAMStackData.acceptConflict('{"stacklayerUuid": "INVALID_UUID"}');
        Test.stopTest();
    }

    // ADDITIONAL COVERAGE: Full logical pages, cursor navigation and Last page.
    // No read-only StackLayerStatus__c assignments are used.
    @IsTest
    static void testStablePaginationAndNavigation() {

        TPM_Stack_Layer_Import_Relationship__c existing = [
            SELECT App__c, Stack_Layer_Config__c
            FROM TPM_Stack_Layer_Import_Relationship__c
            WHERE App__c != null
            LIMIT 1
        ];

        List<TPM_Stack_Layer_Import_Relationship__c> junctions =
            new List<TPM_Stack_Layer_Import_Relationship__c>();

        for (Integer index = 0; index < 8; index++) {
            TPM_Stack_Layer_Import_Relationship__c junction =
                new TPM_Stack_Layer_Import_Relationship__c(
                    App__c = existing.App__c,
                    Stack_Layer_Config__c = existing.Stack_Layer_Config__c,
                    App_UUID__c = 'TESTPAGEAPP',
                    Stack_Layer_UUID__c = 'TESTLAYER' + String.valueOf(index),
                    Mapping_Type__c = Math.mod(index, 3) == 0
                        ? 'CI'
                        : (Math.mod(index, 3) == 1 ? 'PAAM' : 'PAAM and CI')
                );

            setName(junction, 'Pagination Layer ' + index);
            junctions.add(junction);
        }

        insert junctions;

        Test.startTest();

        TPM_PAAMStackData.PaamPageResult firstPage =
            TPM_PAAMStackData.getStackLayJunction(
                2, null, null, 'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult secondPage =
            TPM_PAAMStackData.getStackLayJunction(
                2, firstPage.lastAppName, firstPage.lastRecordId,
                'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult thirdPage =
            TPM_PAAMStackData.getStackLayJunction(
                2, secondPage.lastAppName, secondPage.lastRecordId,
                'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult previousPage =
            TPM_PAAMStackData.getStackLayJunction(
                2, thirdPage.previousLastAppName,
                thirdPage.previousLastRecordId,
                'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult lastPage =
            TPM_PAAMStackData.getStackLayJunction(
                2, '__PAAM_LAST_PAGE__', null,
                'All', 'Coverage', 'All', null
            );

        Test.stopTest();

        System.assertEquals(
            true,
            firstPage.totalRecords >= 8 &&
            firstPage.rows.size() == 2 &&
            firstPage.hasMore &&
            secondPage.rows.size() == 2 &&
            secondPage.rows[0].Id != firstPage.rows[0].Id &&
            thirdPage.rows.size() == 2 &&
            previousPage.rows.size() == secondPage.rows.size() &&
            previousPage.rows[0].Id == secondPage.rows[0].Id &&
            lastPage.rows.size() > 0 &&
            !lastPage.hasMore &&
            lastPage.totalRecords == firstPage.totalRecords,
            'Unique-key pagination must keep consistent totals and cursors.'
        );
    }

    // ADDITIONAL COVERAGE: Ownership, All/Conflicts/In Sync, search and status.
    @IsTest
    static void testStableFiltersAndOwnership() {

        TPM_Stack_Layer_Import_Relationship__c existing = [
            SELECT App__c, Stack_Layer_Config__c
            FROM TPM_Stack_Layer_Import_Relationship__c
            WHERE App__c != null
            LIMIT 1
        ];

        List<TPM_Stack_Layer_Import_Relationship__c> junctions =
            new List<TPM_Stack_Layer_Import_Relationship__c>();

        for (Integer index = 0; index < 4; index++) {
            TPM_Stack_Layer_Import_Relationship__c junction =
                new TPM_Stack_Layer_Import_Relationship__c(
                    App__c = existing.App__c,
                    Stack_Layer_Config__c = existing.Stack_Layer_Config__c,
                    App_UUID__c = 'TESTFILTERAPP',
                    Stack_Layer_UUID__c = 'FILTERLAYER' + String.valueOf(index),
                    Mapping_Type__c = index == 0
                        ? 'CI'
                        : (index == 1 ? 'PAAM' : 'PAAM and CI')
                );

            setName(junction, 'Filter Layer ' + index);
            junctions.add(junction);
        }

        insert junctions;

        Test.startTest();

        TPM_PAAMStackData.PaamPageResult allRows =
            TPM_PAAMStackData.getStackLayJunction(
                200, null, null, 'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult conflicts =
            TPM_PAAMStackData.getStackLayJunction(
                200, null, null, 'All', 'Coverage', 'conflicts', null
            );

        TPM_PAAMStackData.PaamPageResult inSync =
            TPM_PAAMStackData.getStackLayJunction(
                200, null, null, 'All', 'Coverage', 'sync', null
            );

        TPM_PAAMStackData.getStackLayJunction(
            200, null, null, 'All', 'Co', 'All', null
        );

        TPM_PAAMStackData.getStackLayJunction(
            200, null, null, 'All', 'Coverage', 'All', 'Denied'
        );

        TPM_PAAMStackData.getStackLayJunction(
            200, null, null, 'All', 'Coverage', 'conflicts', 'Restricted'
        );

        TPM_PAAMStackData.getStackLayJunction(
            null, null, null, 'Unknown', null, 'All', null
        );

        TPM_PAAMStackData.getStackLayJunction(
            0, null, null, 'All', '', 'sync', null
        );

        TPM_PAAMStackData.getUniqueAppCount('All');
        TPM_PAAMStackData.getUniqueAppCount('Unknown');

        Test.stopTest();

        System.assertEquals(
            true,
            allRows.totalRecords >= 4 &&
            conflicts.totalConflicts + inSync.totalSync == allRows.totalRecords &&
            conflicts.filteredTotalRecords == conflicts.totalConflicts &&
            inSync.filteredTotalRecords == inSync.totalSync,
            'Filtered logical row counts should match the total.'
        );
    }

    // ADDITIONAL COVERAGE: Cursor-not-found, empty results and user ownership.
    @IsTest
    static void testStableEmptyCursorAndMyApps() {

        TPM_Stack_Layer_Import_Relationship__c existing = [
            SELECT App__c, Stack_Layer_Config__c
            FROM TPM_Stack_Layer_Import_Relationship__c
            WHERE App__c != null
            LIMIT 1
        ];

        Test.startTest();

        TPM_PAAMStackData.PaamPageResult emptySearch =
            TPM_PAAMStackData.getStackLayJunction(
                10, null, null, 'All', 'UNMATCHED_QUERY_98765', 'All', null
            );

        TPM_PAAMStackData.getStackLayJunction(
            10, '__PAAM_LAST_PAGE__', null,
            'All', 'UNMATCHED_QUERY_98765', 'All', null
        );

        TPM_PAAMStackData.getStackLayJunction(
            10, 'AAAA', existing.Stack_Layer_Config__c,
            'All', 'Coverage', 'All', null
        );

        TPM_PAAMStackData.getStackLayJunction(
            10, 'zzzzzzzz', existing.Stack_Layer_Config__c,
            'All', 'Coverage', 'All', null
        );

        TPM_PAAMStackData.getStackLayJunction(
            500, null, null, 'Unknown', 'Coverage', 'conflicts', null
        );

        List<User> testUsers = testUserDataSetUp();
        System.runAs(testUsers[0]) {
            TPM_PAAMStackData.getStackLayJunction(
                2, null, null, 'MyPrimary', 'Coverage', 'All', null
            );
            TPM_PAAMStackData.getStackLayJunction(
                2, null, null, 'MyAll', 'Coverage', 'conflicts', null
            );
            TPM_PAAMStackData.getUniqueAppCount('MyPrimary');
            TPM_PAAMStackData.getUniqueAppCount('MyAll');
        }

        TPM_PAAMStackData.acceptConflict(
            '{"stacklayerUuid":"NO_MATCH_LAYER_98765"}'
        );

        Test.stopTest();

        System.assertEquals(
            0,
            emptySearch.filteredTotalRecords,
            'An unmatched search should return zero logical rows.'
        );
    }
