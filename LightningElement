.portfolio-section-copy{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.portfolio-section-copy h2{margin:0;color:#a84e2f;font-size:13px;font-weight:900;letter-spacing:2px;text-transform:uppercase}
.portfolio-section-copy p{margin:0;color:#707988;font-size:13px}
.portfolio-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.portfolio-card{
  --accent:#2f65b2;position:relative;min-height:192px;overflow:hidden;border:1px solid #e4e7ed;border-radius:16px;background:#fff;
  padding:20px 22px 18px;box-shadow:0 4px 12px rgba(15,23,42,.08);transition:transform .18s ease,box-shadow .18s ease;
}
.portfolio-card:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(15,23,42,.12)}
.portfolio-card-ribbon{position:absolute;top:0;left:0;right:0;height:5px;background:var(--accent)}
.accent-olive{--accent:#8d9c35}.accent-blue{--accent:#2d61ae}.accent-teal{--accent:#3b9e95}.accent-purple{--accent:#7750a6}
.portfolio-card-topline{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-top:2px}
.portfolio-card-topline h3{margin:0;font-size:18px;line-height:1.2;font-weight:850;color:#141b2b;letter-spacing:-.25px}
.portfolio-card-topline strong{font-size:17px;line-height:1.2;color:var(--accent);font-weight:900;white-space:nowrap}
.portfolio-card-divider{height:1px;background:#e7eaf0;margin:14px 0 12px}
.portfolio-card>p{min-height:58px;margin:0;color:#747c8a;font-size:13px;line-height:1.45}
.portfolio-card-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px}
.platform-link,.level-two-label{border:0;background:transparent;color:var(--accent);padding:0;font-size:12px;font-weight:850;cursor:pointer}
.platform-link:hover,.level-two-label:hover{text-decoration:underline}
.level-two-list{display:grid;grid-template-columns:1fr;gap:5px;margin-top:14px;padding-top:12px;border-top:1px dashed #d7dce5}
.level-two-list button{border:0;background:#f7f9fc;color:#334155;text-align:left;border-radius:7px;padding:7px 9px;font-size:11px;font-weight:650;cursor:pointer}
.level-two-list button:hover{background:#eef3fb;color:#1f4e96}
.portfolio-list .portfolio-card-grid{grid-template-columns:1fr}
.portfolio-list .portfolio-card{min-height:0}
.portfolio-list .portfolio-card>p{min-height:0}
.load-error{padding:12px 16px;margin-bottom:14px;border:1px solid #efc4c4;background:#fff5f5;color:#8b1e1e;border-radius:10px;font-size:12px}

/* ===== LEVEL 1 PLATFORM LANDING ===== */
.nav-root-button{width:100%;border:0;background:transparent;color:#fff;font-size:15px;font-weight:800;padding:8px 10px 7px;text-align:left;cursor:pointer;border-radius:7px}
.nav-root-button:hover{background:rgba(255,255,255,.08)}
.crumb-button{border:0;background:transparent;padding:0;color:rgba(255,255,255,.45);cursor:pointer;font:inherit}
.crumb-button:hover{color:#fff;text-decoration:underline}
.crumb-button.mini-usaa{padding:5px 11px;color:#07101f;text-decoration:none}
.platform-hero-main{position:relative;padding-right:260px}
.platform-owner-row{display:flex;flex-wrap:wrap;gap:24px;margin-top:10px}
.platform-owner-row div{display:flex;flex-direction:column;gap:2px}
.platform-owner-row span,.platform-spend-box span{font-size:8.5px;font-weight:800;letter-spacing:.8px;color:rgba(255,255,255,.4)}
.platform-owner-row strong{font-size:11.5px;color:rgba(255,255,255,.82)}
.platform-spend-box{position:absolute;right:34px;top:16px;text-align:right}
.platform-spend-box strong{display:block;color:#c6a15b;font-size:22px;font-weight:900;margin-top:4px}
.platform-domain-section{padding:28px clamp(20px,2.8vw,64px) 36px}
.platform-section-title{font-size:10px;font-weight:800;letter-spacing:1.6px;color:#99a3b0;margin-bottom:16px}
.platform-domain-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px}
.platform-domain-card{overflow:hidden;border:1px solid #e4e7ee;border-radius:14px;background:#fff;box-shadow:0 1px 2px rgba(15,23,42,.04),0 12px 28px -10px rgba(15,23,42,.14)}
.platform-domain-ribbon{height:5px;background:linear-gradient(90deg,#0d1b33,#c6a15b)}
.platform-domain-body{padding:20px 22px 22px}
.platform-domain-tag{font-size:9.5px;font-weight:800;letter-spacing:1.4px;color:#99a3b0;margin-bottom:8px}
.platform-domain-body h2{margin:0 0 8px;font-size:18px;color:#111826}.platform-domain-body p{margin:0 0 14px;min-height:54px;color:#66707e;font-size:12px;line-height:1.55}
.platform-live{display:inline-block;padding:4px 10px;border-radius:20px;background:#fbead0;color:#7a5a12;font-size:9px;font-weight:800;letter-spacing:.7px}
.platform-domain-body button{display:block;margin-top:16px;border:0;background:transparent;color:#0d1b33;font-size:11.5px;font-weight:800;padding:0;cursor:pointer}
.platform-domain-body button:hover{text-decoration:underline}

@media (max-width:980px){
  .side-nav{width:250px}
  .main{width:calc(100% - 250px);margin-left:250px}
  .rail-toggle{left:226px}
  .rail-collapsed .main{margin-left:0;width:100%}
}
@media (max-width:760px){
  :host{width:100%}
  .shell{width:100%;max-width:100%}
  .side-nav{width:82vw;max-width:300px;transform:translateX(-100%)}
  .main{width:100%;margin-left:0!important}
  .rail-toggle{left:14px!important;top:14px}
  .shell:not(.rail-collapsed) .side-nav{transform:translateX(0)}
  .shell:not(.rail-collapsed) .rail-toggle{left:min(calc(82vw - 24px),276px)!important}
  .hero-top{flex-wrap:wrap;padding:8px 16px;gap:8px;padding-left:54px}
  .crumbs{font-size:10px;gap:5px;flex-wrap:wrap}
  .state-toggle{flex:1 1 100%;justify-content:center}
  .state-toggle button{padding:6px 10px;font-size:10px}
  .hero-main{padding:10px 16px 8px}
  .eyebrow{font-size:8px;letter-spacing:2px}
  .hero h1{font-size:17px}
  .hero p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:6px}
  .kpis{flex-wrap:wrap;gap:8px;padding-top:6px}
  .kpi{flex:1 1 calc(50% - 8px);min-width:0;padding:6px 10px}
  .kpi span{font-size:15px}.kpi small{font-size:8.5px}
  .legend{padding:6px 16px;gap:10px 14px}.legend-title{font-size:8.5px}.legend-item{font-size:10.5px;gap:6px}
  .content{padding:10px 14px 6px;gap:14px}
  .group-header{padding:12px 14px;gap:10px}.group-icon{width:34px;height:34px;border-radius:9px}.group-icon svg{width:18px;height:18px}.group-title-line h2{font-size:16px}.group-title-line span{display:block;margin-left:0;margin-top:2px}.group-title-wrap p{font-size:12px;max-width:none}
  .group-body,.subgroup-grid{grid-template-columns:1fr!important;overflow-x:visible}.cap-col{border-right:none!important;border-bottom:1px solid var(--line)}.cap-col:last-child{border-bottom:none}
  .tile-grid{gap:10px}.tech-tile{width:88px;height:88px;padding:10px 8px}.tile-name{font-size:9.5px}.tile-vendor{font-size:7px}.tile-logo{max-width:58px;max-height:34px}.tile-icon-label{font-size:8px;margin-top:4px}
  .footer{flex-direction:column;align-items:flex-start;padding:10px 14px;margin:6px 14px 20px;gap:6px}.footer div{gap:6px}
}
@media (max-width:480px){
  .hero h1{font-size:15px}.kpi{flex:1 1 100%}.tech-tile{width:78px;height:78px;padding:8px 6px}
}

@media (max-width:1100px){
  .portfolio-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .portfolio-hero{grid-template-columns:minmax(0,1fr) 360px}
}
@media (max-width:760px){
  .portfolio-hero{grid-template-columns:1fr;padding:22px 18px;gap:24px}
  .portfolio-hero-actions{align-items:stretch}.portfolio-search{width:100%}.portfolio-spend{text-align:left}
  .portfolio-hero h1{font-size:24px}.portfolio-body{padding:16px 14px 28px}.portfolio-toolbar{justify-content:stretch;flex-wrap:wrap}.portfolio-tool-btn{flex:1}
  .portfolio-section{padding:18px 14px 20px}.portfolio-card-grid{grid-template-columns:1fr}.portfolio-section-heading{gap:12px}
  .platform-hero-main{padding-right:16px}.platform-spend-box{position:static;text-align:left;margin-top:10px}.platform-owner-row{gap:14px}
}

