<template>
    <div class="confidential-bar">CONFIDENTIAL - USAA INTERNAL USE ONLY</div>

    <div class="workspace">
        <aside class="sidebar" aria-label="Architecture Hub navigation">
            <div class="brand">
                <div class="brand-mark">Architecture<span>Hub</span></div>
                <div class="brand-sub">CTO Enterprise Architecture</div>
            </div>
            <nav class="nav" aria-label="Architecture Hub sections">
                <template for:each={navigation} for:item="group">
                    <div key={group.key} class="nav-group">
                        <template lwc:if={group.label}>
                            <div class="nav-label">{group.label}</div>
                        </template>
                        <template for:each={group.items} for:item="item">
                            <button key={item.page} class={item.navClass} data-page={item.page} onclick={handleNavigate}>
                                <span class="nav-text">{item.label}</span>
                                <template lwc:if={item.badge}>
                                    <span class="badge">{item.badge}</span>
                                </template>
                            </button>
                        </template>
                    </div>
                </template>
            </nav>
            <div class="sidebar-foot">Prototype v0.1 · Site map v0.1</div>
        </aside>

        <div class="content-shell">
            <header class="topbar">
                <div class="crumbs"><span class="cur">{pageTitle}</span></div>
                <div class="topbar-spacer"></div>
                <label class="gsearch" for="architecture-hub-global-search">
                    <lightning-icon class="gi" icon-name="utility:search" size="xx-small" alternative-text="Search"></lightning-icon>
                    <input
                        id="architecture-hub-global-search"
                        class="gsearch-input"
                        type="search"
                        placeholder="Search applications, portfolios..."
                        value={applicationSearch}
                        oninput={handleTopbarSearchInput}
                        onkeydown={handleTopbarSearchKeydown}
                    />
                </label>
                <div class="cyclesel">
                    <span class="fl">Cycle</span>
                    <select class="cyclesel-select" value={selectedCycle} onchange={handleCycleChange} aria-label="Assessment cycle">
                        <template for:each={cycleOptions} for:item="option">
                            <option key={option.value} value={option.value}>{option.label}</option>
                        </template>
                    </select>
                </div>
                <div class="asof"><b>{selectedCycle}</b><span>AMA · refreshed 2026-08-23</span></div>
            </header>

            <main class="main-content">
                <template lwc:if={isDashboard}>
                    <div class="pagehead">
                        <div class="eyebrow">Enterprise Architecture</div>
                        <h1>Technology Architecture Practice</h1>
                        <p class="lede">Always-on view of USAA's application portfolio health, architecture governance, and strategic direction across 15 managed technology portfolios. Replaces the bi-annual State of Architecture publication as the system of record.</p>
                    </div>

                    <template lwc:if={showInitialSpinner}>
                        <div class="explorer-loading slds-is-relative" role="status" aria-live="polite">
                            <lightning-spinner alternative-text="Loading enterprise assessment data" size="medium"></lightning-spinner>
                        </div>
                    </template>

                    <template lwc:if={showDashboardData}>
                    <div class="status-note" role="status">{dashboardStatusLine}</div>

                    <section class="grid g5 kpi-grid" aria-label="Enterprise application health metrics">
                        <template for:each={kpis} for:item="item">
                            <article key={item.label} class={item.className}>
                                <div class="kpi-label">{item.label}</div>
                                <div class="kpi-value">{item.value}</div>
                                <div class="kpi-detail">{item.detail}</div>
                            </article>
                        </template>
                    </section>

                    <section class="grid g5 section-grid" aria-label="Architecture practice sections">
                        <template for:each={sectionCards} for:item="item">
                            <button key={item.title} class="section-card" data-page={item.page} onclick={handleNavigate}>
                                <div class="section-card-heading"><h2>{item.title}</h2><span>{item.kicker}</span></div>
                                <template lwc:if={item.hasValue}>
                                    <div class="section-value">{item.value}</div>
                                    <div class="section-detail">{item.detail}</div>
                                </template>
                                <template lwc:if={item.showMix}>
                                    <c-tpm-stacked-bar-chart class="health-stack" segments={item.segments} chart-label={item.healthLabel}></c-tpm-stacked-bar-chart>
                                </template>
                                <template lwc:if={item.description}>
                                    <p class="section-description">{item.description}</p>
                                </template>
                                <template lwc:if={item.footnote}>
                                    <div class="section-footnote">{item.footnote}</div>
                                </template>
                            </button>
                        </template>
                    </section>

                    <section class="card native-card platform-card">
                        <div class="card-h">
                            <h2>Platform Strategy</h2>
                            <div class="note">Enterprise Capability Portfolio · 27 platforms · 160 domains · 549 capabilities</div>
                        </div>
                        <div class="grid g3 platform-grid">
                            <template for:each={platformLayers} for:item="layer">
                                <div key={layer.name} class="platform-layer">
                                    <div class="layer-title">{layer.name}</div>
                                    <div class="layer-metrics"><strong>{layer.platforms}</strong><span>platforms</span></div>
                                    <div class="layer-detail">{layer.domains} domains · {layer.capabilities} capabilities</div>
                                    <p>{layer.tagline}</p>
                                </div>
                            </template>
                        </div>
                    </section>

                    <section class="card native-card">
                        <div class="card-h">
                            <h2>Enterprise Health Dimensions</h2>
                            <div class="note">Mean score · 1–5</div>
                        </div>
                        <div class="grid g2 dimension-grid">
                            <template for:each={dimensionScores} for:item="dimension">
                                <div key={dimension.label}>
                                    <c-tpm-score-bar-chart label={dimension.label} value={dimension.value}></c-tpm-score-bar-chart>
                                </div>
                            </template>
                        </div>
                    </section>

                    <footer class="data-footer">Snapshot from Salesforce TPM_Assessment__c data · {selectedCycle} · Dashboard values refresh from the Architecture Hub Apex service.</footer>
                    </template>
                </template>

                <template lwc:elseif={isPortfolioHealth}>
                    <div class="pagehead">
                        <div class="eyebrow">Assess</div>
                        <h1>Portfolio Health</h1>
                        <div class="lede">Fifteen managed technology portfolios, grouped as they appear in the State of Architecture. Each portfolio renders from one templated chapter rather than fifteen hand-built ones.</div>
                    </div>

                    <template lwc:if={showInitialSpinner}>
                        <div class="explorer-loading slds-is-relative" role="status" aria-live="polite">
                            <lightning-spinner alternative-text="Loading portfolio health data" size="medium"></lightning-spinner>
                        </div>
                    </template>

                    <template lwc:if={showPortfolioData}>
                    <template lwc:if={isPortfolioDetailView}>
                        <div class="portfolio-breadcrumbs">
                            <button class="breadcrumb-button" onclick={handlePortfolioBack}>Home</button>
                            <span class="breadcrumb-separator">&rsaquo;</span>
                            <button class="breadcrumb-button" onclick={handlePortfolioBack}>Portfolio Health</button>
                        </div>

                        <div class="pagehead portfolio-detail-pagehead">
                            <div class="eyebrow">{selectedPortfolioGroupLabel}</div>
                            <h1>{selectedPortfolio.name}</h1>
                            <div class="lede">{selectedPortfolio.count} assessed applications &middot; overall rating {selectedPortfolio.overallDisplay}</div>
                        </div>

                        <div class="portfolio-detail-tabs">
                            <template for:each={portfolioDetailTabs} for:item="tab">
                                <button key={tab.value} class={tab.className} data-tab={tab.value} onclick={handlePortfolioTab}>{tab.label}</button>
                            </template>
                        </div>

                        <template lwc:if={isPortfolioSummaryTab}>
                            <div class="grid g5 portfolio-detail-kpis">
                                <template for:each={selectedPortfolioDetailCards} for:item="card">
                                    <section key={card.label} class="card portfolio-detail-kpi-card">
                                        <div class="portfolio-detail-kpi-label">{card.label}</div>
                                        <div class="portfolio-detail-kpi-value">{card.value}</div>
                                        <div class="portfolio-detail-kpi-detail">{card.detail}</div>
                                    </section>
                                </template>
                            </div>

                            <div class="grid g2 portfolio-detail-summary-grid">
                                <section class="card">
                                    <div class="card-h"><h3>Health Mix</h3></div>
                                    <div class="stack">
                                        <template for:each={selectedPortfolioHealthStackSegments} for:item="segment">
                                            <div key={segment.label} style={segment.style}>{segment.value}</div>
                                        </template>
                                    </div>
                                    <div class="legend">
                                        <span class="legend-item">Red {selectedPortfolio.red} - &lt;2.5</span>
                                        <span class="legend-item">Yellow {selectedPortfolio.yellow} - 2.5-3.5</span>
                                        <span class="legend-item">Green {selectedPortfolio.green} - &gt;=3.5</span>
                                    </div>
                                    <div class="dimension-stack">
                                        <template for:each={selectedPortfolioDimensionRows} for:item="dimension">
                                            <div key={dimension.label} class="dimrow">
                                                <div class="dl">{dimension.label}</div>
                                                <div class="dtrack"><div class="dfill" style={dimension.fillStyle}></div></div>
                                                <div class="dv">{dimension.value}</div>
                                            </div>
                                        </template>
                                    </div>
                                </section>

                                <section class="card">
                                    <div class="card-h"><h3>Composition</h3></div>
                                    <template for:each={selectedPortfolioCompositionCharts} for:item="chart">
                                        <div key={chart.title} class="composition-block">
                                            <div class="mini-title">{chart.title}</div>
                                            <div class="stack">
                                                <template for:each={chart.stackSegments} for:item="segment">
                                                    <div key={segment.label} style={segment.style}>{segment.value}</div>
                                                </template>
                                            </div>
                                            <div class="legend">
                                                <template for:each={chart.legend} for:item="item">
                                                    <span key={item.label} class="legend-item"><i style={item.indicatorStyle}></i>{item.label} {item.value}</span>
                                                </template>
                                            </div>
                                        </div>
                                    </template>
                                </section>
                            </div>

                            <section class="card portfolio-detail-copy-card">
                                <div class="card-h"><h3>Portfolio Summary &amp; Highlights</h3><span class="note">Auto-generated from Salesforce assessment data</span></div>
                                <p class="portfolio-detail-copy">{selectedPortfolioNarrative}</p>
                                <ul class="portfolio-detail-highlights">
                                    <template for:each={selectedPortfolioHighlights} for:item="highlight">
                                        <li key={highlight}>{highlight}</li>
                                    </template>
                                </ul>
                            </section>
                        </template>

                        <template lwc:elseif={isPortfolioHealthTab}>
                            <div class="grid g2 portfolio-detail-summary-grid">
                                <section class="card">
                                    <div class="card-h"><h3>Four-Dimension Health</h3></div>
                                    <div class="dimension-stack">
                                        <template for:each={selectedPortfolioDimensionRows} for:item="dimension">
                                            <div key={dimension.label} class="dimrow">
                                                <div class="dl">{dimension.label}</div>
                                                <div class="dtrack"><div class="dfill" style={dimension.fillStyle}></div></div>
                                                <div class="dv">{dimension.value}</div>
                                            </div>
                                        </template>
                                    </div>
                                    <div class="stack">
                                        <template for:each={selectedPortfolioHealthStackSegments} for:item="segment">
                                            <div key={segment.label} style={segment.style}>{segment.value}</div>
                                        </template>
                                    </div>
                                </section>

                                <section class="card">
                                    <div class="card-h"><h3>Domain Detail by Health</h3></div>
                                    <div class="t-scroll">
                                        <table>
                                            <thead>
                                                <tr><th>Domain</th><th class="num">Apps</th><th class="num">Overall</th><th class="num">Red</th><th class="num">Yellow</th><th class="num">Green</th></tr>
                                            </thead>
                                            <tbody>
                                                <template for:each={selectedPortfolioDomainRows} for:item="domain">
                                                    <tr key={domain.name}>
                                                        <td class="t-name">{domain.name}</td>
                                                        <td class="num">{domain.count}</td>
                                                        <td class="num">{domain.overallDisplay}</td>
                                                        <td class="num risk-hot-text">{domain.red}</td>
                                                        <td class="num">{domain.yellow}</td>
                                                        <td class="num">{domain.green}</td>
                                                    </tr>
                                                </template>
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </template>

                        <template lwc:elseif={isPortfolioUnhealthyTab}>
                            <section class="card">
                                <div class="card-h"><h3>Unhealthy Applications</h3><span class="note">Overall rating below 2.5</span></div>
                                <template lwc:if={hasSelectedPortfolioUnhealthyRows}>
                                    <div class="t-scroll">
                                        <table>
                                            <thead>
                                                <tr><th>Application</th><th>Domain</th><th>BARR</th><th>TIME</th><th class="num">Overall</th><th class="num">Tech</th><th class="num">Rsrc</th><th class="num">Biz</th><th class="num">Cmpl</th><th>Architect</th></tr>
                                            </thead>
                                            <tbody>
                                                <template for:each={selectedPortfolioUnhealthyRows} for:item="row">
                                                    <tr key={row.id}>
                                                        <td class="t-name">{row.name}</td>
                                                        <td class="t-sub">{row.domain}</td>
                                                        <td>{row.barr}</td>
                                                        <td>{row.time}</td>
                                                        <td class="num">{row.overallDisplay}</td>
                                                        <td class="num">{row.techDisplay}</td>
                                                        <td class="num">{row.resourceDisplay}</td>
                                                        <td class="num">{row.businessDisplay}</td>
                                                        <td class="num">{row.complianceDisplay}</td>
                                                        <td class="t-sub">{row.architect}</td>
                                                    </tr>
                                                </template>
                                            </tbody>
                                        </table>
                                    </div>
                                </template>
                                <template lwc:else>
                                    <div class="portfolio-detail-empty">No unhealthy applications were returned from Salesforce for this portfolio.</div>
                                </template>
                            </section>
                        </template>

                        <template lwc:elseif={isPortfolioDomainsTab}>
                            <div class="grid g3 portfolio-domain-grid">
                                <template for:each={selectedPortfolioDomainRows} for:item="domain">
                                    <article key={domain.name} class="card portfolio-domain-card">
                                        <div class="card-h portfolio-card-header">
                                            <h3>{domain.name}</h3>
                                            <span class="note">{domain.count} apps</span>
                                        </div>
                                        <div class="portfolio-overall-line">
                                            <span class="portfolio-overall-value" style={domain.overallStyle}>{domain.overallDisplay}</span>
                                        </div>
                                        <div class="stack compact-stack">
                                            <template for:each={domain.healthSegments} for:item="segment">
                                                <div key={segment.label} style={segment.style}>{segment.value}</div>
                                            </template>
                                        </div>
                                        <div class="portfolio-dimensions-prototype">
                                            <template for:each={domain.dimensionRows} for:item="dimension">
                                                <div key={dimension.label} class="dimrow compact-dimrow">
                                                    <div class="dl">{dimension.label}</div>
                                                    <div class="dtrack"><div class="dfill" style={dimension.fillStyle}></div></div>
                                                    <div class="dv">{dimension.value}</div>
                                                </div>
                                            </template>
                                        </div>
                                        <div class="portfolio-risk-summary">{domain.criticalHigh} Critical/High - <span class={domain.unhealthyClass}>{domain.unhealthyCriticalHigh} unhealthy</span></div>
                                    </article>
                                </template>
                            </div>
                        </template>

                        <template lwc:elseif={isPortfolioRisksTab}>
                            <section class="card portfolio-detail-placeholder-card">
                                <div class="card-h"><h3>Portfolio Risks</h3></div>
                                <p class="portfolio-detail-copy">The portfolio detail shell is now in place. Live risk register records are not yet wired into this tab from Salesforce, so this section is intentionally held as a placeholder.</p>
                            </section>
                        </template>

                        <template lwc:elseif={isPortfolioWaiversTab}>
                            <section class="card portfolio-detail-placeholder-card">
                                <div class="card-h"><h3>Waivers</h3></div>
                                <p class="portfolio-detail-copy">This tab is reserved for the Salesforce waiver feed for the selected portfolio. The detail navigation is now present so it can be connected later without another UI rebuild.</p>
                            </section>
                        </template>

                        <template lwc:elseif={isPortfolioInitiativesTab}>
                            <section class="card portfolio-detail-placeholder-card">
                                <div class="card-h"><h3>Major Initiatives</h3></div>
                                <p class="portfolio-detail-copy">This section is ready for the portfolio initiative register once that Salesforce source is mapped into the Architecture Hub.</p>
                            </section>
                        </template>

                        <template lwc:elseif={isPortfolioDecisionsTab}>
                            <section class="card portfolio-detail-placeholder-card">
                                <div class="card-h"><h3>Technology Decisions</h3></div>
                                <p class="portfolio-detail-copy">The tab is available now, and it can be connected to the Salesforce decision register when you are ready to bring those records into the portfolio drill-down.</p>
                            </section>
                        </template>
                    </template>
                    <template lwc:else>
                        <div class="status-note" role="status"><b>Naming reconciliation open.</b> The Spring 2026 SoA lists <i>Membership and Growth</i>; the AMA extract uses <i>Marketing</i>. Shown here as <b>Marketing</b> to match the data.</div>

                    <section class="card">
                        <div class="card-h"><span class="n">01</span><h2>AMA KRI - Technology Health by Portfolio</h2><span class="note">Cell value = mean score (1-5) - delta vs Q4 2025</span></div>
                        <div class="t-scroll">
                            <table class="heat">
                                <thead>
                                    <tr>
                                        <th style="width:230px"></th>
                                        <template for:each={portfolioDimensions} for:item="dimension">
                                            <th key={dimension.key} class="rot">{dimension.label}</th>
                                        </template>
                                        <th class="rot">Apps</th>
                                        <th class="rot">Red</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template for:each={portfolioHeatmapRows} for:item="portfolio">
                                        <tr key={portfolio.name} class="portfolio-row-clickable" data-portfolio={portfolio.name} onclick={handlePortfolioOpen}>
                                            <td><div class="pf">{portfolio.name}</div></td>
                                            <template for:each={portfolio.scoreCells} for:item="cell">
                                                <td key={cell.key}>
                                                    <div class="cell" style={cell.style}>
                                                        {cell.score}
                                                        <span class="dd">{cell.delta}</span>
                                                    </div>
                                                </td>
                                            </template>
                                            <td><div class="cnt">{portfolio.count}</div></td>
                                            <td><div class={portfolio.redClass}>{portfolio.red}</div></td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <div class="grid g2 portfolio-overview-grid">
                        <section class="card">
                            <div class="card-h"><span class="n">02</span><h3>Enterprise Health Mix</h3></div>
                            <div class="stack">
                                <template for:each={enterpriseHealthStackSegments} for:item="segment">
                                    <div key={segment.label} style={segment.style}>{segment.value}</div>
                                </template>
                            </div>
                            <div class="legend">
                                <span class="legend-item">Red {enterprise.red} - &lt;2.5</span>
                                <span class="legend-item">Yellow {enterprise.yellow} - 2.5-3.5</span>
                                <span class="legend-item">Green {enterprise.green} - &gt;=3.5</span>
                            </div>
                            <div class="dimension-stack">
                                <template for:each={enterpriseDimensionRowsForView} for:item="dimension">
                                    <div key={dimension.label} class="dimrow">
                                        <div class="dl">{dimension.label}</div>
                                        <div class="dtrack"><div class="dfill" style={dimension.fillStyle}></div></div>
                                        <div class="dv">{dimension.value}</div>
                                        <div class="dd">{dimension.delta}</div>
                                    </div>
                                </template>
                            </div>
                        </section>

                        <section class="card">
                            <div class="card-h"><span class="n">03</span><h3>Portfolio Composition</h3></div>
                            <template for:each={compositionChartsForView} for:item="chart">
                                <div key={chart.title} class="composition-block">
                                    <div class="mini-title">{chart.title}</div>
                                    <div class="stack">
                                        <template for:each={chart.stackSegments} for:item="segment">
                                            <div key={segment.label} style={segment.style}>{segment.value}</div>
                                        </template>
                                    </div>
                                    <div class="legend">
                                        <template for:each={chart.legend} for:item="item">
                                            <span key={item.label} class="legend-item"><i style={item.indicatorStyle}></i>{item.label} {item.value}</span>
                                        </template>
                                    </div>
                                </div>
                            </template>
                        </section>
                    </div>

                    <template lwc:if={showMovement}>
                        <div class="grid g2 movers-grid-prototype">
                            <section class="card">
                                <div class="card-h"><span class="n">04</span><h3>Largest Decliners</h3><span class="note">vs Q4 2025</span></div>
                                <div class="t-scroll">
                                    <table>
                                        <thead>
                                            <tr><th>Application</th><th>BARR</th><th class="num">Was</th><th class="num">Now</th><th class="num">Delta</th></tr>
                                        </thead>
                                        <tbody>
                                            <template for:each={decliners} for:item="item">
                                                <tr key={item.name}>
                                                    <td><div class="t-name">{item.name}</div><div class="t-sub">{item.portfolio}</div></td>
                                                    <td>{item.barr}</td>
                                                    <td class="num">{item.was}</td>
                                                    <td class="num">{item.now}</td>
                                                    <td class="num negative-delta">{item.delta}</td>
                                                </tr>
                                            </template>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                            <section class="card">
                                <div class="card-h"><span class="n">05</span><h3>Largest Improvers</h3><span class="note">vs Q4 2025</span></div>
                                <div class="t-scroll">
                                    <table>
                                        <thead>
                                            <tr><th>Application</th><th>BARR</th><th class="num">Was</th><th class="num">Now</th><th class="num">Delta</th></tr>
                                        </thead>
                                        <tbody>
                                            <template for:each={improvers} for:item="item">
                                                <tr key={item.name}>
                                                    <td><div class="t-name">{item.name}</div><div class="t-sub">{item.portfolio}</div></td>
                                                    <td>{item.barr}</td>
                                                    <td class="num">{item.was}</td>
                                                    <td class="num">{item.now}</td>
                                                    <td class="num positive-delta">+{item.delta}</td>
                                                </tr>
                                            </template>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </div>
                    </template>

                    <template for:each={portfolioOverviewGroups} for:item="group">
                        <section key={group.label} class="portfolio-group-section">
                            <div class="eyebrow group-heading-prototype">{group.label}</div>
                            <div class="grid g4 portfolio-card-grid">
                                <template for:each={group.portfolios} for:item="portfolio">
                                    <article key={portfolio.name} class="card portfolio-summary-prototype portfolio-clickable" data-portfolio={portfolio.name} onclick={handlePortfolioOpen}>
                                        <div class="card-h portfolio-card-header">
                                            <h3>{portfolio.name}</h3>
                                            <span class="note">{portfolio.count} apps</span>
                                        </div>
                                        <div class="portfolio-overall-line">
                                            <span class="portfolio-overall-value" style={portfolio.overallStyle}>{portfolio.overallDisplay}</span>
                                            <span class="portfolio-overall-delta">{portfolio.overallDelta}</span>
                                        </div>
                                        <div class="stack compact-stack">
                                            <template for:each={portfolio.healthStackSegments} for:item="segment">
                                                <div key={segment.label} style={segment.style}>{segment.value}</div>
                                            </template>
                                        </div>
                                        <div class="portfolio-dimensions-prototype">
                                            <template for:each={portfolio.dimensionRows} for:item="dimension">
                                                <div key={dimension.label} class="dimrow compact-dimrow">
                                                    <div class="dl">{dimension.label}</div>
                                                    <div class="dtrack"><div class="dfill" style={dimension.fillStyle}></div></div>
                                                    <div class="dv">{dimension.value}</div>
                                                </div>
                                            </template>
                                        </div>
                                        <div class="portfolio-risk-summary">{portfolio.criticalHigh} Critical/High - <span class={portfolio.unhealthyClass}>{portfolio.unhealthyCriticalHigh} unhealthy</span></div>
                                    </article>
                                </template>
                            </div>
                        </section>
                    </template>
