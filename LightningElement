    @AuraEnabled
    public static ASP_StandardHighlightsDTO getStandardHighlights(String standardId) {
        try {
            ASP_Architecture_Standard__c standard = [
                SELECT
                    Id,
                    Name,
                    Active__c,
                    Classification__c,
                    Class__c,
                    Status__c,
                    Stage__c,
                    Effective_Date__c,
                    Next_Review_Due_Date__c,
                    Source_System_ID__c,
                    Retired_Date__c,
                    Withdrawn_Date__c,
                    Owner__r.Employee_ID__c,
                    Owner__r.Name,
                    Portfolio__r.Id,
                    Portfolio__r.Name,
                    Domain__r.Id,
                    Domain__r.Name
                FROM ASP_Architecture_Standard__c
                WHERE Id = :standardId  WITH SYSTEM_MODE
            ];

            if (standard == null) {
                throw new AuraHandledException('Standard not found.');
            }
            List<TPM_Stack_Layer_Config__c> stackLayers = [
                SELECT Supporting_Standard__r.Zephyr_Standard_ID__c, Id, Name, StackId__r.Id, StackId__r.Name
                FROM TPM_Stack_Layer_Config__c
                WHERE
                    Supporting_Standard__c != NULL
                    AND Supporting_Standard__r.Zephyr_Standard_ID__c = :standard.Source_System_ID__c
                    AND Inactive__C != TRUE  WITH SYSTEM_MODE
            ];

            ASP_AppliesToItem domainItem = standard.Domain__r.Id != null
                ? new ASP_AppliesToItem(standard.Domain__r.Id, standard.Domain__r.Name)
                : null;
            ASP_AppliesToItem portfolioItem = standard.Portfolio__r.Id != null
                ? new ASP_AppliesToItem(standard.Portfolio__r.Id, standard.Portfolio__r.Name)
                : null;

            List<ASP_AppliesToItem> stackLayerItems = new List<ASP_AppliesToItem>();

            //if we have stack layers, create a list of ASP_AppliesToItem objects for the payload / applies to popover data
            if (stackLayers.size() > 0) {
                for (TPM_Stack_Layer_Config__c stackLayer : stackLayers) {
                    stackLayerItems.add(new ASP_AppliesToItem(stackLayer.Id, stackLayer.Name));
                }
            }

            ASP_AppliesToDTO appliesToDTO = new ASP_AppliesToDTO(domainItem, portfolioItem, stackLayerItems);
            ASP_ClassificationDTO classificationDTO = new ASP_ClassificationDTO(
                standard.Classification__c,
                standard.Class__c
            );

            String userId = UserInfo.getUserId();
            List<String> userPermissionSets = getUserPermissionSets(userId);
            String employeeNumber = getUserEmployeeNumber(userId);
            List<String> userStandardAuthorAssignments = getUserStandardAuthorAssignmentsByEmployeeNumber(
                employeeNumber
            );
            List<String> userStandardAcknowledgerAssignments = getUserStandardAcknowledgerAssignmentsByEmployeeNumber(
                employeeNumber
            );

            Boolean userCanViewStandardUnapprovedChanges = userCanViewStandardUnapprovedChanges(
                standard,
                employeeNumber,
                userPermissionSets,
                userStandardAuthorAssignments,
                userStandardAcknowledgerAssignments
            );

            ASP_StatusDTO statusDTO = getStatus(standard, userCanViewStandardUnapprovedChanges);

            List<ASP_USAAEmployeeDTO> additionalAuthors = new List<ASP_USAAEmployeeDTO>();
            // Get the standards author assignments
            List<ASP_Architecture_Standard_Author__c> authors = [
                SELECT Author__r.Employee_ID__c, Author__r.Name
                FROM ASP_Architecture_Standard_Author__c
                WHERE Standard__r.Id = :standardId  WITH SYSTEM_MODE
            ];

            for (ASP_Architecture_Standard_Author__c author : authors) {
                ASP_USAAEmployeeDTO authorDTO = new ASP_USAAEmployeeDTO(
                    author.Author__r.Name,
                    author.Author__r.Employee_ID__c
                );
                additionalAuthors.add(authorDTO);
            }

            ASP_StandardHighlightsDTO standardHighlights = new ASP_StandardHighlightsDTO(
                standard.Id,
                standard.Name,
                standard.Active__c,
                classificationDTO,
                standard.Status__c,
                standard.Stage__c,
                standard.Owner__r.Employee_ID__c,
                standard.Owner__r.Name,
                standard.Effective_Date__c,
                standard.Next_Review_Due_Date__c,
                appliesToDTO,
                statusDTO.overallStatus,
                statusDTO.revisionStatus,
                additionalAuthors,
                standard.Retired_Date__c,
                standard.Withdrawn_Date__c
            );

            return standardHighlights;
        } catch (Exception e) {
            AuraHandledException ahex = new AuraHandledException('');
            ahex.setMessage('Failed to retrieve standard highlights.');
            throw ahex;
        }
    }

    @AuraEnabled
    public static ASP_StandardDetailsDTO getStandardDetails(String standardId) {
        try {
            String userId = UserInfo.getUserId();
            List<String> userPermissionSets = getUserPermissionSets(userId);
            String employeeNumber = getUserEmployeeNumber(userId);
            List<String> userStandardAuthorAssignments = getUserStandardAuthorAssignmentsByEmployeeNumber(
                employeeNumber
            );
            List<String> userStandardAcknowledgerAssignments = getUserStandardAcknowledgerAssignmentsByEmployeeNumber(
                employeeNumber
            );
            ASP_Architecture_Standard__c result = [
                SELECT Name, Executive_Summary__c, Overview__c, Standard__c, Rationale__c, Class__c, Status__c, Stage__c
                FROM ASP_Architecture_Standard__c
                WHERE Id = :standardId  WITH SYSTEM_MODE
            ];
            if (result.Status__c != 'Approved' && result.Status__c != 'Retired') {
                Boolean userCanViewStandardUnapprovedChanges = userCanViewStandardUnapprovedChanges(
                    result,
                    employeeNumber,
                    userPermissionSets,
                    userStandardAuthorAssignments,
                    userStandardAcknowledgerAssignments
                );
                if (!userCanViewStandardUnapprovedChanges) {
                    String exceptionMessage = 'You do not have access to this standard';
                    AuraHandledException e = new AuraHandledException(exceptionMessage);
                    e.setMessage(exceptionMessage);
                    throw e;
                }
            }
            return new ASP_StandardDetailsDTO(
                result.Name,
                result.Executive_Summary__c,
                result.Overview__c,
                result.Standard__c,
                result.Rationale__c
            );
        } catch (AuraHandledException e) {
            throw e;
        } catch (Exception e) {
            throw new AuraHandledException('Failed to retrieve standard details.');
        }
    }

    @AuraEnabled
    public static void updateStandardDetails(
        String standardId,
        String title,
        String executiveSummary,
        String overview,
        String standard,
        String rationale
    ) {
        try {
            ASP_Architecture_Standard__c standardToUpdate = [
                SELECT
                    Name,
                    Stage__c,
                    Class__c,
                    Executive_Summary__c,
                    Overview__c,
                    Standard__c,
                    Rationale__c,
                    Owner__r.Employee_ID__c
                FROM ASP_Architecture_Standard__c
                WHERE Id = :standardId  WITH SYSTEM_MODE
                LIMIT 1
            ];
            // Check if the user has permission to update the standard, pass in true for validation of stage
            Boolean canUpdate = userCanUpdate(standardToUpdate, true);
            if (canUpdate) {
                standardToUpdate.Name = title;
                standardToUpdate.Executive_Summary__c = executiveSummary;
                standardToUpdate.Overview__c = overview;
                standardToUpdate.Standard__c = standard;
                standardToUpdate.Rationale__c = rationale;
                if(!Schema.sObjectType.ASP_Architecture_Standard__c.isUpdateable()) {
                    throw new AuraHandledException('You  dont have permission to Update Architecture Standards ');
                }

                update standardToUpdate;
            } else {
                String exceptionMessage = 'You do not have access to edit this standard.';
                AuraHandledException e = new AuraHandledException(exceptionMessage);
                e.setMessage(exceptionMessage);
                throw e;
            }
        } catch (AuraHandledException e) {
            throw e;
        } catch (Exception e) {
            throw new AuraHandledException('Failed to update standard.');
        }
    }

