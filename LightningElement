import { LightningElement, api } from 'lwc';


export default class PlacematNav extends LightningElement {
    @api rows = [];

    handleCaret(event) {
        event.stopPropagation();
        this.dispatchEvent(
            new CustomEvent('navtoggle', {
                detail: { navId: event.currentTarget.dataset.navId }
            })
        );
    }

    handleSelect(event) {
        const { navId, navType } = event.currentTarget.dataset;
        this.dispatchEvent(new CustomEvent('navselect', { detail: { navId, navType } }));
    }
}
