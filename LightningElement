}


.kpi-red::before {
    background: var(--hub-red);
}


.kpi-yellow::before {
    background: var(--hub-yellow);
}


.kpi-green::before {
    background: var(--hub-green);
}


.kpi-label {
    font-size: 10px;

    color: var(--hub-muted);

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.8px;
}


.kpi-value {
    color: var(--hub-navy);

    font-family: Georgia, serif;

    font-size: 29px;

    font-weight: 700;

    margin:
        5px
        0
        1px;
}


.kpi-description {
    color: var(--hub-muted);

    font-size: 11px;
}


.change-positive,
.change-negative {
    margin-top: 7px;

    font-size: 10px;

    font-weight: 600;
}


.change-positive {
    color: var(--hub-green);
}


.change-negative {
    color: var(--hub-red);
}


/* ===============================
   DASHBOARD CARDS
   =============================== */

.dashboard-grid {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

    gap: 16px;

    margin-bottom: 16px;
}


.dashboard-card {
    background: var(--hub-card);

    border:
        1px solid var(--hub-border);

    border-radius: 8px;

    padding: 18px;

    margin-bottom: 16px;
}


.dashboard-grid .dashboard-card {
    margin-bottom: 0;
}


.card-header {
    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 10px;

    margin-bottom: 16px;
}


.card-link {
    color: var(--hub-muted);

    font-size: 11px;
}


/* ===============================
   HEALTH CARD
   =============================== */

.overall-score {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    margin-bottom: 18px;
}


.score {
    color: var(--hub-green);

    font-family: Georgia, serif;

    font-size: 38px;

    font-weight: 700;
}


.score-max {
    color: var(--hub-muted);

    font-size: 14px;
}


.score-description {
    color: var(--hub-muted);

    font-size: 11px;

    padding-bottom: 5px;
}


.health-summary {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 8px;
}


.health-row {
    display: flex;

    justify-content: space-between;

    align-items: center;

    background: #f8f9fb;

    border-radius: 5px;

    padding:
        9px
        10px;

    font-size: 12px;
}


.health-left {
    display: flex;

    align-items: center;

    gap: 6px;
}


.health-count {
    font-weight: 700;

    color: var(--hub-navy);
}


.health-dot {
    width: 8px;

    height: 8px;

    border-radius: 50%;
}


.red-dot {
    background: var(--hub-red);
}


.yellow-dot {
    background: var(--hub-yellow);
}


.green-dot {
    background: var(--hub-green);
}


.health-bar {
    display: flex;

    height: 9px;

    overflow: hidden;

    border-radius: 10px;

    margin-top: 15px;

    background: #e5e5e5;
}


.health-bar-red {
    background: var(--hub-red);
}


.health-bar-yellow {
    background: var(--hub-yellow);
}


.health-bar-green {
    background: var(--hub-green);
}


/* ===============================
   PRACTICE
   =============================== */

.practice-stat-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 12px;
}


.practice-stat {
    border:
        1px solid #e4e7eb;

    background: #fafbfc;

    border-radius: 6px;

    padding: 15px;
}


.practice-value {
    color: var(--hub-navy);

    font-family: Georgia, serif;

    font-size: 27px;

    font-weight: 700;
}


.practice-label {
    color: var(--hub-text);

    font-weight: 700;

    font-size: 12px;

    margin-top: 3px;
}


.practice-description {
    color: var(--hub-muted);

    font-size: 10px;

    margin-top: 4px;
}


/* ===============================
   DIMENSIONS
   =============================== */

.dimension-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap:
        18px
        28px;
}


.dimension-header {
    display: flex;

    justify-content: space-between;

    margin-bottom: 7px;

    font-size: 12px;

    color: var(--hub-muted);
}


.dimension-header strong {
    color: var(--hub-navy);
}


.progress-track {
    background: #e8eaed;

    height: 8px;

    border-radius: 10px;

    overflow: hidden;
}


.progress-value {
    height: 100%;

    border-radius: 10px;
}


.progress-green {
    background: var(--hub-green);
}


/* ===============================
   DATA FLOW
   =============================== */

.status-pill {
    background: #fff4cc;

    color: #7a5d00;

    border-radius: 14px;

    padding:
        3px
        9px;

    font-size: 10px;

    font-weight: 700;
}


.data-flow {
    display: flex;

    align-items: center;

    gap: 14px;
}


.data-node {
    flex: 1;

    background: #f8f9fb;

    border:
        1px solid var(--hub-border);

    border-radius: 6px;

    padding: 14px;
}


.data-node-label {
    display: block;

    color: var(--hub-muted);

    font-size: 9px;

    letter-spacing: 1px;

    font-weight: 700;

    margin-bottom: 3px;
}


.data-node strong {
    color: var(--hub-navy);

    font-size: 12px;
}


.data-arrow {
    color: var(--hub-blue);

    font-size: 20px;

    font-weight: 700;
}


/* ===============================
   PLACEHOLDER
   =============================== */

.placeholder {
    background: white;

    border:
        1px solid var(--hub-border);

    border-radius: 8px;

    min-height: 450px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 40px;
}


.placeholder-icon {
    margin-bottom: 18px;
}


.placeholder p {
    max-width: 500px;

    color: var(--hub-muted);

    margin:
        10px
        0
        20px;
}


.back-button {
    border: 0;

    border-radius: 5px;

    background: var(--hub-navy);

    color: white;

    padding:
        8px
        16px;

    cursor: pointer;

    font-weight: 600;
}


/* ===============================
   RESPONSIVE
   =============================== */

@media only screen and (max-width: 1200px) {

    .kpi-grid {
        grid-template-columns:
            repeat(3, 1fr);
    }

}


@media only screen and (max-width: 900px) {

    .architecture-hub {
        grid-template-columns: 1fr;
    }

    .sidebar {
        min-height: auto;
    }

    .navigation {
        padding-bottom: 12px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .kpi-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media only screen and (max-width: 600px) {

    .main-content {
        padding: 18px;
    }

    .header-row {
        flex-direction: column;
    }

    .cycle-container {
        text-align: left;
    }

    .kpi-grid {
        grid-template-columns: 1fr;
    }

    .practice-stat-grid,
    .health-summary,
    .dimension-grid {
        grid-template-columns: 1fr;
    }

    .data-flow {
        flex-direction: column;

        align-items: stretch;
    }

    .data-arrow {
        transform: rotate(90deg);

        text-align: center;
    }

}
