
Map<String, Object> result =
    TpmArchitectureHubController.getAssessmentData(
        '{"assessmentPeriod":"Q12021"}'
    );

List<Map<String, Object>> rows =
    (List<Map<String, Object>>) result.get('records');

Map<String, Integer> timeCounts =
    new Map<String, Integer>();

for (Map<String, Object> row : rows) {

    Object rawValue = row.get('time');

    String timeValue =
        rawValue == null ||
        String.isBlank(String.valueOf(rawValue))
        ? '(Blank)'
        : String.valueOf(rawValue).trim();

    Integer count =
        timeCounts.containsKey(timeValue)
        ? timeCounts.get(timeValue)
        : 0;

    timeCounts.put(timeValue, count + 1);
}

List<String> categories =
    new List<String>(timeCounts.keySet());

categories.sort();

for (String category : categories) {
    System.debug(
        'HUB_TIME_VALUE=' + category +
        ' | COUNT=' + timeCounts.get(category)
    );
}
