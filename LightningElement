
Map<String, Object> result =
    TpmArchitectureHubController.getAssessmentData(
        '{"assessmentPeriod":"Q12021"}'
    );

Map<String, String> fields =
    (Map<String, String>) result.get('fields');

System.debug(
    'HUB_CATEGORY_FIELD=' + fields.get('category')
);

List<Map<String, Object>> rows =
    (List<Map<String, Object>>) result.get('records');

Map<String, Integer> categoryCounts =
    new Map<String, Integer>();

for (Map<String, Object> row : rows) {
    Object value = row.get('category');

    String category =
        value == null ||
        String.isBlank(String.valueOf(value))
        ? '(Blank)'
        : String.valueOf(value).trim();

    Integer count = categoryCounts.containsKey(category)
        ? categoryCounts.get(category) : 0;

    categoryCounts.put(category, count + 1);
}

List<String> categories =
    new List<String>(categoryCounts.keySet());

categories.sort();

System.debug(
    'HUB_CATEGORY_DISTINCT=' + categories.size()
);

for (String category : categories) {
    System.debug(
        'HUB_CATEGORY=' + category +
        ' | COUNT=' + categoryCounts.get(category)
    );
}
