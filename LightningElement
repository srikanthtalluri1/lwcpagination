import { LightningElement, api } from 'lwc';

export default class PlacematGroupCard extends LightningElement {
    /** Fully shaped group object from placematData.buildGroups() */
    @api group = {};

    /** true when this card is the only one on screen (focus mode) */
    @api focused = false;

    get cardClass() {
        return this.focused ? 'group-card is-focused' : 'group-card';
    }

    get bodyClass() {
        return this.focused ? 'group-body is-focused' : 'group-body';
    }

    /**
     * In focus mode the columns stack instead of sitting on the computed
     * grid track list, so the inline grid-template-columns is dropped.
     * Returning undefined removes the style attribute entirely.
     */
    get bodyStyleAttr() {
        return this.focused ? undefined : this.group.bodyStyle;
    }

    handleFocus() {
        this.dispatchEvent(
            new CustomEvent('groupfocus', { detail: { groupNum: this.group.num } })
        );
    }
}
