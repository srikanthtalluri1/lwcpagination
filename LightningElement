                </template>
            </div>
        </section>
    </template>

    <template if:true={isPlatformPage}>
        <div class={shellClass}>
            <aside class={sideNavClass}>
                <button class="brand" onclick={handlePortfolioHome} title="Back to enterprise capability portfolio">
                    <span class="brand-badge">USAA</span>
                    <span class="brand-title">CAPABILITY MODEL</span>
                </button>

                <div class="nav-section">
                    <button class="nav-root-button" onclick={handlePlatformHome}>Public Cloud</button>
