@AuraEnabled
public static List<ASP_StackLayerDTO> getStackLayersAppliedToStandards() {
    try {
        Set<String> standardSourceIds = new Set<String>();

        List<ASP_Architecture_Standard__c> standards = [
            SELECT Source_System_ID__c
            FROM ASP_Architecture_Standard__c
            WHERE Source_System_ID__c != null
            WITH SYSTEM_MODE
        ];

        for (ASP_Architecture_Standard__c standard : standards) {
            standardSourceIds.add(standard.Source_System_ID__c);
        }

        if (standardSourceIds.isEmpty()) {
            return new List<ASP_StackLayerDTO>();
        }

        List<TPM_Stack_Layer_Config__c> results = [
            SELECT Id, Name, StackId__r.Id, StackId__r.Name
            FROM TPM_Stack_Layer_Config__c
            WHERE Supporting_Standard__c != null
            AND Supporting_Standard__r.Zephyr_Standard_ID__c IN :standardSourceIds
            AND Inactive__c != TRUE
            WITH SYSTEM_MODE
        ];

        Map<String, ASP_StackLayerDTO> stackLayers =
            new Map<String, ASP_StackLayerDTO>();

        for (TPM_Stack_Layer_Config__c result : results) {
            stackLayers.put(
                result.Id,
                new ASP_StackLayerDTO(
                    result.Id,
                    result.Name,
                    new ASP_StackDTO(
                        result.StackId__r.Id,
                        result.StackId__r.Name
                    )
                )
            );
        }

        return stackLayers.values();

    } catch (Exception e) {
        throw new AuraHandledException(
            'Failed to retrieve stack layers.'
        );
    }
}
