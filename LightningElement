    loadRecords(isNextPage = false) {
        this.isLoading = true;
        this.errorMessage = '';

        getStackLayJunction({
            pageSize: Number(this.pageSize),
            lastAppName: this.lastAppName,
            lastRecordId: this.lastRecordId,
            ownedBy: this.ownedBy,
            searchKey: this.query
        })
            .then((result) => {
                const returnedRows = result?.rows || [];

                this.rows = returnedRows.map((row) => ({
                    ...row,
                    id: row.Id,
                    appId:
                        row.appId ||
                        row.appName ||
                        row.Id,
                    appName: row.appName || '',
                    status: row.operationalStatus || '',
                    paamManual: row.paamManual || '',
                    paamDiscovered:
                        row.paamDiscovered || '',
                    manualStatus: row.manualStatus || '',
                    discoveredStatus:
                        row.discoveredStatus || '',
                        forceInSync: row.forceInSync === true
                }));

                this.hasMore =
                    result?.hasMore === true;

                this.totalRecordCount =
                    result?.totalRecords || 0;

                this.lastAppName =
                    result?.lastAppName || null;

                this.lastRecordId =
                    result?.lastRecordId || null;

                if (
                    isNextPage &&
                    returnedRows.length > 0
                ) {
                    this.page += 1;
                }
            })
            .catch((error) => {
                console.error(
                    'Error loading records:',
                    error
                );

                this.errorMessage =
                    error?.body?.message ||
                    error?.message ||
                    'Unable to load records.';
            })
            .finally(() => {
                this.isLoading = false;
            });
    }

