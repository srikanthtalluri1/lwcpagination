<template>
    <nav class="side-nav" part="side-nav">
        <div class="nav-head">
            <span class="nav-head-title">Capability Model</span>
        </div>

        <div class="nav-body">
            <!--
                Flat list, not a recursive template. Each row carries its own
                level, indent style and css class, computed in placematData.
            -->
            <template for:each={rows} for:item="row">
                <div key={row.id} class={row.cssClass} style={row.style}>
                    <template lwc:if={row.hasChildren}>
                        <button
                            class={row.caretClass}
                            type="button"
                            data-nav-id={row.navId}
                            aria-expanded={row.expanded}
                            title="Expand or collapse"
                            onclick={handleCaret}
                        >
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                                 stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                                <path d="M9 6l6 6-6 6"></path>
                            </svg>
                        </button>
                    </template>
                    <template lwc:else>
                        <span class="nav-caret-spacer"></span>
                    </template>

                    <button
                        class="nav-label"
                        type="button"
                        data-nav-id={row.navId}
                        data-nav-type={row.navType}
                        onclick={handleSelect}
                    >
                        {row.label}
                        <template lwc:if={row.isWip}>
                            <span class="nav-wip">WIP</span>
                        </template>
                    </button>
                </div>
            </template>
        </div>
    </nav>
</template>
