
Set<String> domains = new Set<String>();

for (TPM_Assessment__c rec : [
    SELECT App__r.Domain_Name__c
    FROM TPM_Assessment__c
    WHERE Assessment_Period_Quarter_Year__c = 'Q12020'
]) {
    if (rec.App__r != null &&
        String.isNotEmpty(rec.App__r.Domain_Name__c)) {
        domains.add(rec.App__r.Domain_Name__c);
    }
}

System.debug('TOTAL DISTINCT DOMAINS = ' + domains.size());
