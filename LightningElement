    @AuraEnabled
    public static ASP_SnapshotContentDTO getLatestSnapshot(String standardId) {
        try {
            List<ASP_Architecture_Standard_Snapshot__c> results = [
                SELECT Executive_Summary__c, Overview__c, Standard__c, Rationale__c
                FROM ASP_Architecture_Standard_Snapshot__c
                WHERE Architecture_Standard__c = :standardId WITH SYSTEM_MODE
                ORDER BY CreatedDate DESC  LIMIT 1
            ];

            if (results.IsEmpty()) {
                String exceptionMessage = 'Standard has no snapshots.';
                AuraHandledException e = new AuraHandledException(exceptionMessage);
                e.setMessage(exceptionMessage);
                throw e;
            } else {
                ASP_Architecture_Standard_Snapshot__c snapshot = results.get(0);
                return new ASP_SnapshotContentDTO(
                    snapshot.Executive_Summary__c,
                    snapshot.Overview__c,
                    snapshot.Standard__c,
                    snapshot.Rationale__c
                );
            }
        } catch (AuraHandledException e) {
            throw e; // Rethrow the "Standard has no snapshots." exception if that was the exception that occurred
        } catch (Exception e) {
            throw new AuraHandledException('Failed to retrieve latest standard snapshot.');
        }
    }

