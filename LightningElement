
Schema.SObjectType portType =
    Schema.getGlobalDescribe().get('TPM_Port__c');

if (portType == null) {
    System.debug('HUB_PORT_OBJECT_NOT_FOUND');
} else {
    System.debug('HUB_PORT_OBJECT=TPM_Port__c');

    for (Schema.SObjectField field :
         portType.getDescribe().fields.getMap().values()) {

        Schema.DescribeFieldResult d =
            field.getDescribe();

        String searchText =
            (d.getName() + ' ' + d.getLabel())
            .toLowerCase();

        if (searchText.contains('group') ||
            searchText.contains('category') ||
            searchText.contains('portfolio') ||
            searchText.contains('division') ||
            searchText.contains('segment') ||
            searchText.contains('parent') ||
            searchText.contains('company')) {

            System.debug(
                'HUB_PORT_FIELD=' + d.getName() +
                ' | LABEL=' + d.getLabel() +
                ' | TYPE=' + d.getType()
            );
        }
    }
}
