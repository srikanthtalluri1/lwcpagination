    public static Map<String, Object> getAssessmentData(String filtersJson) {
        return getAssessmentObjectData(filtersJson);
    }

    // The period field is a formula and cannot be used in GROUP BY. This read-only
    // SOQL-for loop visits records in batches (rather than loading all SObjects
    // into a List) and gathers the distinct, properly formatted cycle codes.
    // Normal Apex 50,000 queried-row governor limit still applies. If the valid
    // assessment population grows beyond that, use a persisted cycle index.
    public static List<Map<String, Object>> getAvailableCycles() {
        Schema.DescribeSObjectResult assessmentDescribe = describeAssessmentObject();
        String periodField = resolvePeriodField(assessmentDescribe.fields.getMap());
        if (periodField != 'Assessment_Period_Quarter_Year__c') {
            // In this org the verified assessment-period formula has this API name.
            // Fail explicitly rather than silently querying a different field.
            throw handledError('Unexpected assessment period field: ' + periodField);
        }
        Map<String, Integer> counts = new Map<String, Integer>();
        for (TPM_Assessment__c assessment : [
            SELECT Assessment_Period_Quarter_Year__c
            FROM TPM_Assessment__c
            WHERE Assessment_Period_Quarter_Year__c != null
              AND Assessment_Period_Quarter_Year__c != '0'
            WITH USER_MODE
        ]) {
            String period = assessment.Assessment_Period_Quarter_Year__c;
            if (!isValidCycleCode(period)) {
                continue;
            }
            period = period.trim().toUpperCase();
            Integer currentCount = counts.containsKey(period) ? counts.get(period) : 0;
            counts.put(period, currentCount + 1);
        }
        return sortCycleCounts(counts);
    }

    @TestVisible
    private static Boolean isValidCycleCode(String cycleCode) {
        if (String.isBlank(cycleCode)) {
            return false;
        }
        String trimmed = cycleCode.trim().toUpperCase();
        // Support both quarter-coded (Q42024) and established year-only (2019) cycles.
        return Pattern.matches('^Q[1-4](19|20)[0-9]{2}$', trimmed) ||
            Pattern.matches('^(19|20)[0-9]{2}$', trimmed);
    }

    @TestVisible
    private static List<Map<String, Object>> sortCycleCounts(Map<String, Integer> counts) {
        List<String> sortKeys = new List<String>();
        for (String period : counts.keySet()) {
            String normalized = period.trim().toUpperCase();
            String year = normalized.startsWith('Q') ? normalized.substring(2) : normalized;
            String quarter = normalized.startsWith('Q') ? normalized.substring(1, 2) : '0';
            sortKeys.add(year + quarter + ':' + normalized);
        }
        sortKeys.sort();
        List<Map<String, Object>> response = new List<Map<String, Object>>();
        for (Integer index = sortKeys.size() - 1; index >= 0; index--) {
            String code = sortKeys[index].substring(6);
            response.add(new Map<String, Object>{
                'period' => code,
                'count' => counts.get(code)
            });
        }
        return response;
    }

    public static Map<String, Object> getPortfolioDetailData(String portfolioName) {
        String normalizedPortfolio = String.isBlank(portfolioName) ? '' : portfolioName.trim();
        return new Map<String, Object>{
            'portfolioName' => normalizedPortfolio,
            'risks' => queryPortfolioRiskRows(normalizedPortfolio),
            'waivers' => queryPortfolioWaiverRows(normalizedPortfolio),
            'initiatives' => queryPortfolioInitiativeRows(normalizedPortfolio),
            'decisions' => queryPortfolioDecisionRows(normalizedPortfolio)
        };
    }

    private static Map<String, Object> getAssessmentObjectData(String filtersJson) {
        Schema.DescribeSObjectResult objectDescribe = describeAssessmentObject();
        Map<String, Schema.SObjectField> availableFields = objectDescribe.fields.getMap();
        Map<String, String> mappedFields = resolveFields(availableFields);
        String periodField = resolvePeriodField(availableFields);
        requireApplicationField(mappedFields);
        mappedFields.put('assessmentPeriod', periodField);

        Map<String, Object> filters = parseFilters(filtersJson);

        // The period to query: whatever the UI sent, else the default. One bounded SOQL for that
        // single period keeps us within governor limits on this 30k+ row object. Periods are not
        // auto-discovered here: the period field is a formula and cannot be GROUP BY'd, and scanning
        // every row just to list periods would be wasteful — the LWC owns the selectable list.
        String activePeriod = resolveActivePeriod(filters);

        QuerySpec querySpec = buildQuery(mappedFields, availableFields, filters, activePeriod);
        List<SObject> queriedRows = queryPeriod(mappedFields, querySpec);
        List<Map<String, Object>> records = normalizeRows(queriedRows, mappedFields);
        return new Map<String, Object>{
            'objectApiName' => objectDescribe.getName(),
            'assessmentPeriod' => activePeriod,
            'fields' => mappedFields,
            'records' => records,
            'rowCount' => records.size()
        };
    }

    private static Map<String, Object> getPortfolioData(String filtersJson) {
        Schema.DescribeSObjectResult objectDescribe = describeObject(PORTFOLIO_OBJECT);
        Map<String, Schema.SObjectField> availableFields = objectDescribe.fields.getMap();
        Map<String, String> mappedFields = new Map<String, String>();
        for (String outputName : FIELD_ALIASES.keySet()) {
            String fieldName = resolveField(availableFields, FIELD_ALIASES.get(outputName));
            if (fieldName != null) {
                mappedFields.put(outputName, fieldName);
            }
        }
        if (mappedFields.isEmpty() || String.isBlank(mappedFields.get('name')) || String.isBlank(mappedFields.get('overall'))) {
            return getAssessmentObjectData(filtersJson);
        }
        Map<String, Object> filters = parseFilters(filtersJson);
        QuerySpec querySpec = new QuerySpec();
        querySpec.mappedFields = mappedFields;
        querySpec.availableFields = availableFields;
        String nameField = mappedFields.get('name');
        querySpec.conditions.add(nameField + ' != null');
        addExactFilter(querySpec, 'portfolio', filterValue(filters, 'portfolio'));
        addExactFilter(querySpec, 'status', filterValue(filters, 'status'));
        addExactFilter(querySpec, 'rag', filterValue(filters, 'health'));
        addSearchFilter(querySpec, filterValue(filters, 'searchTerm'));
        List<SObject> queriedRows = queryPortfolioRows(querySpec, objectDescribe.getName(), mappedFields.get('name'));
        List<Map<String, Object>> records = normalizeRows(queriedRows, mappedFields);
        return new Map<String, Object>{
            'objectApiName' => objectDescribe.getName(),
            'assessmentPeriod' => null,
            'fields' => mappedFields,
            'records' => records,
            'rowCount' => records.size()
        };
    }

    // Decide which period to actually query: explicit period from the UI, else the default.
    // No validation against a discovered list — the period field is a formula (not groupable),
    // so we don't scan the object to enumerate periods. An unknown period simply returns no rows.
    private static String resolveActivePeriod(Map<String, Object> filters) {
        String requested = filterValue(filters, 'assessmentPeriod');
        if (String.isBlank(requested)) {
            requested = filterValue(filters, 'cycle');
        }
        if (!String.isBlank(requested)) {
            return requested.trim();
        }
        return DEFAULT_ASSESSMENT_PERIOD;
    }

    private static Map<String, String> resolveFields(Map<String, Schema.SObjectField> availableFields) {
        Map<String, String> mappedFields = new Map<String, String>();
        for (String outputName : FIELD_ALIASES.keySet()) {
            String apiName = resolveField(availableFields, FIELD_ALIASES.get(outputName));
            if (apiName != null) {
                mappedFields.put(outputName, apiName);
            }
        }
        return mappedFields;
    }

    private static String resolvePeriodField(Map<String, Schema.SObjectField> availableFields) {
        if (Test.isRunningTest() && !String.isBlank(periodFieldOverride)) {
            Schema.SObjectField overrideField = availableFields.get(periodFieldOverride);
            if (overrideField != null && overrideField.getDescribe().isAccessible()) {
                return overrideField.getDescribe().getName();
            }
        }
        List<String> aliases = new List<String>{
            'Assessment_Period_Quarter_Year__c', 'Assessment_Period_Quarter_Year',
            'Assessment_Period__c', 'AssessmentPeriod__c', 'Assessment_Cycle__c',
            'Assessment Period', 'Assessment Period Name', 'Assessment Cycle'
        };
        String fieldName = resolveField(availableFields, aliases);
        if (fieldName == null) {
            throw handledError('TPM_Assessment__c is missing an accessible assessment period field.');
        }
        return fieldName;
    }

    private static String resolveField(Map<String, Schema.SObjectField> availableFields, List<String> aliases) {
        for (String alias : aliases) {
            String fieldPath = resolveFieldPath(availableFields, alias);
            if (fieldPath != null) {
                return fieldPath;
            }
        }

        Set<String> normalizedAliases = new Set<String>();
        for (String alias : aliases) {
            if (!String.isBlank(alias) && !alias.contains('.')) {
                normalizedAliases.add(normalize(alias));
            }
        }
        for (Schema.SObjectField token : availableFields.values()) {
            Schema.DescribeFieldResult fieldDescribe = token.getDescribe();
            if (fieldDescribe.isAccessible() &&
                (normalizedAliases.contains(normalize(fieldDescribe.getName())) ||
                normalizedAliases.contains(normalize(fieldDescribe.getLabel())))) {
                return fieldDescribe.getName();
            }
        }
        return null;
    }

    private static String resolveFieldPath(Map<String, Schema.SObjectField> availableFields, String alias) {
        if (String.isBlank(alias)) {
            return null;
        }
        if (!alias.contains('.')) {
            Schema.SObjectField directField = availableFields.get(alias);
            if (directField != null && directField.getDescribe().isAccessible()) {
                return directField.getDescribe().getName();
            }
            return null;
        }

        List<String> segments = alias.split('\\.');
        Map<String, Schema.SObjectField> currentFields = availableFields;
        String resolvedPath = '';
        for (Integer index = 0; index < segments.size(); index++) {
            String segment = segments[index];
            Boolean isLeaf = index == segments.size() - 1;
            if (isLeaf) {
                Schema.SObjectField leafField = currentFields.get(segment);
                if (leafField == null || !leafField.getDescribe().isAccessible()) {
                    return null;
                }
                return String.isBlank(resolvedPath)
                    ? leafField.getDescribe().getName()
                    : resolvedPath + '.' + leafField.getDescribe().getName();
            }

            Schema.SObjectField relationshipField = findFieldForRelationship(currentFields, segment);
            if (relationshipField == null) {
                return null;
            }
            Schema.DescribeFieldResult relationshipDescribe = relationshipField.getDescribe();
            if (!relationshipDescribe.isAccessible() ||
                relationshipDescribe.getType() != Schema.DisplayType.Reference ||
                relationshipDescribe.getReferenceTo().isEmpty() ||
                String.isBlank(relationshipDescribe.getRelationshipName())) {
                return null;
            }
            resolvedPath = String.isBlank(resolvedPath)
                ? relationshipDescribe.getRelationshipName()
                : resolvedPath + '.' + relationshipDescribe.getRelationshipName();
            currentFields = relationshipDescribe.getReferenceTo()[0].getDescribe().fields.getMap();
        }
        return null;
    }

    private static Schema.SObjectField findFieldForRelationship(
        Map<String, Schema.SObjectField> availableFields,
        String relationshipName
    ) {
        for (Schema.SObjectField token : availableFields.values()) {
            Schema.DescribeFieldResult fieldDescribe = token.getDescribe();
            if (fieldDescribe.isAccessible() && fieldDescribe.getRelationshipName() == relationshipName) {
                return token;
            }
        }
        return null;
    }

    private static String normalize(String value) {
        return value == null ? '' : value.toLowerCase().replaceAll('[^a-z0-9]', '');
    }

    private static void requireApplicationField(Map<String, String> mappedFields) {
        if (!mappedFields.containsKey('name')) {
            throw handledError('TPM_Assessment__c needs an accessible Application Name or Name field.');
        }
    }

    private static List<String> selectFields(Map<String, String> mappedFields) {
        Set<String> uniqueFields = new Set<String>{ 'Id' };
        for (String outputName : mappedFields.keySet()) {
            if (outputName != 'assessmentPeriod') {
                uniqueFields.add(mappedFields.get(outputName));
            }
        }
        return new List<String>(uniqueFields);
    }

    private static QuerySpec buildQuery(
        Map<String, String> mappedFields,
        Map<String, Schema.SObjectField> availableFields,
        Map<String, Object> filters,
        String activePeriod
    ) {
        QuerySpec spec = new QuerySpec();
        spec.mappedFields = mappedFields;
        spec.availableFields = availableFields;
        spec.conditions.add(mappedFields.get('assessmentPeriod') + ' = :assessmentPeriod');
        spec.binds.put('assessmentPeriod', activePeriod);
        addExactFilter(spec, 'portfolio', filterValue(filters, 'portfolio'));
        addExactFilter(spec, 'domain', filterValue(filters, 'domain'));
        addExactFilter(spec, 'barr', filterValue(filters, 'barr'));
        addExactFilter(spec, 'time', filterValue(filters, 'timeRecommendation'));
        addExactFilter(spec, 'rag', filterValue(filters, 'health'));
        addExactFilter(spec, 'status', filterValue(filters, 'status'));
        addSearchFilter(spec, filterValue(filters, 'searchTerm'));
        return spec;
    }

    private static Map<String, Object> parseFilters(String filtersJson) {
        if (String.isBlank(filtersJson)) {
            return new Map<String, Object>();
        }
        try {
            return (Map<String, Object>) JSON.deserializeUntyped(filtersJson);
        } catch (Exception error) {
            throw handledError('Explorer filters could not be read.');
        }
    }

    private static String filterValue(Map<String, Object> filters, String key) {
        Object value = filters.get(key);
        return value == null ? null : String.valueOf(value);
    }

    private static void addExactFilter(QuerySpec spec, String outputField, String filterValue) {
        String fieldName = spec.mappedFields.get(outputField);
        if (String.isBlank(filterValue) || String.isBlank(fieldName)) {
            return;
        }
        String bindName = 'filter_' + outputField;
        spec.conditions.add(fieldName + ' = :' + bindName);
        spec.binds.put(bindName, filterValue.trim());
    }

    private static void addSearchFilter(QuerySpec spec, String searchTerm) {
        if (String.isBlank(searchTerm)) {
            return;
        }
        List<String> searchFields = new List<String>();
        for (String outputField : new List<String>{ 'name', 'architect', 'owner', 'domain', 'category' }) {
            String fieldName = spec.mappedFields.get(outputField);
            if (isSearchableFieldPath(spec.availableFields, fieldName)) {
                searchFields.add(fieldName + ' LIKE :searchPattern');
            }
        }
        if (!searchFields.isEmpty()) {
            spec.conditions.add('(' + String.join(searchFields, ' OR ') + ')');
            spec.binds.put('searchPattern', '%' + searchTerm.trim() + '%');
        }
    }

    private static Boolean isSearchableFieldPath(
        Map<String, Schema.SObjectField> availableFields,
        String fieldPath
    ) {
        Schema.DescribeFieldResult fieldDescribe = describeLeafField(availableFields, fieldPath);
        if (fieldDescribe == null) {
            return false;
        }
        Schema.DisplayType fieldType = fieldDescribe.getType();
        return fieldType == Schema.DisplayType.String ||
            fieldType == Schema.DisplayType.TextArea ||
            fieldType == Schema.DisplayType.Email ||
            fieldType == Schema.DisplayType.Phone ||
            fieldType == Schema.DisplayType.Url;
    }

    private static Schema.DescribeFieldResult describeLeafField(
        Map<String, Schema.SObjectField> availableFields,
        String fieldPath
    ) {
        if (String.isBlank(fieldPath)) {
            return null;
        }
        if (!fieldPath.contains('.')) {
            Schema.SObjectField fieldToken = availableFields.get(fieldPath);
            return fieldToken == null ? null : fieldToken.getDescribe();
        }
        List<String> segments = fieldPath.split('\\.');
        Map<String, Schema.SObjectField> currentFields = availableFields;
        for (Integer index = 0; index < segments.size(); index++) {
            String segment = segments[index];
            Boolean isLeaf = index == segments.size() - 1;
            if (isLeaf) {
                Schema.SObjectField fieldToken = currentFields.get(segment);
                return fieldToken == null ? null : fieldToken.getDescribe();
            }
            Schema.SObjectField relationshipField = findFieldForRelationship(currentFields, segment);
            if (relationshipField == null) {
                return null;
            }
            Schema.DescribeFieldResult relationshipDescribe = relationshipField.getDescribe();
            if (relationshipDescribe.getReferenceTo().isEmpty()) {
                return null;
            }
            currentFields = relationshipDescribe.getReferenceTo()[0].getDescribe().fields.getMap();
        }
        return null;
    }

    private static List<SObject> queryPeriod(Map<String, String> mappedFields, QuerySpec spec) {
        Schema.DescribeSObjectResult objectDescribe = describeAssessmentObject();
        List<String> selectFields = selectFields(mappedFields);
        String queryString = 'SELECT ' + String.join(selectFields, ',') +
            ' FROM ' + objectDescribe.getName() +
            ' WHERE ' + String.join(spec.conditions, ' AND ') +
            ' ORDER BY ' + mappedFields.get('name') +
            ' LIMIT :rowLimit';
        spec.binds.put('rowLimit', MAX_ROWS);
        return Database.queryWithBinds(
            queryString,
            spec.binds,
            AccessLevel.USER_MODE
        );
    }

    private static List<SObject> queryPortfolioRows(QuerySpec spec, String objectName, String orderField) {
        List<String> selectFields = selectFields(spec.mappedFields);
        String queryString = 'SELECT ' + String.join(selectFields, ',') +
            ' FROM ' + objectName +
            ' WHERE ' + String.join(spec.conditions, ' AND ') +
            ' ORDER BY ' + orderField +
            ' LIMIT :rowLimit';
        spec.binds.put('rowLimit', MAX_ROWS);
        return Database.queryWithBinds(
            queryString,
            spec.binds,
            AccessLevel.USER_MODE
        );
    }

    private static Boolean hasPortfolioObjectData() {
        try {
            Schema.DescribeSObjectResult objectDescribe = describeObject(PORTFOLIO_OBJECT);
            Map<String, Schema.SObjectField> availableFields = objectDescribe.fields.getMap();
            return resolveField(availableFields, new List<String>{ 'Port_Name__c', 'Name' }) != null &&
                resolveField(availableFields, new List<String>{ 'Port_Current_Overall_Rating__c', 'Current_Overall_Rating__c' }) != null;
        } catch (Exception error) {
            return false;
        }
    }

    private static List<Map<String, Object>> queryPortfolioRiskRows(String portfolioName) {
        if (String.isBlank(portfolioName)) {
            return new List<Map<String, Object>>();
        }
        List<App_Risk_Ranking__c> rows = [
            SELECT Id, Name, App_Name__c, Risk_Level__c, Risk_Rating_Score__c, TPM_Portfolio__c
            FROM App_Risk_Ranking__c
            WHERE TPM_Portfolio__c != null
            ORDER BY Risk_Rating_Score__c DESC, LastModifiedDate DESC
            LIMIT 25
        ];

        List<SObject> sourceRows = new List<SObject>();
        sourceRows.addAll(rows);
        sourceRows = filterPortfolioRows(sourceRows, portfolioName, new List<String>{ 'TPM_Portfolio__c', 'App_Name__c', 'Name' });
        return normalizePortfolioRecords(sourceRows, new List<String>{ 'Id', 'Name', 'App_Name__c', 'Risk_Level__c', 'Risk_Rating_Score__c', 'TPM_Portfolio__c' });
    }

    private static List<Map<String, Object>> queryPortfolioWaiverRows(String portfolioName) {
        if (String.isBlank(portfolioName)) {
            return new List<Map<String, Object>>();
        }
        List<AWP_Architecture_Waiver_Form__c> rows = [
            SELECT Id, Name, Status__c, Application_Name__c, Requesting_Portfolio__c, Affected_Portfolio__c, Approved_Date__c
            FROM AWP_Architecture_Waiver_Form__c
            WHERE Requesting_Portfolio__c != null OR Affected_Portfolio__c != null
            ORDER BY LastModifiedDate DESC
            LIMIT 25
        ];

        List<SObject> sourceRows = new List<SObject>();
        sourceRows.addAll(rows);
        sourceRows = filterPortfolioRows(sourceRows, portfolioName, new List<String>{ 'Requesting_Portfolio__c', 'Affected_Portfolio__c', 'Application_Name__c', 'Name' });
        return normalizePortfolioRecords(sourceRows, new List<String>{ 'Id', 'Name', 'Status__c', 'Application_Name__c', 'Requesting_Portfolio__c', 'Affected_Portfolio__c', 'Approved_Date__c' });
    }

    private static List<Map<String, Object>> queryPortfolioInitiativeRows(String portfolioName) {
        if (String.isBlank(portfolioName)) {
            return new List<Map<String, Object>>();
        }
        List<CTO_Initiatives__c> rows = [
            SELECT Id, Name, Status__c, Priority__c, Related_To__c, Affected_Domain__c, Primary_Domain__c, Initiative_Owner__c
            FROM CTO_Initiatives__c
            WHERE Name != null OR Related_To__c != null OR Affected_Domain__c != null OR Primary_Domain__c != null
            ORDER BY LastModifiedDate DESC
            LIMIT 25
        ];

        List<SObject> sourceRows = new List<SObject>();
        sourceRows.addAll(rows);
        sourceRows = filterPortfolioRows(sourceRows, portfolioName, new List<String>{ 'Name', 'Related_To__c', 'Affected_Domain__c', 'Primary_Domain__c', 'Initiative_Owner__c' });
        return normalizePortfolioRecords(sourceRows, new List<String>{ 'Id', 'Name', 'Status__c', 'Priority__c', 'Related_To__c', 'Affected_Domain__c', 'Primary_Domain__c', 'Initiative_Owner__c' });
    }

    private static List<Map<String, Object>> queryPortfolioDecisionRows(String portfolioName) {
        if (String.isBlank(portfolioName)) {
            return new List<Map<String, Object>>();
        }
        List<TechnologyDecision__c> rows = [
            SELECT Id, Name, Status__c, Decision_Type__c, Category__c, Decision_Summary__c, Decision_Notes__c, Actual_Decision_Date__c
            FROM TechnologyDecision__c
            WHERE Id != null
            ORDER BY LastModifiedDate DESC
            LIMIT 25
        ];

        List<SObject> sourceRows = new List<SObject>();
        sourceRows.addAll(rows);
        sourceRows = filterPortfolioRows(sourceRows, portfolioName, new List<String>{ 'Name', 'Decision_Summary__c', 'Decision_Notes__c', 'Category__c', 'Decision_Type__c' });
        return normalizePortfolioRecords(sourceRows, new List<String>{ 'Id', 'Name', 'Status__c', 'Decision_Type__c', 'Category__c', 'Decision_Summary__c', 'Decision_Notes__c', 'Actual_Decision_Date__c' });
    }

    private static List<SObject> filterPortfolioRows(List<SObject> rows, String portfolioName, List<String> checkFields) {
        if (rows == null || rows.isEmpty() || String.isBlank(portfolioName)) {
            return rows == null ? new List<SObject>() : rows;
        }
        String normalizedPortfolio = portfolioName.trim().toLowerCase();
        List<SObject> filtered = new List<SObject>();
        for (SObject row : rows) {
            for (String fieldName : checkFields) {
                Object value = row.get(fieldName);
                if (value == null) {
                    continue;
                }
                String fieldValue = String.valueOf(value).trim();
                if (fieldValue.toLowerCase().contains(normalizedPortfolio)) {
                    filtered.add(row);
                    break;
                }
            }
        }
        return filtered;
    }

    private static List<Map<String, Object>> normalizePortfolioRecords(List<SObject> records, List<String> fields) {
        List<Map<String, Object>> normalized = new List<Map<String, Object>>();
        for (SObject record : records) {
            Map<String, Object> item = new Map<String, Object>();
            for (String fieldName : fields) {
                item.put(fieldName, record.get(fieldName));
            }
            normalized.add(item);
        }
        return normalized;
    }

    private static List<Map<String, Object>> normalizeRows(
        List<SObject> queriedRows,
        Map<String, String> mappedFields
    ) {
        List<Map<String, Object>> records = new List<Map<String, Object>>();
        for (SObject queriedRow : queriedRows) {
            Map<String, Object> normalizedRow = new Map<String, Object>{ 'id' => queriedRow.get('Id') };
            for (String outputName : mappedFields.keySet()) {
                if (outputName != 'assessmentPeriod') {
                    normalizedRow.put(outputName, getFieldValue(queriedRow, mappedFields.get(outputName)));
                }
            }
            records.add(normalizedRow);
        }
        return records;
    }

    private static Object getFieldValue(SObject row, String fieldPath) {
        if (String.isBlank(fieldPath) || row == null) {
            return null;
        }
        if (!fieldPath.contains('.')) {
            return row.get(fieldPath);
        }
        List<String> segments = fieldPath.split('\\.');
        SObject currentRow = row;
        for (Integer index = 0; index < segments.size() - 1; index++) {
            currentRow = currentRow == null ? null : currentRow.getSObject(segments[index]);
            if (currentRow == null) {
                return null;
            }
        }
        return currentRow.get(segments[segments.size() - 1]);
    }

    private static AuraHandledException handledError(String message) {
        return new AuraHandledException(message);
    }

    private static Schema.DescribeSObjectResult describeAssessmentObject() {
        return describeObject(getObjectApiName());
    }

    private static Schema.DescribeSObjectResult describeObject(String objectApiName) {
        Schema.SObjectType objectType = Schema.getGlobalDescribe().get(objectApiName);
        if (objectType == null) {
            throw handledError('The ' + objectApiName + ' object is not available in this org.');
        }
        Schema.DescribeSObjectResult objectDescribe = objectType.getDescribe();
        if (!objectDescribe.isAccessible() || !objectDescribe.isQueryable()) {
            throw handledError('You do not have permission to read ' + objectApiName + '.');
        }
        return objectDescribe;
    }

    private static String getObjectApiName() {
        return Test.isRunningTest() && !String.isBlank(objectApiNameOverride)
            ? objectApiNameOverride
            : ASSESSMENT_OBJECT;
    }

    private class QuerySpec {
        private List<String> conditions = new List<String>();
        private Map<String, Object> binds = new Map<String, Object>();
        private Map<String, String> mappedFields;
        private Map<String, Schema.SObjectField> availableFields;
    }
