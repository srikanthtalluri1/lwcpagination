    public static PaamPageResult getStackLayJunction(
        Integer pageSize,
      // Datetime lastCreatedDate,
         String lastAppName,
        Id lastRecordId,
        String ownedBy,
        String searchKey
    ) {
        Integer safeLimit = pageSize == null
            ? 50
            : Math.min(Math.max(pageSize, 1), 200);

        Integer queryLimit = safeLimit + 1;

      //  Id currentUserId = UserInfo.getUserId();
        

        /*
         * Ownership condition:
         *
         * MyPrimary:
         *   Primary ownership fields only.
         *
         * MyAll:
         *   Primary and delegate ownership fields.
         *
         * All:
         *   No ownership condition.
         */
         ownershipCondition =
            buildOwnershipCondition(ownedBy);
         Id currentUserId;

        if (String.isNotBlank(ownershipCondition)) {
            currentUserId = getCurrentEmployeeId();
        }

        /*
         * Search is applied only when at least three
         * non-space characters are entered.
         */
        String normalizedSearchKey =
            String.isBlank(searchKey)
                ? null
                : searchKey.trim();

        String searchPattern;

        if (
            normalizedSearchKey != null &&
            normalizedSearchKey.length() >= 3
        ) {
            searchPattern =
                '%' + normalizedSearchKey + '%';
        }

        /*
         * These conditions apply to both the count query
         * and the record query.
         */
        List<String> baseConditions =
            new List<String>();

       
                  system.debug('69 is: '+searchPattern);
        if (String.isNotBlank(searchPattern)) {
            baseConditions.add(
                '(' +
                    'App__r.App_Name__c ' +
                    'LIKE :searchPattern ' +

                    'OR App__r.' +
                    'Operational_Status__c ' +
                    'LIKE :searchPattern ' +

                    'OR Stack_Layer_Config__r.Name ' +
                    'LIKE :searchPattern ' +

                    'OR Stack_Layer_Status__c ' + //StackLayerStatus__c
                    'LIKE :searchPattern' +
                ')'
            );
        }
 if (String.isNotBlank(ownershipCondition)) {
            baseConditions.add(ownershipCondition);
        }
        /*
         * Count query.
         *
         * The same ownership and search filters must be
         * used here so totalRecords is accurate.
         */
        String countQuery =
            'SELECT COUNT() ' +
            'FROM TPM_Stack_Layer_Import_Relationship__c'; //new object

        if (!baseConditions.isEmpty()) {
            countQuery +=
                ' WHERE ' +
                String.join(baseConditions, ' AND ');
        }

        Integer totalRecordCount =
            Database.countQuery(countQuery);

        /*
         * Record query conditions start with the ownership
         * and search conditions.
         */
        List<String> recordConditions =
            new List<String>();

        recordConditions.addAll(baseConditions);

        /*
         * Keyset pagination.
         */
      if (
    lastAppName != null &&
    lastRecordId != null
) {
    recordConditions.add(
        '(' +
            'App__r.App_Name__c > :lastAppName ' +
            'OR (' +
                'App__r.App_Name__c = :lastAppName ' +
                'AND Id > :lastRecordId' +
            ')' +
        ')'
    );
}

        String recordQuery = 
          
           'SELECT ' +
                'Id, ' +
                'CreatedDate, ' +
                'Stack_Layer_Status__c, ' +
                'Stack_Layer_Config__r.Name, ' +
                'App__c, Mapping_Type__c, ' +
                'App__r.App_Name__c, ' +
                'App__r.' +
                    'Operational_Status__c ' +
            'FROM TPM_Stack_Layer_Import_Relationship__c'; //new object

        if (!recordConditions.isEmpty()) {
            recordQuery +=
                ' WHERE ' +
                String.join(recordConditions, ' AND ');
        }
system.debug('152 is:' +recordQuery);
        recordQuery +=
            ' ORDER BY App__r.App_Name__c ASC, Id ASC' +
            ' LIMIT :queryLimit';
   system.debug('156 is"' + recordQuery);
        List<TPM_Stack_Layer_Import_Relationship__c> queriedRecords =
            Database.query(recordQuery); // new object
 system.debug('159 is"' + queriedRecords.size());
        Boolean hasMore =
            queriedRecords.size() > safeLimit;

        /*
         * The query requests one extra record to determine
         * whether another page exists.
         */
        List<TPM_Stack_Layer_Import_Relationship__c> pageRecords =
            new List<TPM_Stack_Layer_Import_Relationship__c>();

        Integer recordsToReturn = Math.min(
            safeLimit,
            queriedRecords.size()
        );

        for (
            Integer index = 0;
            index < recordsToReturn;
            index++
        ) {
            pageRecords.add(queriedRecords[index]);
        }

        List<PaamRowWrapper> rows =
            new List<PaamRowWrapper>();

        for (
            TPM_Stack_Layer_Import_Relationship__c recordItem :
            pageRecords // new object
        ) {
            PaamRowWrapper row =
                new PaamRowWrapper();

            row.Id = recordItem.Id;
            row.createdDate = recordItem.CreatedDate;

           row.manualStatus =
                recordItem.Stack_Layer_Status__c;

            String paamValue =
                recordItem.Stack_Layer_Config__r != null
                    ? recordItem.Stack_Layer_Config__r.Name
                    : '';

            String paamSource =
                String.isBlank(recordItem.Mapping_Type__c)
                    ? ''
                    : recordItem.Mapping_Type__c.trim();

            if ('CI'.equalsIgnoreCase(paamSource)) {

                    row.paamManual = '';
                    row.paamDiscovered = paamValue;

                    }
                    else if ('PAAM'.equalsIgnoreCase(paamSource)) {

                        row.paamManual = paamValue;
                        row.paamDiscovered = '';

                    }
                    else if ('PAAM and CI'.equalsIgnoreCase(paamSource)) {

                        row.paamManual = paamValue;
                        row.paamDiscovered = '';
                        row.forceInSync = true;

                    } else {
                // Safe fallback for any unexpected picklist value
                row.paamManual = paamValue;
                row.paamDiscovered = '';
            }

            if (
               
                recordItem.App__r != null
            ) {
                row.appId =
                    recordItem
                        .App__c;

                row.appName =
                    recordItem
                        .App__r
                        .App_Name__c;

                row.operationalStatus =
                    recordItem
                        .App__r
                        .Operational_Status__c;
            }

            row.appName =
                String.isBlank(row.appName)
                    ? ''
                    : row.appName; 

            row.operationalStatus =
                String.isBlank(row.operationalStatus)
                    ? ''
                    : row.operationalStatus;

            row.paamManual =
                String.isBlank(row.paamManual)
                    ? ''
                    : row.paamManual;

            row.paamDiscovered =
                String.isBlank(row.paamDiscovered)
                    ? ''
                    : row.paamDiscovered;

            row.manualStatus =
                String.isBlank(row.manualStatus)
                    ? ''
                    : row.manualStatus;

            row.discoveredStatus =
                String.isBlank(row.discoveredStatus)
                    ? ''
                    : row.discoveredStatus;

            rows.add(row);
        }

        PaamPageResult result =
            new PaamPageResult();

        result.rows = rows;
        result.hasMore = hasMore;
        result.totalRecords = totalRecordCount;

        /*
         * Return the final record's values as the cursor
         * for the next page.
         */
        if (!pageRecords.isEmpty()) {
          //new object
            TPM_Stack_Layer_Import_Relationship__c finalRecord =
                pageRecords[
                    pageRecords.size() - 1
                ];
result.lastAppName =
  
    finalRecord.App__r != null
        ? finalRecord.App__r.App_Name__c
        : null;

result.lastRecordId =
    finalRecord.Id;
        }

        return result;
    }

    
