@isTest
private class ASP_GetEligibleEmployeesActionTest {

    private static User createUser(String empNo, String suffix) {
        Profile p = [SELECT Id FROM Profile WHERE Name = 'Unassigned Users Profile' LIMIT 1];
        User u = new User(
            EmployeeNumber = empNo,
            Alias = empNo.left(8),
            Username = 'asp.test.' + suffix + '.' + System.currentTimeMillis() + '@usaa.com',
            Email = 'asp.test.' + suffix + '@usaa.com',
            FirstName = 'Test',
            LastName = suffix,
            LocaleSidKey = 'en_US',
            LanguageLocaleKey = 'en_US',
            EmailEncodingKey = 'UTF-8',
            TimeZoneSidKey = 'America/Chicago',
            ProfileId = p.Id
        );
        insert u;
        return u;
    }

    private static void assignPermission(User u, String psName) {
        PermissionSet ps = [SELECT Id FROM PermissionSet WHERE Name = :psName LIMIT 1];
        insert new PermissionSetAssignment(AssigneeId = u.Id, PermissionSetId = ps.Id);
    }

    private static UCH_Employee__c createEmployee(String empNo, String name) {
        UCH_Employee__c emp = new UCH_Employee__c(
            Name = name,
            Employee_ID__c = empNo,
            Department_Description__c = 'Dept',
            Department_ID__c = '1'
        );
        insert emp;
        return emp;
    }

    @isTest
    static void nullRequestReturnsEmpty() {
        Test.startTest();
        List<ASP_GetEligibleEmployeesAction.Response> result =
            ASP_GetEligibleEmployeesAction.getEligibleEmployees(null);
        Test.stopTest();

        Assert.areEqual(0, result.size());
    }

    @isTest
    static void blankPermissionSetReturnsEmpty() {
        ASP_GetEligibleEmployeesAction.Request req = new ASP_GetEligibleEmployeesAction.Request();

        Test.startTest();
        List<ASP_GetEligibleEmployeesAction.Response> result =
            ASP_GetEligibleEmployeesAction.getEligibleEmployees(
                new List<ASP_GetEligibleEmployeesAction.Request>{ req }
            );
        Test.stopTest();

        Assert.areEqual(0, result[0].eligibleEmployees.size());
    }

    @isTest
    static void validPermissionSetReturnsEmployee() {
        User userA = createUser('E100A', 'AuthorA');
        assignPermission(userA, 'ASP_AUTHOR');

        User thisUser = [SELECT Id FROM User WHERE Id = :UserInfo.getUserId()];
        UCH_Employee__c employeeA;
        System.runAs(thisUser) {
            employeeA = createEmployee('E100A', 'Employee A');
        }

        ASP_GetEligibleEmployeesAction.Request req = new ASP_GetEligibleEmployeesAction.Request();
        req.permissionSetName = 'ASP_AUTHOR';

        Test.startTest();
        List<ASP_GetEligibleEmployeesAction.Response> result =
            ASP_GetEligibleEmployeesAction.getEligibleEmployees(
                new List<ASP_GetEligibleEmployeesAction.Request>{ req }
            );
        Test.stopTest();

        Assert.areEqual(employeeA.Id, result[0].eligibleEmployees[0].Id);
    }

    @isTest
    static void ownerExcludedReturnsEmpty() {
        User userA = createUser('E100B', 'AuthorB');
        assignPermission(userA, 'ASP_AUTHOR');

        User thisUser = [SELECT Id FROM User WHERE Id = :UserInfo.getUserId()];
        UCH_Employee__c employeeA;
        System.runAs(thisUser) {
            employeeA = createEmployee('E100B', 'Employee B');
        }

        ASP_GetEligibleEmployeesAction.Request req = new ASP_GetEligibleEmployeesAction.Request();
        req.permissionSetName = 'ASP_AUTHOR';
        req.ownerEmployeeRecordId = employeeA.Id;

        Test.startTest();
        List<ASP_GetEligibleEmployeesAction.Response> result =
            ASP_GetEligibleEmployeesAction.getEligibleEmployees(
                new List<ASP_GetEligibleEmployeesAction.Request>{ req }
            );
        Test.stopTest();

        Assert.areEqual(0, result[0].eligibleEmployees.size());
    }

    @isTest
    static void assignedAuthorExcludedReturnsEmpty() {
        User userA = createUser('E100C', 'AuthorC');
        User adminUser = createUser('E100D', 'AdminD');
        assignPermission(userA, 'ASP_AUTHOR');
        assignPermission(adminUser, 'ASP_ADMIN');

        User thisUser = [SELECT Id FROM User WHERE Id = :UserInfo.getUserId()];
        UCH_Employee__c employeeA;
        System.runAs(thisUser) {
            employeeA = createEmployee('E100C', 'Employee C');
            createEmployee('E100D', 'Employee D');
        }

        ASP_Architecture_Standard__c standard;
        System.runAs(adminUser) {
            standard = new ASP_Architecture_Standard__c(
                Name = 'Standard A',
                Active__c = true,
                Status__c = 'Draft',
                Stage__c = 'New',
                Classification__c = 'Architecture',
                Class__c = 'Application'
            );
            insert standard;

            insert new ASP_Architecture_Standard_Author__c(
                Author__c = employeeA.Id,
                Standard__c = standard.Id
            );
        }

        ASP_GetEligibleEmployeesAction.Request req = new ASP_GetEligibleEmployeesAction.Request();
        req.permissionSetName = 'ASP_AUTHOR';
        req.standardId = standard.Id;
        req.excludeAssignedAuthors = true;

        Test.startTest();
        List<ASP_GetEligibleEmployeesAction.Response> result =
            ASP_GetEligibleEmployeesAction.getEligibleEmployees(
                new List<ASP_GetEligibleEmployeesAction.Request>{ req }
            );
        Test.stopTest();

        Assert.areEqual(0, result[0].eligibleEmployees.size());
    }

    @isTest
    static void invalidIdsStillReturnsEmployee() {
        User userA = createUser('E100E', 'AuthorE');
        assignPermission(userA, 'ASP_AUTHOR');

        User thisUser = [SELECT Id FROM User WHERE Id = :UserInfo.getUserId()];
        System.runAs(thisUser) {
            createEmployee('E100E', 'Employee E');
        }

        ASP_GetEligibleEmployeesAction.Request req = new ASP_GetEligibleEmployeesAction.Request();
        req.permissionSetName = 'ASP_AUTHOR';
        req.ownerEmployeeRecordId = 'invalid';
        req.standardId = 'invalid';
        req.excludeAssignedAuthors = true;

        Test.startTest();
        List<ASP_GetEligibleEmployeesAction.Response> result =
            ASP_GetEligibleEmployeesAction.getEligibleEmployees(
                new List<ASP_GetEligibleEmployeesAction.Request>{ req }
            );
        Test.stopTest();

        Assert.areEqual(1, result[0].eligibleEmployees.size());
    }
}
