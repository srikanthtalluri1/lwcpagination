					{ label: 'Eliminate', value: prior.time.Eliminate, color: 'var(--slds-g-color-error-base-40)' }
				],
				legend: [
					{ label: 'Invest', value: prior.time.Invest, indicatorStyle: 'background-color:var(--slds-g-color-success-base-40)' },
					{ label: 'Tolerate', value: prior.time.Tolerate, indicatorStyle: 'background-color:var(--slds-g-color-brand-base-30)' },
