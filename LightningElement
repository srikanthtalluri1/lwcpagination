    @AuraEnabled
    public static Boolean acceptConflict(String paamRow){
        paamRow = paamRow.replaceAll('"id"', '"recId"');
        PaamRowWrapper row = (PaamRowWrapper) JSON.deserialize(paamRow, PaamRowWrapper.class);
        String appId = row.appId;
        String stackLayerUuid = row.stackLayerUuid;
        
        TPM_Stack_Layer_Config__c config;
        for(TPM_Stack_Layer_Config__c rec : [Select Id, StackId__r.Name from TPM_Stack_Layer_Config__c Where UUID__c = :stackLayerUuid and UUID__c != null WITH SYSTEM_MODE]){
            config = rec;
        }
        
        if(config == null || String.isBlank(config.StackId__r?.Name)){
            return false;
        }
        
        TPM_App_Stack__c appStack;
        for(TPM_App_Stack__c rec : [Select Id from TPM_App_Stack__c Where App__c = :appId and App__c != null  
                                    and Stack_Name__c = : config.StackId__r.Name and Stack_Name__c != null WITH SYSTEM_MODE LIMIT 1]){
            appStack = rec;
        }
        
        if(appStack == null){
            appStack = new TPM_App_Stack__c();
            appStack.StackLayerId__c = config.Id;
            appStack.App__c = appId;
            appStack.Stack_Name__c = config.StackId__r.Name;

             if(Schema.sObjectType.TPM_App_Stack__c.isCreateable()){
             if(TPM_App_Stack__c.SObjectType.getDescribe().isCreateable()){
                 insert appStack; 
             }
        }
           // insert appStack;
        }
        
        TPM_Stack_layer_Junction__c jun = new TPM_Stack_layer_Junction__c();
        jun.TPM_App_Stack__c = appStack.Id;
        jun.Stack_Layer_Config__c = config.Id;
        if(TPM_Stack_layer_Junction__c.SObjectType.getDescribe().isCreateable()){
            insert jun; 
        }
        
        TPM_AppStackUpdateBatch.updateAppsStackData(new Set<Id>{jun.Stack_Layer_Config__c});
       
        if(TPM_Stack_Layer_Import_Relationship__c.SObjectType.getDescribe().isUpdateable()){
        return false;
        }
        update new TPM_Stack_Layer_Import_Relationship__c(Id = row.recId, Mapping_Type__c = 'PAAM and CI', Architect_Agreement__c = 'Accept');
        return true;
    }
