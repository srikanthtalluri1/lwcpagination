        const searchValue =
            event.target.value || '';

        this.query = searchValue;

        window.clearTimeout(
            this.searchTimeout
        );

        this.searchTimeout =
            window.setTimeout(() => {
                const trimmedSearch =
                    this.query.trim();

                if (
                    trimmedSearch.length > 0 &&
                    trimmedSearch.length < 3
                ) {
                    return;
                }

                this.resetServerPagination();
                this.loadRecords();
            }, 400);
    }

    handleScopeChange(event) {
        const selectedScope =
            event.currentTarget.dataset.scope;

        if (
            this.scope === selectedScope ||
            this.isLoading
        ) {
            return;
        }

        this.scope = selectedScope;

        this.resetServerPagination();
        this.loadRecords();
        this.getUniqueAppCount();
    }

    handleViewChange(event) {
        this.view =
            event.currentTarget.dataset.view;

        this.resetPage();
    }

    handleStatusFilterChange(event) {
        this.statusFilter =
            event.target.value;

        this.resetPage();
    }

    handleSort(event) {
        const field =
            event.currentTarget.dataset.field;

        if (this.sortField === field) {
            this.sortDir =
                this.sortDir === 'asc'
                    ? 'desc'
                    : 'asc';
        } else {
            this.sortField = field;
            this.sortDir = 'asc';
        }

        this.resetPage();
    }

    handleAccept(event) {
        const id =
            event.currentTarget.dataset.id;

        const row = this.rows.find(
            (record) => record.id === id
        );

        if (
            !row ||
            row.paamManual ===
                row.paamDiscovered
        ) {
            return;
        }

        const originalManual =
            row.paamManual;

        this.rows = this.rows.map(
            (record) =>
                record.id === id
                    ? {
                        ...record,
                        paamManual:
                            row.paamDiscovered
                    }
                    : record
        );

        this.overrides = {
            ...this.overrides,
            [id]: originalManual
        };

        this.showToast(
            'success',
            `Accepted “${row.paamDiscovered}” ` +
            `for ${row.appName}`
        );
    }

    handleUndo(event) {
        const id =
            event.currentTarget.dataset.id;

        const original =
            this.overrides[id];

        if (original === undefined) {
            return;
        }

        this.rows = this.rows.map(
            (record) =>
                record.id === id
                    ? {
                        ...record,
                        paamManual: original
                    }
                    : record
        );

        const nextOverrides = {
            ...this.overrides
        };

        delete nextOverrides[id];

        this.overrides =
            nextOverrides;

        this.showToast(
            'success',
            `Reverted to “${original}”`
        );
    }

    handlePageSizeChange(event) {
        this.pageSize =
            Number(event.target.value);

        this.resetServerPagination();
        this.loadRecords();
    }

    goFirst() {
        if (
            this.isLoading ||
            this.isFirstPage
        ) {
            return;
        }

        this.resetServerPagination();
        this.loadRecords();
    }

    goPrev() {
        if (
            this.isLoading ||
            this.isFirstPage
        ) {
            return;
        }

        this.resetServerPagination();
        this.loadRecords();
    }

    goNext() {
        if (
            this.isLoading ||
            !this.hasMore
        ) {
            return;
        }

        this.loadRecords(true);
    }

    goLast() {
        if (
            this.isLoading ||
            this.isLastPage
        ) {
            return;
        }

        this.showToast(
            'warning',
            'Use Next to load additional records.'
        );
    }

    showToast(kind, message) {
        this.toastKind = kind;
        this.toastMessage = message;

        window.clearTimeout(
            this.toastTimeout
        );

        this.toastTimeout =
            window.setTimeout(() => {
                this.toastMessage = '';
            }, 3500);
    }

    dismissToast() {
        this.toastMessage = '';
    }
}


