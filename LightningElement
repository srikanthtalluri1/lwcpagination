<template>
  <div class="paam-page">
    <!-- Hero -->
    <div class="paam-hero">
      <div>
        <span class="paam-eyebrow">USAA · Application Insights</span>
        <h1>PAAM Mapping <span class="paam-hero__accent">Discovery</span></h1>
        <p>
          Applications where the manually recorded PAAM differs from the automatically discovered PAAM.
        </p>
      </div>
    </div>

    <!-- Stats -->
    <div class="paam-stats">
      <div class="paam-stat paam-stat--total">
        <div class="paam-stat__accent"></div>
        <div class="paam-stat__label">Total Apps</div>
        <div class="paam-stat__value">{totalAppsDisplay}</div>
        <div class="paam-stat__hint">{totalRecordsDisplay} PAAM records across 4 attributes</div>
      </div>

      <div class="paam-stat paam-stat--sync">
        <div class="paam-stat__accent"></div>
        <div class="paam-stat__label">In Sync</div>
        <div class="paam-stat__value">{totalSyncDisplay}</div>
        <div class="paam-stat__hint">Manual matches discovered</div>
      </div>

      <div class="paam-stat paam-stat--conflict">
        <div class="paam-stat__accent"></div>
        <div class="paam-stat__label">Conflicts</div>
        <div class="paam-stat__value">{totalConflictsDisplay}</div>
        <div class="paam-stat__hint">{conflictPct}% of total need review</div>
      </div>
    </div>

    <!-- Main Card -->
    <div class="paam-card">
      <div class="paam-card__header">
        <div>
          <h3 class="paam-card__title">Application PAAM Records</h3>
          <p class="paam-card__subtitle">
            Showing {filteredCountDisplay} of {totalRecordsDisplay} records
          </p>
        </div>

        <div class="paam-toolbar">
          <!-- Search -->
          <div class="paam-field">
            <label class="paam-field__label" for="paam-search-input">Search</label>
            <div class="paam-search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                id="paam-search-input"
                type="search"
                placeholder=" Min 3 Char(Search App,PAAM…)"
                value={query}
                oninput={handleSearch}
              />
            </div>
          </div>

          <!-- Ownership -->
          <div class="paam-field">
            <span class="paam-field__label">Ownership</span>
            <div class="paam-segmented" role="tablist" aria-label="Ownership">
              <button
                type="button"
                class={primaryScopeClass}
                data-scope="primary"
                onclick={handleScopeChange}
                title="Apps where you are the primary owner">
                My Primary Apps
              </button>
              <button
                type="button"
                class={mineScopeClass}
                data-scope="mine"
                onclick={handleScopeChange}
                title="All apps you own or co-own">
                My All Apps
              </button>
              <button
                type="button"
                class={allScopeClass}
                data-scope="all"
                onclick={handleScopeChange}>
                All Apps
              </button>
            </div>
          </div>

          <!-- Sync Status -->
          <div class="paam-field">
            <span class="paam-field__label">Sync Status</span>
            <div class="paam-segmented" role="tablist" aria-label="Sync Status">
              <button type="button" class={conflictsViewClass} data-view="conflicts" onclick={handleViewChange}>
                Conflicts
              </button>
              <button type="button" class={allViewClass} data-view="all" onclick={handleViewChange}>
                All
              </button>
              <button type="button" class={syncViewClass} data-view="sync" onclick={handleViewChange}>
                In Sync
              </button>
            </div>
          </div>

          <!-- Stack Layer Status -->
          <div class="paam-field">
            <label class="paam-field__label" for="paam-status-select">Stack Layer Status</label>
            <select
              id="paam-status-select"
              class="paam-select"
              value={statusFilter}
              onchange={handleStatusFilterChange}
              aria-label="Filter by Stack Layer Status"
              title="Filter by Stack Layer Status">
              <option value="all">All Statuses</option>
              <template for:each={stackStatusOptions} for:item="opt">
                <option key={opt.slug} value={opt.slug}>{opt.label}</option>
              </template>
            </select>
          </div>
        </div>
      </div>

      <!-- Table -->
      <div class="paam-table-wrap slds-scope">
        <table class="paam-table slds-table slds-table_bordered slds-table_cell-buffer slds-table_col-bordered">
          <thead>
            <tr>
              <th scope="col">
                <button type="button" data-field="appName" onclick={handleSort}>
                  Application <span>{appSortArrow}</span>
                </button>
              </th>
              <th scope="col">
                <button type="button" data-field="status" onclick={handleSort}>
                  Operational Status <span>{statusSortArrow}</span>
                </button>
              </th>
              <th scope="col">
                <button type="button" data-field="paamManual" onclick={handleSort}>
                  PAAM Manual <span>{manualSortArrow}</span>
                </button>
              </th>
              <th scope="col">
                <button type="button" data-field="paamDiscovered" onclick={handleSort}>
                  PAAM Discovered <span>{discoveredSortArrow}</span>
                </button>
              </th>
              <th scope="col">Sync Status</th>
              <template if:true={isPrimaryScope}>
                <th scope="col" class="paam-action-heading">Action</th>
              </template>
            </tr>
          </thead>

          <tbody>
            <template if:true={hasPageRows}>
              <template for:each={pageRows} for:item="row">
                 <tr
                      key={row.id}
                      class={row.rowClass}
                      data-group-key={row.groupKey}
                        onmouseenter={handleGroupMouseEnter}
                        onmouseleave={handleGroupMouseLeave}>
                  <template if:true={row.showApplication}>
                    <th
                      scope="rowgroup"
                      rowspan={row.applicationRowSpan}
                      class="paam-group-cell">
                      <div class="paam-app-cell">
                        <span class="paam-app-name">{row.appName}</span>
                      </div>
                    </th>

                    <td
                      rowspan={row.applicationRowSpan}
                      class="paam-group-cell">
                      <span class="paam-attr">{row.status}</span>
                    </td>
                  </template>

                  <td class="paam-cell--manual">
                    <span class="paam-diff-cell">
                      <span class={row.manualPillClass} title={row.manualTitle}>
                        <span class="paam-pill__label">{row.paamManual}</span>
                      </span>

                      <template if:true={row.isConflict}>
                        <span class="paam-diff-arrow" title={row.diffTitle}>
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                               stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                               stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="13 6 19 12 13 18"></polyline>
                          </svg>
                        </span>
                      </template>
                    </span>

                    <template if:true={row.wasOverridden}>
                      <div class="paam-overridden" title="Manual value was overridden with discovered value">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="3" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Accepted
                      </div>
                    </template>
                  </td>

                  <td class="paam-cell--discovered">
                    <span class="paam-diff-cell">
                      <span class={row.discoveredPillClass} title={row.discoveredTitle}>
                        <span class="paam-pill__label">{row.paamDiscovered}</span>
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class={row.syncStatusClass}>{row.syncStatusLabel}</span>
                  </td>

                  <template if:true={isPrimaryScope}>
                    <td class="paam-action-cell">
                      <template if:true={row.isConflict}>
                        <button
                          type="button"
                          class="paam-btn paam-btn--accept"
                          data-id={row.id}
                          onclick={handleAccept}
                          title={row.acceptTitle}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                               aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          Accept
                        </button>
                      </template>

                      <template if:false={row.isConflict}>
                        <template if:true={row.wasOverridden}>
                          <div class="paam-action-stack">
                            <span class="paam-accepted-tag">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                   stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                   aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"></polyline>
                              </svg>
                              Accepted
                            </span>
                            <button
                              type="button"
                              class="paam-action-undo"
                              data-id={row.id}
                              onclick={handleUndo}>
                              Undo
                            </button>
                          </div>
                        </template>

                        <template if:false={row.wasOverridden}>
                          <span class="paam-action-empty" aria-hidden="true">—</span>
                        </template>
                      </template>
                    </td>
                  </template>
                </tr>
              </template>
            </template>

            <template if:false={hasPageRows}>
              <tr>
                <td colspan={emptyColspan} class="paam-empty">
                  <div class="paam-empty__icon">∅</div>
                  <div>No records match your filters.</div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Footer / Pagination -->
      <div class="paam-card__footer">
        <span>{footerRangeLabel}</span>

        <span class="paam-pager">
          <label class="paam-page-size-label">
            Rows:
            <select value={pageSize} onchange={handlePageSizeChange} class="paam-page-size">
              <option value="10">10</option>
              <option value="25">25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </label>

          <button type="button" class="paam-btn" onclick={goFirst} disabled={isFirstPage}>« First</button>
          <button type="button" class="paam-btn" onclick={goPrev} disabled={isFirstPage}>‹ Prev</button>
          <span class="paam-page-label">Page {currentPage} / {totalPages}</span>
          <button type="button" class="paam-btn" onclick={goNext} disabled={disableNext}>Next ›</button>
          <button type="button" class="paam-btn" onclick={goLast} disabled={isLastPage}>Last »</button>
        </span>
      </div>
    </div>

    <!-- Toast -->
    <template if:true={toastMessage}>
      <div class="paam-toast-region" role="status" aria-live="polite">
        <div class={toastClass}>
          <span>{toastMessage}</span>
          <button type="button" class="paam-toast__close" onclick={dismissToast} aria-label="Dismiss">×</button>
        </div>
      </div>
    </template>
  </div>
</template>


:host {
  /* USAA brand palette */
  --paam-bg-start: #eef3f7;
  --paam-bg-end: #f7f3ea;
  --paam-card-bg: #ffffff;
  --paam-border: #d9e0e6;
  --paam-text: #0d2436;
  --paam-muted: #5b6b78;

  --paam-primary: #003B5C;
  --paam-primary-soft: #e5edf3;
  --paam-primary-dark: #002855;

  --paam-gold: #C2A77E;
  --paam-gold-dark: #a78a5e;

  --paam-danger: #B3261E;
  --paam-danger-soft: #fbeae8;
  --paam-success: #1f7a4d;
  --paam-success-soft: #e6f2ec;

  --paam-shadow: 0 10px 30px -12px rgba(0, 40, 85, 0.22),
    0 2px 6px -2px rgba(0, 40, 85, 0.08);

  display: block;
  color: var(--paam-text);
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.paam-page {
  padding: 2.5rem 1.5rem 3rem;
  max-width: 1200px;
  margin: 0 auto;
  background:
    radial-gradient(1200px 600px at 0% -10%, #d6e2eb 0%, transparent 60%),
    radial-gradient(900px 500px at 100% 0%, #efe6d2 0%, transparent 55%),
    linear-gradient(180deg, var(--paam-bg-start) 0%, var(--paam-bg-end) 100%);
  min-height: 100vh;
}

/* Hero */
.paam-hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
  padding: 1.75rem 1.75rem 1.5rem;
  flex-wrap: wrap;
  background:
    linear-gradient(135deg, var(--paam-primary-dark) 0%, var(--paam-primary) 55%, #0a4d72 100%);
  border-radius: 14px;
  border: 1px solid var(--paam-primary-dark);
  box-shadow: 0 14px 32px -16px rgba(0, 40, 85, 0.55);
  overflow: hidden;
}

.paam-hero::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 5px;
  background: linear-gradient(180deg, var(--paam-gold) 0%, var(--paam-gold-dark) 100%);
}

.paam-hero::after {
  content: "";
  position: absolute;
  right: -80px;
  top: -80px;
  width: 240px;
  height: 240px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(194, 167, 126, 0.22) 0%, rgba(194, 167, 126, 0) 70%);
  pointer-events: none;
}

.paam-hero > * {
  position: relative;
  z-index: 1;
}

.paam-hero h1 {
  margin: 0;
  font-size: 1.9rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #ffffff;
}

.paam-hero h1 .paam-hero__accent {
  color: var(--paam-gold);
}

.paam-hero p {
  margin: 0.35rem 0 0;
  color: rgba(255, 255, 255, 0.82);
  font-size: 0.95rem;
}

.paam-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.3rem 0.7rem;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--paam-gold);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(194, 167, 126, 0.45);
  border-radius: 999px;
  margin-bottom: 0.75rem;
  backdrop-filter: blur(2px);
}

.paam-eyebrow::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--paam-gold);
  box-shadow: 0 0 0 3px rgba(194, 167, 126, 0.25);
}

/* Stat cards */
.paam-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.paam-stat {
  background: var(--paam-card-bg);
  border: 1px solid var(--paam-border);
  border-radius: 14px;
  padding: 1rem 1.1rem;
  box-shadow: var(--paam-shadow);
  position: relative;
  overflow: hidden;
}

.paam-stat__accent {
  position: absolute;
  inset: 0 auto 0 0;
  width: 4px;
}

.paam-stat--total .paam-stat__accent {
  background: var(--paam-primary);
}

.paam-stat--conflict .paam-stat__accent {
  background: var(--paam-danger);
}

.paam-stat--sync .paam-stat__accent {
  background: var(--paam-success);
}

.paam-stat__label {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--paam-muted);
}

.paam-stat__value {
  font-size: 1.85rem;
  font-weight: 700;
  line-height: 1.1;
  margin-top: 0.25rem;
  letter-spacing: -0.02em;
}

.paam-stat__hint {
  margin-top: 0.25rem;
  font-size: 0.78rem;
  color: var(--paam-muted);
}

.paam-stat--conflict .paam-stat__value {
  color: var(--paam-danger);
}

.paam-stat--sync .paam-stat__value {
  color: var(--paam-success);
}

/* Card */
.paam-card {
  background: var(--paam-card-bg);
  border: 1px solid var(--paam-border);
  border-radius: 16px;
  box-shadow: var(--paam-shadow);
  overflow: hidden;
}

.paam-card__header {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--paam-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  background: linear-gradient(180deg, #f6f8fa 0%, #ffffff 100%);
}

.paam-card__title {
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
}

.paam-card__subtitle {
  font-size: 0.82rem;
  color: var(--paam-muted);
  margin: 0.1rem 0 0;
}

/* Toolbar */
.paam-toolbar {
  display: flex;
  gap: 0.75rem;
  align-items: flex-end;
  flex-wrap: wrap;
}

.paam-field {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.paam-field__label {
  font-size: 0.72rem;
  font-weight: 400;
  color: #444;
  letter-spacing: 0;
}

/* Search input */
.paam-search {
  position: relative;
}

.paam-search input {
  width: 260px;
  max-width: 100%;
  height: 1.875rem;
  padding: 0 0.75rem 0 2rem;
  font: inherit;
  font-size: 0.8125rem;
  line-height: 1.875rem;
  border: 1px solid #aeaeae;
  border-radius: 0.25rem;
  background: #fff;
  color: #181818;
  transition: border-color 0.1s linear, box-shadow 0.1s linear;
  outline: none;
}

.paam-search input::placeholder {
  color: #706e6b;
}

.paam-search input:focus {
  border-color: #1b96ff;
  box-shadow: 0 0 3px #0176d3;
}

.paam-search svg {
  position: absolute;
  left: 0.55rem;
  top: 50%;
  transform: translateY(-50%);
  width: 14px;
  height: 14px;
  color: #706e6b;
  pointer-events: none;
}

/* Picklist */
.paam-select {
  font: inherit;
  font-size: 0.8125rem;
  height: 1.875rem;
  padding: 0 1.75rem 0 0.75rem;
  border: 1px solid #aeaeae;
  border-radius: 0.25rem;
  background: #fff;
  color: #181818;
  cursor: pointer;
  outline: none;
  appearance: none;
  transition: border-color 0.1s linear, box-shadow 0.1s linear;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%23706e6b' d='M0 0l5 6 5-6z'/></svg>");
  background-repeat: no-repeat;
  background-position: right 0.6rem center;
}

.paam-select:focus {
  border-color: #1b96ff;
  box-shadow: 0 0 3px #0176d3;
}

/* Segmented control */
.paam-segmented {
  display: inline-flex;
  height: 1.875rem;
  border-radius: 0.25rem;
  overflow: hidden;
  background: #fff;
}

.paam-segmented button {
  appearance: none;
  background: #fff;
  border: 1px solid #aeaeae;
  border-right-width: 0;
  font: inherit;
  font-size: 0.8125rem;
  font-weight: 400;
  color: #0176d3;
  padding: 0 0.85rem;
  height: 1.875rem;
  line-height: 1;
  cursor: pointer;
  transition: background 0.1s linear, color 0.1s linear, box-shadow 0.1s linear;
  white-space: nowrap;
}

.paam-segmented button:first-child {
  border-top-left-radius: 0.25rem;
  border-bottom-left-radius: 0.25rem;
}

.paam-segmented button:last-child {
  border-right-width: 1px;
  border-top-right-radius: 0.25rem;
  border-bottom-right-radius: 0.25rem;
}

.paam-segmented button:hover {
  background: #f3f3f3;
}

.paam-segmented button:focus {
  outline: none;
  box-shadow: 0 0 3px #0176d3;
  position: relative;
  z-index: 1;
}

.paam-segmented button.is-active {
  background: #0176d3;
  border-color: #014486;
  color: #fff;
}

.paam-segmented button.is-active:hover {
  background: #014486;
}

/* Table */
.paam-table-wrap {
  overflow-x: auto;
}

.paam-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 0.92rem;
}

.paam-table thead th {
  background: #f8fafc;
  color: var(--paam-muted);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 600;
  text-align: left;
  padding: 0.7rem 1rem;
  border-bottom: 1px solid var(--paam-border);
  position: sticky;
  top: 0;
  user-select: none;
}

.paam-table thead th button {
  background: none;
  border: 0;
  padding: 0;
  font: inherit;
  color: inherit;
  text-transform: inherit;
  letter-spacing: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.paam-table thead th button:hover {
  color: var(--paam-text);
}

.paam-action-heading {
  text-align: right !important;
}

.paam-table tbody td,
.paam-table tbody th {
  padding: 0.85rem 1rem;
  border-bottom: 1px solid #f1f5f9;
  vertical-align: middle;
  font-weight: 400;
}

.paam-table tbody tr:last-child td,
.paam-table tbody tr:last-child th {
  border-bottom: 0;
}

.paam-table tbody tr.paam-row-group-hover > td,
.paam-table tbody tr.paam-row-group-hover > th {
    background-color: #F5F5F5 !important;
}

/* .paam-table tbody tr.paam-row-conflict.paam-row-group-hover > td,
.paam-table tbody tr.paam-row-conflict.paam-row-group-hover > th {
    background-color: rgba(220, 38, 38, 0.10) !important;
} */
.paam-row-conflict {
  background-color: rgba(220, 38, 38, 0.04);
}

.paam-row-group-start td,
.paam-row-group-start th {
  border-top: 2px solid #e2e8f0;
}

.paam-attr {
  font-weight: 500;
  color: #334155;
}

.paam-app-cell {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  text-align: left;
}

.paam-table th[scope="row"],
.paam-table td {
  text-align: left;
}

.paam-app-name {
  font-weight: 500;
  color: var(--paam-text);
}

/* PAAM pill */
.paam-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 600;
  border: 1px solid transparent;
  background: #f1f5f9;
  color: #334155;
  max-width: 280px;
  white-space: normal;
  line-height: 1.25;
  text-align: left;
}

.paam-table thead th:nth-child(1),
.paam-table tbody th.paam-group-cell {
  width: 260px;
  min-width: 260px;
  max-width: 260px;
}

.paam-app-cell {
  display: block;          /* was flex — flex resists shrinking */ 
}

.paam-app-name {
  display: block;
  white-space: normal;     /* allow line breaks */
  overflow-wrap: anywhere; /* break mid-word if a single token is too long */
  word-break: break-word;  /* older-browser fallback */
  line-height: 1.3;
}
