
Map<String, Object> result =
    TpmArchitectureHubController.getAssessmentData(
        '{"assessmentPeriod":"Q12021"}'
    );

List<Map<String, Object>> rows =
    (List<Map<String, Object>>) result.get('records');

Map<String, Integer> portfolioCounts =
    new Map<String, Integer>();

Map<String, Integer> scoredCounts =
    new Map<String, Integer>();

Integer blankPortfolioCount = 0;

for (Map<String, Object> row : rows) {
    Object portfolioValue = row.get('portfolio');

    if (portfolioValue == null ||
        String.isBlank(String.valueOf(portfolioValue))) {
        blankPortfolioCount++;
        continue;
    }

    String portfolioName =
        String.valueOf(portfolioValue).trim();

    Integer existingCount =
        portfolioCounts.containsKey(portfolioName)
        ? portfolioCounts.get(portfolioName) : 0;

    portfolioCounts.put(
        portfolioName, existingCount + 1
    );

    if (row.get('overall') != null) {
        Integer existingScored =
            scoredCounts.containsKey(portfolioName)
            ? scoredCounts.get(portfolioName) : 0;

        scoredCounts.put(
            portfolioName, existingScored + 1
        );
    }
}

List<String> names =
    new List<String>(portfolioCounts.keySet());

names.sort();

System.debug('HUB_TOTAL=' + rows.size());

System.debug('HUB_PORTFOLIO_COUNT=' + names.size());

System.debug('HUB_BLANK_PORTFOLIO=' +
    blankPortfolioCount);

for (String name : names) {
    System.debug(
        'HUB_PORTFOLIO=' + name +
        ' | RECORDS=' + portfolioCounts.get(name) +
        ' | SCORED=' +
        (scoredCounts.containsKey(name)
            ? scoredCounts.get(name) : 0)
    );
}
