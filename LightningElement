    private static List<String> getUserStandardAcknowledgerAssignmentsByEmployeeNumber(String employeeNumber) {
        List<String> standardAcknowledgerAssignments = new List<String>();

        try {
            // Get the current acknowledger assignments. Only count assignments where the standard has an active
            // approval submission (stage = pending acknowledgement/approval) so that we don't include acknowledgers
            // selected during a previous approval submission
            List<ASP_Architecture_Standard_Acknowledger__c> acknowledgers = [
                SELECT Id, Standard__c
                FROM ASP_Architecture_Standard_Acknowledger__c
                WHERE
                    Acknowledger__r.Employee_ID__c = :employeeNumber
                    AND (Standard__r.Stage__c = 'Pending Acknowledgement'
                    OR Standard__r.Stage__c = 'Pending Approval'
                    OR Standard__r.Stage__c = 'Revising from Send Back')  WITH SYSTEM_MODE
            ];

            for (ASP_Architecture_Standard_Acknowledger__c acknowledger : acknowledgers) {
                standardAcknowledgerAssignments.add(acknowledger.Standard__c);
            }

            return standardAcknowledgerAssignments;
        } catch (Exception e) {
            throw new AuraHandledException('Failed to retrieve user acknowledger assignments.');
        }
    }
