const previousFilterState = JSON.parse(
    JSON.stringify(this._filteredFieldValues || [])
);


restorePreviousCheckboxSelections(previousGroups) {
    const clean = value =>
        (value || '')
            .toString()
            .replace(/\s*\(\d+\)\s*$/, '')
            .trim();

    const previousByField = new Map(
        (previousGroups || []).map(group => [
            group.filterFieldApiName || group.filterField,
            group
        ])
    );

    this._filteredFieldValues = (
        this._filteredFieldValues || []
    ).map(group => {

        const previous = previousByField.get(
            group.filterFieldApiName || group.filterField
        );

        if (!previous) {
            return group;
        }

        const previousParents = new Map(
            (previous.filteredFieldValue || []).map(parent => [
                clean(parent.value || parent.label),
                parent
            ])
        );

        const selectedValues = new Set(previous.selectedValue || []);

        return {
            ...group,
            selectedValue: [...selectedValues],

            filteredFieldValue: (
                group.filteredFieldValue || []
            ).map(parent => {

                const parentKey = clean(
                    parent.value || parent.label
                );

                const oldParent = previousParents.get(parentKey);

                const oldChildren = new Map(
                    (oldParent?.children || []).map(child => [
                        clean(child.value || child.label),
                        child
                    ])
                );

                return {
                    ...parent,
                    checked: oldParent
                        ? Boolean(oldParent.checked) ||
                          selectedValues.has(parent.value)
                        : selectedValues.has(parent.value),

                    children: (parent.children || []).map(child => {
                        const oldChild = oldChildren.get(
                            clean(child.value || child.label)
                        );

                        return {
                            ...child,
                            checked: Boolean(oldChild?.checked)
                        };
                    })
                };
            })
        };
    });
}

this.restorePreviousCheckboxSelections(previousFilterState);


