    /*
     * ============================================================
     * STABLE PAGINATION IMPLEMENTATION
     * ============================================================
     *
     * Why this exists:
     * - The original SOQL paginates raw import relationship records.
     * - The UI then de-duplicates by App UUID + Stack Layer UUID.
     * - That can make a 50-record page display fewer than 50 rows and
     *   can make the total count show only the current page.
     *
     * This implementation keeps the existing public method signature,
     * filters, ownership logic, row shape, and UI conflict behavior,
     * but performs pagination AFTER the logical rows are de-duplicated.
     *
     * No original implementation was removed. The old code remains as
     * a fallback behind useStablePagination.
     */
    private static PaamPageResult getStackLayJunctionStable(
        Integer pageSize,
        String lastAppName,
        Id lastRecordId,
        String ownedBy,
        String searchKey,
        String syncView,
        String stackStatus
    ) {
        Integer safeLimit = pageSize == null
            ? 50
            : Math.min(Math.max(pageSize, 1), 200);

        ownershipCondition = buildOwnershipCondition(ownedBy);

        Id currentUserId;
        if (String.isNotBlank(ownershipCondition)) {
            currentUserId = getCurrentEmployeeId();
        }

        String normalizedSearchKey =
            String.isBlank(searchKey)
                ? null
                : searchKey.trim();

        String searchPattern;
        if (
            normalizedSearchKey != null &&
            normalizedSearchKey.length() >= 3
        ) {
            searchPattern = '%' + normalizedSearchKey + '%';
        }

        List<String> baseConditions = new List<String>();
        baseConditions.add('App__c != null');

        if (String.isNotBlank(searchPattern)) {
            baseConditions.add(
                '(' +
                    'App__r.App_Name__c LIKE :searchPattern ' +
                    'OR App__r.Operational_Status__c LIKE :searchPattern ' +
                    'OR Stack_Layer_Config__r.Name LIKE :searchPattern ' +
                    'OR StackLayerStatus__c LIKE :searchPattern' +
                ')'
            );
        }

        if (String.isNotBlank(ownershipCondition)) {
            baseConditions.add(ownershipCondition);
        }

        if (String.isNotBlank(stackStatus)) {
            baseConditions.add('StackLayerStatus__c = :stackStatus');
        }

        /*
         * Query the complete filtered server dataset once.
         * We need the full filtered set so totals and page boundaries
         * are based on unique logical UI rows, not raw relationship rows.
         */
        String stableQuery =
            'SELECT ' +
                'Id, ' +
                'CreatedDate, ' +
                'App_UUID__c, ' +
                'Stack_Layer_UUID__c, ' +
                'StackLayerStatus__c, ' +
                'Stack_Layer_Config__c, ' +
                'Stack_Layer_Config__r.Name, ' +
                'App__c, ' +
                'Mapping_Type__c, ' +
                'App__r.Application_Type__c, ' +
                'App__r.IT_Architect__c, ' +
                'App__r.Application_Owner__c, ' +
                'App__r.IT_Architect__r.Name, ' +
                'App__r.App_TIME_Recommendation__c, ' +
                'App__r.Operational_Status__c, ' +
                'App__r.App_Name__c, ' +
                'App__r.Category__r.Domain__r.Port__r.Name, ' +
                'App__r.Category__r.Domain__r.Name, ' +
                'App__r.Category__r.Name, ' +
                'App__r.UUID__c, ' +
                'App__r.Subtype__c, ' +
                'App__r.Business_Owner__r.Name, ' +
                'App__r.Application_Owner__r.Name, ' +
                'App__r.Description__c ' +
            'FROM TPM_Stack_Layer_Import_Relationship__c';

        if (!baseConditions.isEmpty()) {
            stableQuery +=
                ' WHERE ' +
                String.join(baseConditions, ' AND ');
        }

        stableQuery +=
            ' ORDER BY App__r.App_Name__c ASC, Id ASC';

        System.debug('STABLE PAGINATION QUERY :: ' + stableQuery);

        List<TPM_Stack_Layer_Import_Relationship__c> allFilteredRecords =
            Database.query(stableQuery);

        /*
         * Classify every logical key first.
         * If any raw relationship for a logical key is a conflict,
         * that logical key is treated as a conflict. This keeps the
         * conflict count stable after de-duplication.
         */
        Set<String> allUniqueKeys = new Set<String>();
        Set<String> conflictUniqueKeys = new Set<String>();

        for (
            TPM_Stack_Layer_Import_Relationship__c recordItem :
            allFilteredRecords
        ) {
            String compositeKey = stableCompositeKey(recordItem);
            allUniqueKeys.add(compositeKey);

            if (isStableConflictRecord(recordItem)) {
                conflictUniqueKeys.add(compositeKey);
            }
        }

        Integer fullUniqueTotal = allUniqueKeys.size();
        Integer fullUniqueConflicts = conflictUniqueKeys.size();
        Integer fullUniqueSync =
            Math.max(0, fullUniqueTotal - fullUniqueConflicts);

        /*
         * Build ONE representative UI row for each unique logical key.
         *
         * Conflict keys use a conflict raw record as their representative.
         * Sync keys use a non-conflict raw record as their representative.
         * This keeps the server classification aligned with the existing
         * JavaScript isConflict calculation.
         */
        Map<String, PaamRowWrapper> uniqueRowsByKey =
            new Map<String, PaamRowWrapper>();
        List<String> orderedKeys = new List<String>();

        for (
            TPM_Stack_Layer_Import_Relationship__c recordItem :
            allFilteredRecords
        ) {
            String compositeKey = stableCompositeKey(recordItem);
            Boolean keyIsConflict = conflictUniqueKeys.contains(compositeKey);

            if ('conflicts'.equalsIgnoreCase(syncView) && !keyIsConflict) {
                continue;
            }

            if ('sync'.equalsIgnoreCase(syncView) && keyIsConflict) {
                continue;
            }

            Boolean rawRecordIsConflict = isStableConflictRecord(recordItem);

            // For a conflict logical key, use a conflict raw record.
            if (keyIsConflict && !rawRecordIsConflict) {
                continue;
            }

            // For a sync logical key, use a non-conflict raw record.
            if (!keyIsConflict && rawRecordIsConflict) {
                continue;
            }

            if (!uniqueRowsByKey.containsKey(compositeKey)) {
                PaamRowWrapper row =
                    buildStablePaamRow(recordItem, currentUserId, compositeKey);

                uniqueRowsByKey.put(compositeKey, row);
                orderedKeys.add(compositeKey);
            }
        }

        List<PaamRowWrapper> fullLogicalRows =
            new List<PaamRowWrapper>();

        for (String key : orderedKeys) {
            fullLogicalRows.add(uniqueRowsByKey.get(key));
        }

        Integer filteredUniqueTotal = fullLogicalRows.size();

        /*
         * Resolve the page start.
         *
         * Normal Next navigation passes the last row from the previous page.
         * Last navigation uses a private sentinel token so the public Apex
         * method signature does not need to change.
         */
        Integer startIndex = 0;

        if (LAST_PAGE_TOKEN.equals(lastAppName)) {
            if (filteredUniqueTotal > 0) {
                startIndex =
                    ((filteredUniqueTotal - 1) / safeLimit) * safeLimit;
            }
        }
        else if (lastRecordId != null) {
            startIndex = findStableStartIndex(
                fullLogicalRows,
                lastAppName,
                lastRecordId
            );
        }

        if (startIndex < 0 || startIndex > filteredUniqueTotal) {
            startIndex = 0;
        }

        Integer endIndex = Math.min(
            startIndex + safeLimit,
            filteredUniqueTotal
        );

        List<PaamRowWrapper> pageRows =
            new List<PaamRowWrapper>();

        for (Integer index = startIndex; index < endIndex; index++) {
            pageRows.add(fullLogicalRows[index]);
        }

        PaamPageResult result = new PaamPageResult();
        result.rows = pageRows;
        result.hasMore = endIndex < filteredUniqueTotal;
        result.totalRecords = fullUniqueTotal;
        result.filteredTotalRecords = filteredUniqueTotal;

        if ('conflicts'.equalsIgnoreCase(syncView)) {
            result.totalConflicts = fullUniqueConflicts;
            result.totalSync = 0;
        }
        else if ('sync'.equalsIgnoreCase(syncView)) {
            result.totalConflicts = 0;
            result.totalSync = fullUniqueSync;
        }
        else {
            result.totalConflicts = fullUniqueConflicts;
            result.totalSync = fullUniqueSync;
        }

        /*
         * Cursor for Next.
         */
        if (!pageRows.isEmpty()) {
            PaamRowWrapper finalRow = pageRows[pageRows.size() - 1];
            result.lastAppName = finalRow.appName;
            result.lastRecordId = finalRow.Id;
        }

        /*
         * Cursor for Previous.
         * To load the previous page, the client needs the row immediately
         * BEFORE that previous page starts.
         */
        if (startIndex > 0) {
            Integer previousPageStart = Math.max(0, startIndex - safeLimit);

            if (previousPageStart > 0) {
                PaamRowWrapper previousCursorRow =
                    fullLogicalRows[previousPageStart - 1];

                result.previousLastAppName = previousCursorRow.appName;
                result.previousLastRecordId = previousCursorRow.Id;
            }
        }

        System.debug(
            'STABLE PAGINATION RESULT => ' +
            'fullUniqueTotal=' + fullUniqueTotal +
            ', filteredUniqueTotal=' + filteredUniqueTotal +
            ', startIndex=' + startIndex +
            ', endIndex=' + endIndex +
            ', pageRows=' + pageRows.size() +
            ', hasMore=' + result.hasMore
        );

        return result;
    }


    private static String stableCompositeKey(
        TPM_Stack_Layer_Import_Relationship__c recordItem
    ) {
        // Exactly matches the composite-key rule already used by the UI code.
        return
            String.valueOf(recordItem.App_UUID__c) +
            '|' +
            String.valueOf(recordItem.Stack_Layer_UUID__c);
    }


    private static Boolean isStableConflictRecord(
        TPM_Stack_Layer_Import_Relationship__c recordItem
    ) {
        String mappingType =
            String.isBlank(recordItem.Mapping_Type__c)
                ? ''
                : recordItem.Mapping_Type__c.trim();

        return
            (
                'CI'.equalsIgnoreCase(mappingType) ||
                'PAAM'.equalsIgnoreCase(mappingType)
            ) &&
            recordItem.Stack_Layer_Config__c != null;
    }


    private static Integer findStableStartIndex(
        List<PaamRowWrapper> fullLogicalRows,
        String lastAppName,
        Id lastRecordId
    ) {
        if (fullLogicalRows == null || fullLogicalRows.isEmpty()) {
            return 0;
        }

        /*
         * Normal case: the exact previous-page cursor still exists.
         */
        for (Integer index = 0; index < fullLogicalRows.size(); index++) {
            if (fullLogicalRows[index].Id == lastRecordId) {
                return index + 1;
            }
        }

        /*
         * Fallback: Accept Conflict can change Mapping_Type__c and remove
         * the cursor row from the current Conflict view. In that case,
         * continue from the first row that sorts AFTER the old cursor.
         */
        String safeLastAppName =
            String.isBlank(lastAppName)
                ? ''
                : lastAppName;
        String safeLastRecordId = String.valueOf(lastRecordId);

        for (Integer index = 0; index < fullLogicalRows.size(); index++) {
            PaamRowWrapper row = fullLogicalRows[index];
            String rowAppName =
                String.isBlank(row.appName)
                    ? ''
                    : row.appName;

            Integer appNameComparison =
                rowAppName.toLowerCase().compareTo(safeLastAppName.toLowerCase());

            if (appNameComparison > 0) {
                return index;
            }

            if (
                appNameComparison == 0 &&
                String.valueOf(row.Id).compareTo(safeLastRecordId) > 0
            ) {
                return index;
            }
        }

        return fullLogicalRows.size();
    }


