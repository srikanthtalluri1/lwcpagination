@IsTest
private class TPM_PAAMStackDataTest {

    private static void setName(SObject recordItem, String nameValue) {
        Map<String, Schema.SObjectField> fields =
            recordItem.getSObjectType().getDescribe().fields.getMap();

        if (fields.containsKey('Name')) {
            Schema.DescribeFieldResult nameField =
                fields.get('Name').getDescribe();

            if (nameField.isCreateable() && !nameField.isAutoNumber()) {
                recordItem.put('Name', nameValue);
            }
        }
    }

    private static String getPicklistValue(
        Schema.DescribeFieldResult fieldDescribe
    ) {
        for (
            Schema.PicklistEntry entry :
            fieldDescribe.getPicklistValues()
        ) {
            if (entry.isActive()) {
                return entry.getValue();
            }
        }

        return null;
    }

    static List<User> usrList = new List<User>();

    @TestSetup
    public static void setupData() {

        usrList = testUserDataSetUp();

        System.runAs(usrList[0]) {

            UCH_Employee__c employee =
                new UCH_Employee__c(
                    Employee_ID__c = usrList[0].EmployeeNumber,
                    Department_Description__c = 'Test',
                    Department_ID__c = '1232s'
                );

            setName(
                employee,
                'Coverage Employee'
            );

            insert employee;

            Schema.SObjectType appObjectType =
                TPM_Stack_Layer_Import_Relationship__c.App__c
                    .getDescribe()
                    .getReferenceTo()[0];

            SObject appRecord =
                appObjectType.newSObject();

            setName(
                appRecord,
                'Coverage Application'
            );

            appRecord.put(
                'App_Name__c',
                'Coverage Application'
            );

            appRecord.put(
                'InActive__c',
                false
            );

            appRecord.put(
                'IT_Architect__c',
                employee.Id
            );

            appRecord.put(
                'Application_Owner__c',
                employee.Id
            );

            appRecord.put(
                'Business_Owner__c',
                employee.Id
            );

           

            Schema.DescribeFieldResult operationalStatusField =
                appObjectType
                    .getDescribe()
                    .fields
                    .getMap()
                    .get('Operational_Status__c')
                    .getDescribe();

            String operationalStatus =
                getPicklistValue(
                    operationalStatusField
                );

            if (operationalStatus != null) {
                appRecord.put(
                    'Operational_Status__c',
                    operationalStatus
                );
            }

            insert appRecord;

          
                TPM_Stack_Layer_Config__c configRecord = new TPM_Stack_Layer_Config__c();
            setName(
                configRecord,
                'Coverage Layer'
            );

            insert configRecord;

            List<TPM_Stack_Layer_Import_Relationship__c> junctions =
                new List<TPM_Stack_Layer_Import_Relationship__c>();

            for (Integer index = 0; index < 2; index++) {

                TPM_Stack_Layer_Import_Relationship__c junction =
                    new TPM_Stack_Layer_Import_Relationship__c(
                        App__c = appRecord.Id,
                        Stack_Layer_Config__c =
                            (Id) configRecord.get('Id')
                    );

                if (index == 0) {
                    junction.Mapping_Type__c = 'CI';
                } else {
                    junction.Mapping_Type__c = 'PAAM and CI';
                }

                setName(
                    junction,
                    'Coverage Junction ' + index
                );

                junctions.add(junction);
            }

            insert junctions;
        }
    }

    public static List<User> testUserDataSetUp() {

        String licenseName =
            'Salesforce Platform';

        return [
            SELECT
                Id,
                Name,
                EmployeeNumber,
                No_User_Sync__c,
                IsActive,
                Perform_Post_Activation_Steps__c,
                Contractor__c,
                UserType,
                ManagerId
            FROM User
            WHERE
                User_Type__c = null
                AND FederationIdentifier != null
                AND Is_separated__c = false
                AND Profile.UserLicense.Name = :licenseName
                AND IsActive = true
            ORDER BY LastName DESC
            LIMIT 3
        ];
    }

    @IsTest
    static void testGetStackLayJunction() {

        Test.startTest();

        TPM_PAAMStackData.getUniqueAppCount(
            'All'
        );

        TPM_PAAMStackData.PaamPageResult firstPage =
            TPM_PAAMStackData.getStackLayJunction(
                1,
                null,
                null,
                'All',
                'Coverage',
                'All',
                null
            );

        System.assertNotEquals(
            null,
            firstPage
        );

        TPM_PAAMStackData.getStackLayJunction(
            1,
            'Coverage Application',
            firstPage.lastRecordId,
            'All',
            'Coverage',
            'All',
                null
        );

        TPM_PAAMStackData.getStackLayJunction(
            null,
            null,
            null,
            'MyPrimary',
            'Co',
            'conflicts',
                null
        );

        TPM_PAAMStackData.getStackLayJunction(
            0,
            null,
            null,
            'MyAll',
            'Coverage',
            'sync',
                null
        );

        TPM_PAAMStackData.getStackLayJunction(
            500,
            'Coverage Application',
            null,
            'Unknown',
            null,
            'conflicts',
                null
        );

        TPM_PAAMStackData.getStackLayJunction(
            10,
            null,
            null,
            null,
            '',
            'sync',
                null
        );
        TPM_PAAMStackData.acceptConflict('{"stacklayerUuid": "INVALID_UUID"}');
        Test.stopTest();
    }

    @IsTest
    static void testPaginationWithSingleAssertion() {

        TPM_Stack_Layer_Import_Relationship__c existing = [
            SELECT App__c, Stack_Layer_Config__c
            FROM TPM_Stack_Layer_Import_Relationship__c
            WHERE App__c != null
            LIMIT 1
        ];

        List<TPM_Stack_Layer_Import_Relationship__c> additionalRecords =
            new List<TPM_Stack_Layer_Import_Relationship__c>();

        for (Integer index = 0; index < 53; index++) {

            TPM_Stack_Layer_Import_Relationship__c junction =
                new TPM_Stack_Layer_Import_Relationship__c(
                    App__c = existing.App__c,
                    Stack_Layer_Config__c = existing.Stack_Layer_Config__c,
                    App_UUID__c = 'COVPAG',
                    Stack_Layer_UUID__c = 'PAG' + String.valueOf(index),
                    Mapping_Type__c = index < 30 ? 'CI' : 'PAAM and CI'
                );

            if (index < 5) {
                junction.StackLayerStatus__c = 'Denied';
            } else if (index < 10) {
                junction.StackLayerStatus__c = 'Restricted';
            }

            setName(junction, 'Pagination Junction ' + index);
            additionalRecords.add(junction);
        }

        TPM_Stack_Layer_Import_Relationship__c duplicateRecord =
            new TPM_Stack_Layer_Import_Relationship__c(
                App__c = existing.App__c,
                Stack_Layer_Config__c = existing.Stack_Layer_Config__c,
                App_UUID__c = 'COVPAG',
                Stack_Layer_UUID__c = 'PAG0',
                Mapping_Type__c = 'PAAM and CI',
                StackLayerStatus__c = 'Denied'
            );

        setName(duplicateRecord, 'Pagination Duplicate');
        additionalRecords.add(duplicateRecord);
        insert additionalRecords;

        Test.startTest();

        TPM_PAAMStackData.PaamPageResult firstPage =
            TPM_PAAMStackData.getStackLayJunction(
                50, null, null, 'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult secondPage =
            TPM_PAAMStackData.getStackLayJunction(
                50,
                firstPage.lastAppName,
                firstPage.lastRecordId,
                'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult lastPage =
            TPM_PAAMStackData.getStackLayJunction(
                50, '__PAAM_LAST_PAGE__', null,
                'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult previousPage =
            TPM_PAAMStackData.getStackLayJunction(
                50,
                secondPage.previousLastAppName,
                secondPage.previousLastRecordId,
                'All', 'Coverage', 'All', null
            );

        TPM_PAAMStackData.PaamPageResult conflicts =
            TPM_PAAMStackData.getStackLayJunction(
                50, null, null, 'All', 'Coverage', 'conflicts', null
            );

        TPM_PAAMStackData.PaamPageResult inSync =
            TPM_PAAMStackData.getStackLayJunction(
                50, null, null, 'All', 'Coverage', 'sync', null
            );

        TPM_PAAMStackData.PaamPageResult denied =
            TPM_PAAMStackData.getStackLayJunction(
                50, null, null, 'All', 'Coverage', 'All', 'Denied'
            );

        TPM_PAAMStackData.PaamPageResult restricted =
            TPM_PAAMStackData.getStackLayJunction(
                50, null, null, 'All', 'Coverage', 'All', 'Restricted'
            );

        Test.stopTest();

        // One new assertion covers page boundaries, deduplication and filters.
        System.assertEquals(
            true,
            firstPage.totalRecords == 54 &&
            firstPage.rows.size() == 50 &&
            firstPage.hasMore == true &&
            secondPage.totalRecords == 54 &&
            secondPage.rows.size() == 4 &&
            secondPage.hasMore == false &&
            lastPage.rows.size() == 4 &&
            previousPage.rows.size() == 50 &&
            conflicts.totalConflicts == 31 &&
            inSync.totalSync == 23 &&
            denied.rows.size() == 5 &&
            restricted.rows.size() == 5,
            'Pagination, unique counts and status filters should agree.'
        );
    }
}
