    // ---------- helpers for the permission-set driven scenarios ----------

    // The helper class reads the running user's permission sets in a static initialiser, so every test below
    // calls the helper for the first time inside System.runAs(user).
    private static User createPsUser(String tag, Set<String> permissionSetNames) {
        // Reuse the @TestSetup test user, avoiding repeated User DML and
        // the missing ProfileId failure from createPsUser().
        User u = [
            SELECT Id
            FROM User
            WHERE LastName = 'TestUser' AND EmployeeNumber = 'P4444'
            LIMIT 1
        ];

        Set<Id> alreadyAssigned = new Set<Id>();
        for (PermissionSetAssignment existing : [
            SELECT PermissionSetId
            FROM PermissionSetAssignment
            WHERE AssigneeId = :u.Id
        ]) {
            alreadyAssigned.add(existing.PermissionSetId);
        }

        List<PermissionSetAssignment> assignments = new List<PermissionSetAssignment>();
        for (PermissionSet ps : [
            SELECT Id
            FROM PermissionSet
            WHERE Name IN :permissionSetNames
        ]) {
            if (!alreadyAssigned.contains(ps.Id)) {
                assignments.add(new PermissionSetAssignment(
                    AssigneeId = u.Id,
                    PermissionSetId = ps.Id
                ));
            }
        }
        if (!assignments.isEmpty()) {
            System.runAs(u) {
                insert assignments;
            }
        }
        return u;
    }

    // Base decision with every role pointing at the logged-in employee (same value the helper class resolves),
    // plus any extra field overrides.
    private static TechnologyDecision__c makeDecision(String reason, String stage, String status, Map<String, Object> extra) {
        Id empId = getEmpId();
        TechnologyDecision__c dec = createBaseDecision(reason, stage, status);
        dec.Requestor__c                      = empId;
        dec.Requesting_Technical_Architect__c = empId;
        dec.Requesting_Business_Owner__c      = empId;
        dec.Requesting_Application_Owner__c   = empId;
        dec.Requesting_Tech_Fellow__c         = empId;
        for (String fieldName : extra.keySet()) {
            dec.put(fieldName, extra.get(fieldName));
        }
        update dec;
        return dec;
    }

