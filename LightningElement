    /* ------------------------------------------------------------------------
       getPicklistLabel
       ------------------------------------------------------------------------ */

    @IsTest
    static void testPicklistLabel() {
        User testUser = [SELECT Id FROM User WHERE LastName = 'TestUser' AND EmployeeNumber = 'P4444' LIMIT 1];
        System.runAs(testUser) {
        String objectName = String.valueOf(TechnologyDecision__c.SObjectType);
        String fieldName  = String.valueOf(TechnologyDecision__c.Status__c);

        Test.startTest();
        List<Schema.PicklistEntry> entries =
            TechnologyDecision__c.Status__c.getDescribe().getPicklistValues();
        if (!entries.isEmpty()) {
            System.assertEquals(entries[0].getLabel(),
                TechnologyDecision_HistoryHandler.getPicklistLabel(
                    objectName, fieldName, entries[0].getValue()));
        }
        System.assertEquals(null, TechnologyDecision_HistoryHandler.getPicklistLabel(
            objectName, fieldName, 'no-such-value'));
        System.assertEquals(null, TechnologyDecision_HistoryHandler.getPicklistLabel(
            null, fieldName, 'x'));
        System.assertEquals(null, TechnologyDecision_HistoryHandler.getPicklistLabel(
            'NoSuchObject__c', fieldName, 'x'));
        System.assertEquals(null, TechnologyDecision_HistoryHandler.getPicklistLabel(
            objectName, 'No_Field__c', 'x'));
        Test.stopTest();
        }
    }

    /* ------------------------------------------------------------------------
       WrapperComparator
       ------------------------------------------------------------------------ */

    @IsTest
    static void testWrapperComparator() {
        User testUser = [SELECT Id FROM User WHERE LastName = 'TestUser' AND EmployeeNumber = 'P4444' LIMIT 1];
        System.runAs(testUser) {
        Test.startTest();
        String userId = String.valueOf(UserInfo.getUserId());
        Datetime now = Datetime.now();

        TechnologyDecision_HistoryHandler.WrapperClass w1 =
            new TechnologyDecision_HistoryHandler.WrapperClass('Field', 'O1', 'N1', now,
                'User1', userId, 'Src');
        TechnologyDecision_HistoryHandler.WrapperClass w2 =
            new TechnologyDecision_HistoryHandler.WrapperClass('Field', 'O2', 'N2', now.addMinutes(5),
                'User2', userId, 'Src');
        TechnologyDecision_HistoryHandler.WrapperClass w3 =
            new TechnologyDecision_HistoryHandler.WrapperClass('Field', 'O3', 'N3', now,
                'User3', userId, 'Src');

        TechnologyDecision_HistoryHandler.WrapperComparator cmp =
            new TechnologyDecision_HistoryHandler.WrapperComparator();
        Test.stopTest();

        System.assertEquals(1, cmp.compare(w1, w2), 'b > a should return 1');
        System.assertEquals(-1, cmp.compare(w2, w1), 'b < a should return -1');
        System.assertEquals(0, cmp.compare(w1, w3), 'equal dates should return 0');
        }
    }
