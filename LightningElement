    get pageRows() {
        const styledRows =
            this.filteredRowsRaw.map((row) => {
                const operationalStatus =
                    row.manualStatus || 'Unknown';

                const discoveredStatus =
                    row.discoveredStatus ||
                    'Unknown';

                const manualSlug =
                    statusSlug(
                        operationalStatus
                       // manualStatus
                    );   
                     console.log('393 is: ',manualSlug);
                const discoveredSlug =
                    statusSlug(
                        discoveredStatus
                    );

                const wasOverridden =
                    this.overrides[row.id] !==
                    undefined;

                return {
                    ...row,

                    groupKey:
                        row.appId ||
                        row.appName ||
                        row.id,
                    canAccept:
                         Boolean(row.paamDiscovered?.trim()),

                    manualPillClass:
                        `paam-pill paam-pill--${manualSlug} ` +
                        `${
                            row.isConflict
                                ? 'paam-pill--diff'
                                : ''
                        }`,

                    discoveredPillClass:
                        `paam-pill paam-pill--${discoveredSlug} ` +
                        `${
                            row.isConflict
                                ? 'paam-pill--diff'
                                : ''
                        }`,

                    manualTitle:
                        `${row.paamManual} — ` +
                        `${operationalStatus}`,

                    discoveredTitle:
                        `${row.paamDiscovered} — ` +
                        `${discoveredStatus}`,

                    diffTitle:
                        `Will change to ` +
                        `${row.paamDiscovered}`,

                    syncStatusClass:
                        row.isConflict
                            ? 'paam-status paam-status--conflict'
                            : 'paam-status paam-status--sync',

                    syncStatusLabel:
                        row.isConflict
                            ? 'Conflict'
                            : 'In Sync',

                    acceptTitle:
                        `Replace PAAM Manual ` +
                        `(${row.paamManual}) with ` +
                        `PAAM Discovered ` +
                        `(${row.paamDiscovered})`,

                    wasOverridden
                };
            });

        const groupSizes = new Map();

        styledRows.forEach((row) => {
            const currentGroupSize =
                groupSizes.get(
                    row.groupKey
                ) || 0;

            groupSizes.set(
                row.groupKey,
                currentGroupSize + 1
            );
        });

        const renderedGroups = new Set();

        return styledRows.map((row) => {
            const showApplication =
                !renderedGroups.has(
                    row.groupKey
                );

            if (showApplication) {
                renderedGroups.add(
                    row.groupKey
                );
            }

            return {
                ...row,

                showApplication,

                applicationRowSpan:
                    showApplication
                        ? groupSizes.get(
                            row.groupKey
                        )
                        : null,

               rowClass:
    `${
        row.isConflict
            ? 'paam-row-conflict '
            : ''
    }` +
    `${
        showApplication
            ? 'paam-row-group-start '
            : 'paam-row-group-member '
    }` +
    `${
        this.hoveredGroupKey === row.groupKey
            ? 'paam-row-group-hover'
            : ''
    }`
            };
        });
    }

