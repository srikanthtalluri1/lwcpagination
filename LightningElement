public with sharing class TpmArchitectureHubController {
    @AuraEnabled(cacheable=true)
    public static Map<String, Object> getAssessmentData(String filtersJson) {
        return TpmArchitectureHubAssessmentService.getAssessmentData(filtersJson);
    }

    // Dynamic cycle options are intentionally fetched without client caching, so
    // a newly created assessment period appears on the next page load.
    @AuraEnabled
    public static List<Map<String, Object>> getAvailableCycles() {
        return TpmArchitectureHubAssessmentService.getAvailableCycles();
    }

    @AuraEnabled(cacheable=true)
    public static Map<String, Object> getPortfolioDetailData(String portfolioName) {
        return TpmArchitectureHubAssessmentService.getPortfolioDetailData(portfolioName);
    }
}
